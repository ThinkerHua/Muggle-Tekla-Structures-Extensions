<tsd:PluginWindowBase x:Class="Muggle.TsExtensions.DC2001.View"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:tsd="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
                      xmlns:tsuc="clr-namespace:Tekla.Structures.Dialog.UIControls;assembly=Tekla.Structures.Dialog"
                      xmlns:assets="clr-namespace:Muggle.TsExtensions.Common.WPF.Assets;assembly=Common.WPF"
                      xmlns:uc="clr-namespace:Muggle.TsExtensions.Common.WPF.Controls;assembly=Common.WPF"
                      xmlns:tr="clr-namespace:Muggle.TsExtensions.Common.WPF.Localization;assembly=Common.WPF"
                      xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
                      xmlns:dc2001="clr-namespace:Muggle.TsExtensions.DC2001"
                      Title="{tsd:Loc albl_DC2001_title}"
                      SizeToContent="WidthAndHeight"
                      ResizeMode="NoResize"
                      UseDefaultStyle="False"
                      Background="#F3F3F7"
                      mc:Ignorable="d">

    <tsd:PluginWindowBase.DataContext>
        <dc2001:ViewModel />
    </tsd:PluginWindowBase.DataContext>

    <tsd:PluginWindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Common.WPF;component/DataTemplates/SymbolDataTemplate.xaml" />
                <ResourceDictionary Source="/Common.WPF;component/Controls/PresetControlGroups.xaml" />
                <ResourceDictionary Source="/DC2001;component/Assets/BackgroundImage.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Element" TargetType="FrameworkElement">
                <Setter Property="Margin" Value="2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ContainingTextBoxElement" TargetType="FrameworkElement" BasedOn="{StaticResource Element}">
                <Setter Property="Height" Value="20" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="Grid" />
            <Style BasedOn="{StaticResource Element}" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="CheckBox" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="TextBox">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="ComboBox" />
            <Style BasedOn="{StaticResource Element}" TargetType="uc:BoltAssembly">
                <Setter Property="Width" Value="100" />
                <Setter Property="Height" Value="130" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="uc:BoltSpecialHole">
                <Setter Property="Width" Value="100" />
                <Setter Property="Height" Value="100" />
            </Style>
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="uc:ClassSelector" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuc:WpfFilterCheckBox" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuc:WpfProfileCatalog" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuc:WpfMaterialCatalog" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuc:WpfBoltCatalogSize" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuc:WpfBoltCatalogStandard" />
        </ResourceDictionary>
    </tsd:PluginWindowBase.Resources>

    <DockPanel LastChildFill="True">
        <tsuc:WpfSaveLoad DockPanel.Dock="Top" />
        <tsuc:WpfOkApplyModifyGetOnOffCancel DockPanel.Dock="Bottom"
                                             ApplyClicked="WPFOkApplyModifyGetOnOffCancel_ApplyClicked"
                                             CancelClicked="WPFOkApplyModifyGetOnOffCancel_CancelClicked"
                                             GetClicked="WPFOkApplyModifyGetOnOffCancel_GetClicked"
                                             ModifyClicked="WPFOkApplyModifyGetOnOffCancel_ModifyClicked"
                                             OkClicked="WPFOkApplyModifyGetOnOffCancel_OkClicked"
                                             OnOffClicked="WPFOkApplyModifyGetOnOffCancel_OnOffClicked" />
        <TextBlock Margin="4" HorizontalAlignment="Right" DockPanel.Dock="Bottom" TextWrapping="Wrap">
            <Run>Huang YongXing -</Run>
            <Hyperlink NavigateUri="mailto:thinkerhua@hotmail.com">thinkerhua@hotmail.com</Hyperlink>
        </TextBlock>

        <TabControl Margin="2,0">
            <TabItem Header="{tsd:Loc albl_parameters}">
                <DockPanel>
                    <Canvas Width="210" Height="200" DockPanel.Dock="Left">
                        <Image>
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource ParametersBackground}" />
                            </Image.Source>
                        </Image>
                        <TextBlock Canvas.Left="30" Canvas.Top="10" Text="L1" />
                        <TextBlock Canvas.Left="160" Canvas.Top="10" Text="L2" />
                        <TextBlock Canvas.Left="44" Canvas.Top="120" Text="D1" />
                        <TextBlock Canvas.Left="146" Canvas.Top="120" Text="D2" />
                    </Canvas>

                    <Grid DockPanel.Dock="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{tsd:Loc albl_left_corbel_length}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="L1" />
                        <tsuc:WpfFilterCheckBox Grid.Row="0" Grid.Column="2" AttributeName="LeftCorbelLength" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding LeftCorbelLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{tsd:Loc albl_left_corbel_stiffener_position}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="D1" />
                        <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.Column="2" AttributeName="LeftCorbelStifDist" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding LeftCorbelStifDist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{tsd:Loc albl_right_corbel_creation}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="2" Grid.Column="2" AttributeName="RightCorbelCreation" />
                        <ComboBox Grid.Row="2" Grid.Column="3" SelectedIndex="{Binding RightCorbelCreation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="{tsd:Loc albl_none}" />
                            <ComboBoxItem Content="{tsd:Loc albl_same}" />
                            <ComboBoxItem Content="{tsd:Loc albl_different}" />
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{tsd:Loc albl_right_corbel_length}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="L2" />
                        <tsuc:WpfFilterCheckBox Grid.Row="3" Grid.Column="2" AttributeName="RightCorbelLength" IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />
                        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding RightCorbelLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{tsd:Loc albl_right_corbel_stiffener_position}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="D2" />
                        <tsuc:WpfFilterCheckBox Grid.Row="4" Grid.Column="2" AttributeName="RightCorbelStifDist" IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />
                        <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding RightCorbelStifDist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />

                        <Separator Grid.Row="5"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="4"
                                   Width="256"
                                   HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{tsd:Loc albl_column_stiffener_chamfer}" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{tr:Translate albl_Chamfer_Type}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="7" Grid.Column="2" AttributeName="PrimStifChamferType" />
                        <ComboBox Grid.Row="7"
                                  Grid.Column="3"
                                  ItemTemplate="{StaticResource SymbolDataTemplate}"
                                  SelectedIndex="{Binding PrimStifChamferType, Mode=TwoWay}"
                                  ItemsSource="{x:Static assets:ChamferSymbols.ChamferTypeSet}" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="{tr:Translate albl_Chamfer_X}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="8" Grid.Column="2" AttributeName="PrimStifChamferX" IsEnabled="{c:Binding 'PrimStifChamferType.Value >= 1 and PrimStifChamferType.Value less=3 or PrimStifChamferType.Value >= 5 and PrimStifChamferType.Value less= 7'}" />
                        <TextBox Grid.Row="8" Grid.Column="3" Text="{Binding PrimStifChamferX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{c:Binding 'PrimStifChamferType.Value >= 1 and PrimStifChamferType.Value less=3 or PrimStifChamferType.Value >= 5 and PrimStifChamferType.Value less= 7'}" />

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="{tr:Translate albl_Chamfer_Y}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="9" Grid.Column="2" AttributeName="PrimStifChamferY" IsEnabled="{c:Binding 'PrimStifChamferType.Value == 1 or PrimStifChamferType.Value >= 5 and PrimStifChamferType.Value less= 7'}" />
                        <TextBox Grid.Row="9" Grid.Column="3" Text="{Binding PrimStifChamferY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{c:Binding 'PrimStifChamferType.Value == 1 or PrimStifChamferType.Value >= 5 and PrimStifChamferType.Value less= 7'}" />

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="{tr:Translate albl_Chamfer_Dz1}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="10" Grid.Column="2" AttributeName="PrimStifChamferDz1" />
                        <TextBox Grid.Row="10" Grid.Column="3" Text="{Binding PrimStifChamferDz1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="{tr:Translate albl_Chamfer_Dz2}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="11" Grid.Column="2" AttributeName="PrimStifChamferDz2" />
                        <TextBox Grid.Row="11" Grid.Column="3" Text="{Binding PrimStifChamferDz2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="{tsd:Loc albl_parts}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Id}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Name}" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="4"
                               Grid.ColumnSpan="5"
                               HorizontalAlignment="Center"
                               Text="{tr:Translate albl_Part_Header_Profile}" />
                    <TextBlock Grid.Row="5" Grid.Column="4" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Thickness}" />
                    <TextBlock Grid.Row="5" Grid.Column="6" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Breadth}" />
                    <TextBlock Grid.Row="5" Grid.Column="8" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Height}" />
                    <TextBlock Grid.Row="0" Grid.Column="11" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Material}" />
                    <TextBlock Grid.Row="0" Grid.Column="14" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Finish}" />
                    <TextBlock Grid.Row="0" Grid.Column="16" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Class}" />
                    <TextBlock Grid.Row="0" Grid.Column="18" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_NumberingSeries_Prefix}" />
                    <TextBlock Grid.Row="0" Grid.Column="20" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_NumberingSeries_StartNumber}" />

                    <TextBlock Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Text="{tsd:Loc albl_left_corbel}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" AttributeName="PTLeftCorbelNAME" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PartLeftCorbelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="3" AttributeName="PTLeftCorbelPRF" />
                    <TextBox Grid.Row="1"
                             Grid.RowSpan="2"
                             Grid.Column="4"
                             Grid.ColumnSpan="5"
                             Text="{Binding PartLeftCorbelProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuc:WpfProfileCatalog Grid.Row="1"
                                            Grid.RowSpan="2"
                                            Grid.Column="9"
                                            SelectClicked="LeftCorbelProfileSelectClicked"
                                            SelectionDone="LeftCorbelProfileSelectionDone" />

                    <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="10" AttributeName="PTLeftCorbelMATL" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PartLeftCorbelMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuc:WpfMaterialCatalog Grid.Row="1"
                                             Grid.RowSpan="2"
                                             Grid.Column="12"
                                             SelectClicked="LeftCorbelMaterialSelectClicked"
                                             SelectionDone="LeftCorbelMaterialSelectionDone" />

                    <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="13" AttributeName="PTLeftCorbelFNSH" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PartLeftCorbelFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="15" AttributeName="PTLeftCorbelCLS" />
                    <uc:ClassSelector Grid.Row="1" Grid.RowSpan="2" Grid.Column="16" Value="{Binding PartLeftCorbelClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.Column="17" AttributeName="PTLeftCorbelPTP" />
                    <TextBox Grid.Row="1" Grid.Column="18" Text="{Binding PartLeftCorbelPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.Column="19" AttributeName="PTLeftCorbelPTN" />
                    <TextBox Grid.Row="1" Grid.Column="20" Text="{Binding PartLeftCorbelPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="2" Grid.Column="17" AttributeName="PTLeftCorbelASMP" />
                    <TextBox Grid.Row="2" Grid.Column="18" Text="{Binding PartLeftCorbelAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="2" Grid.Column="19" AttributeName="PTLeftCorbelASMN" />
                    <TextBox Grid.Row="2" Grid.Column="20" Text="{Binding PartLeftCorbelAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.RowSpan="2" Grid.Column="0" Text="{tsd:Loc albl_right_corbel}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="3"
                                            Grid.RowSpan="2"
                                            Grid.Column="1"
                                            AttributeName="PTRightCorbelNAME"
                                            IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />
                    <TextBox Grid.Row="3"
                             Grid.RowSpan="2"
                             Grid.Column="2"
                             Text="{Binding PartRightCorbelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="3"
                                            Grid.RowSpan="2"
                                            Grid.Column="3"
                                            AttributeName="PTRightCorbelPRF"
                                            IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />
                    <TextBox Grid.Row="3"
                             Grid.RowSpan="2"
                             Grid.Column="4"
                             Grid.ColumnSpan="5"
                             Text="{Binding PartRightCorbelProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />
                    <tsuc:WpfProfileCatalog Grid.Row="3"
                                            Grid.RowSpan="2"
                                            Grid.Column="9"
                                            SelectClicked="RightCorbelProfileSelectClicked"
                                            SelectionDone="RightCorbelProfileSelectionDone"
                                            IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="3"
                                            Grid.RowSpan="2"
                                            Grid.Column="10"
                                            AttributeName="PTRightCorbelMATL"
                                            IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />
                    <TextBox Grid.Row="3"
                             Grid.RowSpan="2"
                             Grid.Column="11"
                             Text="{Binding PartRightCorbelMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />
                    <tsuc:WpfMaterialCatalog Grid.Row="3"
                                             Grid.RowSpan="2"
                                             Grid.Column="12"
                                             SelectClicked="RightCorbelMaterialSelectClicked"
                                             SelectionDone="RightCorbelMaterialSelectionDone"
                                             IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="3"
                                            Grid.RowSpan="2"
                                            Grid.Column="13"
                                            AttributeName="PTRightCorbelFNSH"
                                            IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />
                    <TextBox Grid.Row="3"
                             Grid.RowSpan="2"
                             Grid.Column="14"
                             Text="{Binding PartRightCorbelFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="3"
                                            Grid.RowSpan="2"
                                            Grid.Column="15"
                                            AttributeName="PTRightCorbelCLS"
                                            IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />
                    <uc:ClassSelector Grid.Row="3"
                                      Grid.RowSpan="2"
                                      Grid.Column="16"
                                      IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}"
                                      Value="{Binding PartRightCorbelClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="3" Grid.Column="17" AttributeName="PTRightCorbelPTP" IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />
                    <TextBox Grid.Row="3" Grid.Column="18" Text="{Binding PartRightCorbelPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="3" Grid.Column="19" AttributeName="PTRightCorbelPTN" IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />
                    <TextBox Grid.Row="3" Grid.Column="20" Text="{Binding PartRightCorbelPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="4" Grid.Column="17" AttributeName="PTRightCorbelASMP" IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />
                    <TextBox Grid.Row="4" Grid.Column="18" Text="{Binding PartRightCorbelAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="4" Grid.Column="19" AttributeName="PTRightCorbelASMN" IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />
                    <TextBox Grid.Row="4" Grid.Column="20" Text="{Binding PartRightCorbelAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{c:Binding 'RightCorbelCreation.Value == 2'}" />

                    <TextBlock Grid.Row="6" Grid.RowSpan="2" Grid.Column="0" Text="{tsd:Loc albl_column_stiffener}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLPrimStifNAME" />
                    <TextBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlatePrimStifName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLPrimStifT" />
                    <TextBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlatePrimStifThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLPrimStifMATL" />
                    <TextBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlatePrimStifMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuc:WpfMaterialCatalog Grid.Row="6"
                                             Grid.RowSpan="2"
                                             Grid.Column="12"
                                             SelectClicked="PrimStifMaterialSelectClicked"
                                             SelectionDone="PrimStifMaterialSelectionDone" />

                    <tsuc:WpfFilterCheckBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLPrimStifFNSH" />
                    <TextBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlatePrimStifFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLPrimStifCLS" />
                    <uc:ClassSelector Grid.Row="6" Grid.RowSpan="2" Grid.Column="16" Value="{Binding PlatePrimStifClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="6" Grid.Column="17" AttributeName="PLPrimStifPTP" />
                    <TextBox Grid.Row="6" Grid.Column="18" Text="{Binding PlatePrimStifPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="6" Grid.Column="19" AttributeName="PLPrimStifPTN" />
                    <TextBox Grid.Row="6" Grid.Column="20" Text="{Binding PlatePrimStifPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="7" Grid.Column="17" AttributeName="PLPrimStifASMP" />
                    <TextBox Grid.Row="7" Grid.Column="18" Text="{Binding PlatePrimStifAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="7" Grid.Column="19" AttributeName="PLPrimStifASMN" />
                    <TextBox Grid.Row="7" Grid.Column="20" Text="{Binding PlatePrimStifAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="8" Grid.RowSpan="2" Grid.Column="0" Text="{tsd:Loc albl_left_corbel_stiffener}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLLCorbelStifNAME" />
                    <TextBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateLCorbelStifName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLLCorbelStifT" />
                    <TextBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateLCorbelStifThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

