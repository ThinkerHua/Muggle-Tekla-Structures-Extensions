<tsdlg:PluginWindowBase x:Class="Muggle.TsExtensions.KJ2001.View"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:local="clr-namespace:Muggle.TsExtensions.KJ2001"
                        xmlns:tsdlg="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
                        xmlns:tsuic="clr-namespace:Tekla.Structures.Dialog.UIControls;assembly=Tekla.Structures.Dialog"
                        xmlns:uc="clr-namespace:Muggle.TsExtensions.Common.WPF.Controls;assembly=Common.WPF"
                        xmlns:vc="clr-namespace:Muggle.TsExtensions.Common.WPF.ValueConverters;assembly=Common.WPF"
                        xmlns:tr="clr-namespace:Muggle.TsExtensions.Common.WPF.Localization;assembly=Common.WPF"
                        xmlns:assets="clr-namespace:Muggle.TsExtensions.Common.WPF.Assets;assembly=Common.WPF"
                        Title="{tsdlg:Loc albl_KJ2001_title}"
                        ResizeMode="NoResize"
                        SizeToContent="WidthAndHeight"
                        UseDefaultStyle="False"
                        Background="#F3F3F7"
                        mc:Ignorable="d">

    <tsdlg:PluginWindowBase.DataContext>
        <local:ViewModel />
    </tsdlg:PluginWindowBase.DataContext>

    <tsdlg:PluginWindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Common.WPF;component/DataTemplates/SymbolDataTemplate.xaml" />
                <ResourceDictionary Source="/Common.WPF;component/Controls/PresetControlGroups.xaml" />
                <ResourceDictionary Source="Assets/Backgrounds.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <vc:BoltHoleTypeToSlottedHoleXDisplayNameConverter x:Key="BoltHoleTypeToSlottedHoleXDisplayName" />
            <vc:BoltHoleTypeToSlottedHoleXIsEnabledConverter x:Key="BoltHoleTypeToSlottedHoleXIsEnabled" />
            <vc:BoltHoleTypeToSlottedHoleYIsEnabledConverter x:Key="BoltHoleTypeToSlottedHoleYIsEnabled" />
            <vc:BoltHoleTypeToRotateSlotsIsEnabledConverter x:Key="BoltHoleTypeToRotateSlotsIsEnabled" />
            <vc:BoltPlainHoleTypeToBlindHoleDepthIsEnabledConverter x:Key="BoltPlainHoleTypeToBlindHoleDepthIsEnabled" />
            <vc:ChamferTypeToXIsEnabledConverter x:Key="ChamferTypeToXIsEnabled" />
            <vc:ChamferTypeToYIsEnabledConverter x:Key="ChamferTypeToYIsEnabled" />

            <Style x:Key="Element" TargetType="FrameworkElement">
                <Setter Property="Margin" Value="2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ContainingTextBoxElement" TargetType="FrameworkElement" BasedOn="{StaticResource Element}">
                <Setter Property="Height" Value="20" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="CheckBox" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="TextBox">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="ComboBox" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfFilterCheckBox">
                <Setter Property="Margin" Value="2,2,-2,2" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="uc:BoltAssembly" />
            <Style BasedOn="{StaticResource Element}" TargetType="uc:BoltSpecialHole" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfProfileCatalog" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfMaterialCatalog" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuic:WpfBoltCatalogSize" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuic:WpfBoltCatalogStandard" />
        </ResourceDictionary>
    </tsdlg:PluginWindowBase.Resources>

    <DockPanel>
        <tsuic:WpfSaveLoad DockPanel.Dock="Top" Margin="0,0,0,0" />
        <tsuic:WpfOkApplyModifyGetOnOffCancel DockPanel.Dock="Bottom"
                                              ApplyClicked="WPFOkApplyModifyGetOnOffCancel_ApplyClicked"
                                              CancelClicked="WPFOkApplyModifyGetOnOffCancel_CancelClicked"
                                              GetClicked="WPFOkApplyModifyGetOnOffCancel_GetClicked"
                                              ModifyClicked="WPFOkApplyModifyGetOnOffCancel_ModifyClicked"
                                              OkClicked="WPFOkApplyModifyGetOnOffCancel_OkClicked"
                                              OnOffClicked="WPFOkApplyModifyGetOnOffCancel_OnOffClicked" />
        <TextBlock DockPanel.Dock="Bottom" Margin="4" TextWrapping="Wrap">
            <Run>Huang YongXing -</Run>
            <Hyperlink NavigateUri="mailto:thinkerhua@hotmail.com">thinkerhua@hotmail.com</Hyperlink>
        </TextBlock>

        <TabControl>

            <TabItem Header="{tr:Translate albl_Parameters}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Canvas Grid.Column="0" Height="440">
                        <Image Canvas.Left="15" Canvas.Top="10" Stretch="None">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource FrontViewWidthDimension}" />
                            </Image.Source>
                        </Image>

                        <Image Canvas.Left="30.7" Canvas.Top="250" Stretch="None">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource TopViewWithDimension}" />
                            </Image.Source>
                        </Image>

                        <TextBlock Canvas.Left="3" Canvas.Top="100" Text="D" />
                        <TextBlock Canvas.Left="164" Canvas.Top="304" Text="d1" />
                        <TextBlock Canvas.Left="114" Canvas.Top="338" Text="d2" />
                        <TextBlock Canvas.Left="74" Canvas.Top="314" Text="px" />
                        <TextBlock Canvas.Left="110" Canvas.Top="280" Text="py" />
                        <TextBlock Canvas.Left="174" Canvas.Top="176" Text="o1" />
                        <TextBlock Canvas.Left="174" Canvas.Top="156" Text="dx1" />
                        <TextBlock Canvas.Left="120" Canvas.Top="158" Text="dy1" />
                        <TextBlock Canvas.Left="120" Canvas.Top="418" Text="dy1" />
                        <TextBlock Canvas.Left="244" Canvas.Top="182" Text="o2" />
                        <TextBlock Canvas.Left="244" Canvas.Top="166" Text="dx2" />
                        <TextBlock Canvas.Left="244" Canvas.Top="320" Text="dy2" />
                    </Canvas>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{tsdlg:Loc albl_stiffener_distance_to_base_plate}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="D" />
                        <tsuic:WpfFilterCheckBox Grid.Row="0" Grid.Column="2" AttributeName="StifDistToBase" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding StifDistToBase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{tsdlg:Loc albl_pouring_hole_diameter}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="d1" />
                        <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="2" AttributeName="PouringHoleDiameter" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding PouringHoleDiameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{tsdlg:Loc albl_exhaust_hole_diameter}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="d2" />
                        <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="2" AttributeName="ExhaustHoleDiameter" />
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ExhaustHoleDiameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{tsdlg:Loc albl_exhaust_hole_position_X}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="px" />
                        <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="2" AttributeName="ExhaustHolePosX" />
                        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding ExhaustHolePosX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{tsdlg:Loc albl_exhaust_hole_position_Y}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="py" />
                        <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="2" AttributeName="ExhaustHolePosY" />
                        <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding ExhaustHolePosY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Separator Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{tsdlg:Loc albl_stiffener_chamfer}" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="{tr:Translate albl_Chamfer_Header_Type}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="8" Grid.Column="2" AttributeName="CFStifTYPE" />
                        <ComboBox Grid.Row="8"
                                  Grid.Column="3"
                                  SelectedIndex="{Binding ChamferStifType, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource SymbolDataTemplate}"
                                  ItemsSource="{x:Static assets:ChamferSymbols.ChamferTypeSet}" />

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="{tr:Translate albl_Chamfer_Header_X}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="9" Grid.Column="2" AttributeName="CFStifX" IsEnabled="{Binding ChamferStifType, Mode=OneWay, Converter={StaticResource ChamferTypeToXIsEnabled}}" />
                        <TextBox Grid.Row="9" Grid.Column="3" Text="{Binding ChamferStifX, Mode=TwoWay}" IsEnabled="{Binding ChamferStifType, Mode=OneWay, Converter={StaticResource ChamferTypeToXIsEnabled}}" />

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="{tr:Translate albl_Chamfer_Header_Y}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="10" Grid.Column="2" AttributeName="CFStifY" IsEnabled="{Binding ChamferStifType, Mode=OneWay, Converter={StaticResource ChamferTypeToYIsEnabled}}" />
                        <TextBox Grid.Row="10" Grid.Column="3" Text="{Binding ChamferStifY, Mode=TwoWay}" IsEnabled="{Binding ChamferStifType, Mode=OneWay, Converter={StaticResource ChamferTypeToYIsEnabled}}" />

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="{tr:Translate albl_Chamfer_Header_Dz1}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="11" Grid.Column="2" AttributeName="CFStifDZ1" />
                        <TextBox Grid.Row="11" Grid.Column="3" Text="{Binding ChamferStifDz1, Mode=TwoWay}" />

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="{tr:Translate albl_Chamfer_Header_Dz2}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="12" Grid.Column="2" AttributeName="CFStifDZ2" />
                        <TextBox Grid.Row="12" Grid.Column="3" Text="{Binding ChamferStifDz2, Mode=TwoWay}" />

                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{tr:Translate albl_Parts}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Id}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Name}" />
                    <TextBlock Grid.Row="0" Grid.Column="4" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Thickness}" />
                    <TextBlock Grid.Row="0" Grid.Column="6" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Breadth}" />
                    <TextBlock Grid.Row="0" Grid.Column="8" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Height}" />
                    <TextBlock Grid.Row="0" Grid.Column="11" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Material}" />
                    <TextBlock Grid.Row="0" Grid.Column="14" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Finish}" />
                    <TextBlock Grid.Row="0" Grid.Column="16" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Class}" />
                    <TextBlock Grid.Row="0" Grid.Column="18" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_NumberingSeries_Prefix}" />
                    <TextBlock Grid.Row="0" Grid.Column="20" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_NumberingSeries_StartNumber}" />

                    <TextBlock Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_base_plate}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLBaseName" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateBaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLBaseT" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateBaseThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="5" AttributeName="PLBaseB" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="6" Text="{Binding PlateBaseBreadth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="7" AttributeName="PLBaseH" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="8" Text="{Binding PlateBaseHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLBaseMATL" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateBaseMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="1"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateBaseMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLBaseFNSH" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateBaseFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLBaseCLS" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateBaseClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="17" AttributeName="PLBasePTP" />
                    <TextBox Grid.Row="1" Grid.Column="18" Text="{Binding PlateBasePartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="19" AttributeName="PLBasePTN" />
                    <TextBox Grid.Row="1" Grid.Column="20" Text="{Binding PlateBasePartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="17" AttributeName="PLBaseASMP" />
                    <TextBox Grid.Row="2" Grid.Column="18" Text="{Binding PlateBaseAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="19" AttributeName="PLBaseASMN" />
                    <TextBox Grid.Row="2" Grid.Column="20" Text="{Binding PlateBaseAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_stiffener}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLStifName" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateStifName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLStifT" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateStifThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLStifMATL" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateStifMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="3"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateStifMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLStifFNSH" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateStifFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLStifCLS" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateStifClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="17" AttributeName="PLStifPTP" />
                    <TextBox Grid.Row="3" Grid.Column="18" Text="{Binding PlateStifPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="19" AttributeName="PLStifPTN" />
                    <TextBox Grid.Row="3" Grid.Column="20" Text="{Binding PlateStifPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="17" AttributeName="PLStifASMP" />
                    <TextBox Grid.Row="4" Grid.Column="18" Text="{Binding PlateStifAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="19" AttributeName="PLStifASMN" />
                    <TextBox Grid.Row="4" Grid.Column="20" Text="{Binding PlateStifAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_washer_plate}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLWasherName" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateWasherName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLWasherT" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateWasherThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="5" AttributeName="PLWasherB" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="6" Text="{Binding PlateWasherBreadth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLWasherMATL" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateWasherMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="5"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateWasherMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLWasherFNSH" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateWasherFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLWasherCLS" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateWasherClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="17" AttributeName="PLWasherPTP" />
                    <TextBox Grid.Row="5" Grid.Column="18" Text="{Binding PlateWasherPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="19" AttributeName="PLWasherPTN" />
                    <TextBox Grid.Row="5" Grid.Column="20" Text="{Binding PlateWasherPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="17" AttributeName="PLWasherASMP" />
                    <TextBox Grid.Row="6" Grid.Column="18" Text="{Binding PlateWasherAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="19" AttributeName="PLWasherASMN" />
                    <TextBox Grid.Row="6" Grid.Column="20" Text="{Binding PlateWasherAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="7" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_anchor}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="1" AttributeName="PTAnchorRodName" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PartAnchorRodName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="10" AttributeName="PTAnchorRodMATL" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PartAnchorRodMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="7"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PartAnchorRodMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="13" AttributeName="PTAnchorRodFNSH" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PartAnchorRodFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="15" AttributeName="PTAnchorRodCLS" />
