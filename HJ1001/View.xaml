                                  Grid.RowSpan="2"
                                  Grid.Column="28"
                                  ItemTemplate="{x:Null}"
                                  SelectedIndex="{Binding Weld2Preparation, Mode=TwoWay}"
                                  ItemsSource="{x:Static assets:WeldSymbols.WeldPreparationSet}" />

                        <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="29" AttributeName="W2INTMI" />
                        <ComboBox Grid.Row="3"
                                  Grid.RowSpan="2"
                                  Grid.Column="30"
                                  SelectedIndex="{Binding Weld2Intermittent, Mode=TwoWay}"
                                  ItemsSource="{x:Static assets:WeldSymbols.WeldIntermittentSet}" />

                        <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="31" AttributeName="W2INCRA" />
                        <TextBox Grid.Row="3" Grid.Column="32" Text="{Binding Weld2IncrementAmountAbove, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="31" AttributeName="W2INCRB" />
                        <TextBox Grid.Row="4" Grid.Column="32" Text="{Binding Weld2IncrementAmountBelow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="33" AttributeName="W2LENA" />
                        <TextBox Grid.Row="3" Grid.Column="34" Text="{Binding Weld2LengthAbove, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="33" AttributeName="W2LENB" />
                        <TextBox Grid.Row="4" Grid.Column="34" Text="{Binding Weld2LengthBelow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="35" AttributeName="W2PITA" />
                        <TextBox Grid.Row="3" Grid.Column="36" Text="{Binding Weld2PitchAbove, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="35" AttributeName="W2PITB" />
                        <TextBox Grid.Row="4" Grid.Column="36" Text="{Binding Weld2PitchBelow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="37" AttributeName="W2TEXT" />
                        <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="38" Text="{Binding Weld2ReferenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    </Grid>

                    <Canvas Grid.Row="1" Height="160">
                        <Image Canvas.Left="10" Canvas.Top="0" Width="160" Height="160">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource EndViewWithWeldDimension}" />
                            </Image.Source>
                        </Image>

                        <TextBlock Canvas.Left="160" Canvas.Top="5" Text="1" />
                        <TextBlock Canvas.Left="160" Canvas.Top="135" Text="2" />
                    </Canvas>
                </Grid>
            </TabItem>

            <TabItem HorizontalContentAlignment="Right" Header="{tr:Translate albl_General}" Content="{StaticResource ConnectionGeneralTab}" />
        </TabControl>
    </DockPanel>
</tsdlg:PluginWindowBase>
