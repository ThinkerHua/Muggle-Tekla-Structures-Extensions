<tsdlg:PluginWindowBase x:Class="Muggle.TsExtensions.HJ1001.View"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:local="clr-namespace:Muggle.TsExtensions.HJ1001"
                        xmlns:tsdlg="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
                        xmlns:tsuic="clr-namespace:Tekla.Structures.Dialog.UIControls;assembly=Tekla.Structures.Dialog"
                        xmlns:ctrls="clr-namespace:Muggle.TsExtensions.Common.WPF.Controls;assembly=Common.WPF"
                        xmlns:assets="clr-namespace:Muggle.TsExtensions.Common.WPF.Assets;assembly=Common.WPF"
                        xmlns:tr="clr-namespace:Muggle.TsExtensions.Common.WPF.Localization;assembly=Common.WPF"
                        xmlns:vc="clr-namespace:Muggle.TsExtensions.Common.WPF.ValueConverters;assembly=Common.WPF"
                        Title="{tsdlg:Loc albl_HJ1001_title}"
                        ResizeMode="NoResize"
                        SizeToContent="WidthAndHeight"
                        UseDefaultStyle="False"
                        Background="#F3F3F7"
                        mc:Ignorable="d">

    <tsdlg:PluginWindowBase.DataContext>
        <local:ViewModel />
    </tsdlg:PluginWindowBase.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HJ1001;component/Assets/Backgrounds.xaml" />
                <ResourceDictionary Source="/Common.WPF;component/Controls/PresetControlGroups.xaml" />
                <ResourceDictionary Source="/Common.WPF;component/DataTemplates/SymbolDataTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <vc:BoltHoleTypeToSlottedHoleXDisplayNameConverter x:Key="BoltHoleTypeToSlottedHoleXDisplayName" />
            <vc:BoltHoleTypeToSlottedHoleXIsEnabledConverter x:Key="BoltHoleTypeToSlottedHoleXIsEnabled" />
            <vc:BoltHoleTypeToSlottedHoleYIsEnabledConverter x:Key="BoltHoleTypeToSlottedHoleYIsEnabled" />
            <vc:BoltHoleTypeToRotateSlotsIsEnabledConverter x:Key="BoltHoleTypeToRotateSlotsIsEnabled" />
            <vc:BoltPlainHoleTypeToBlindHoleDepthIsEnabledConverter x:Key="BoltPlainHoleTypeToBlindHoleDepthIsEnabled" />
            <vc:ChamferTypeToXIsEnabledConverter x:Key="ChamferTypeToXIsEnabled" />
            <vc:ChamferTypeToYIsEnabledConverter x:Key="ChamferTypeToYIsEnabled" />

            <Style x:Key="Element" TargetType="FrameworkElement">
                <Setter Property="Margin" Value="2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ContainingTextBoxElement" TargetType="FrameworkElement" BasedOn="{StaticResource Element}">
                <Setter Property="Height" Value="20" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="CheckBox" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="TextBox">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="ComboBox" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfFilterCheckBox">
                <Setter Property="Margin" Value="2,2,-2,2" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfProfileCatalog" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfMaterialCatalog" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuic:WpfBoltCatalogSize" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuic:WpfBoltCatalogStandard" />
            <Style BasedOn="{StaticResource Element}" TargetType="ctrls:BoltAssembly" />
            <Style BasedOn="{StaticResource Element}" TargetType="ctrls:BoltSpecialHole" />

            <DataTemplate x:Key="StifKindDataTemplate" DataType="DrawingImage">
                <Image Width="30" Height="30" Source="{Binding}" />
            </DataTemplate>

            <x:Array x:Key="StifKindSet" Type="DrawingImage">
                <DrawingImage Drawing="{StaticResource StiffenerKind1}" />
                <DrawingImage Drawing="{StaticResource StiffenerKind2}" />
            </x:Array>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <tsuic:WpfSaveLoad DockPanel.Dock="Top" />
        <tsuic:WpfOkApplyModifyGetOnOffCancel DockPanel.Dock="Bottom"
                                              ApplyClicked="WPFOkApplyModifyGetOnOffCancel_ApplyClicked"
                                              CancelClicked="WPFOkApplyModifyGetOnOffCancel_CancelClicked"
                                              GetClicked="WPFOkApplyModifyGetOnOffCancel_GetClicked"
                                              ModifyClicked="WPFOkApplyModifyGetOnOffCancel_ModifyClicked"
                                              OkClicked="WPFOkApplyModifyGetOnOffCancel_OkClicked"
                                              OnOffClicked="WPFOkApplyModifyGetOnOffCancel_OnOffClicked" />
        <TextBlock DockPanel.Dock="Bottom" Margin="4" TextWrapping="Wrap">
            <Run>Huang YongXing -</Run>
            <Hyperlink NavigateUri="mailto:thinkerhua@hotmail.com">thinkerhua@hotmail.com</Hyperlink>
        </TextBlock>

        <TabControl>

            <TabItem Header="{tr:Translate albl_Parameters}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Canvas Grid.Column="0" Width="160" Height="160">
                        <Image Canvas.Left="10"
                               Canvas.Top="10"
                               Width="140"
                               Height="140"
                               Stretch="Uniform">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource EndViewWithDimension}" />
                            </Image.Source>
                        </Image>

                        <TextBlock Canvas.Left="115" Canvas.Top="5" Text="m" />
                    </Canvas>

                    <Grid Grid.Column="1" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{tsdlg:Loc albl_stiffener_quantity}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="0" Grid.Column="2" AttributeName="Quantity" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{tsdlg:Loc albl_margin}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="m" />
                        <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="2" AttributeName="Margin" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Margin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{tsdlg:Loc albl_stiffener_kind}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="2" AttributeName="StifKind" />
                        <ComboBox Grid.Row="2"
                                  Grid.Column="3"
                                  Height="30"
                                  SelectedIndex="{Binding StifKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemTemplate="{StaticResource StifKindDataTemplate}"
                                  ItemsSource="{StaticResource StifKindSet}"
                                  d:SelectedIndex="1" />

                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{tr:Translate albl_Parts}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Id}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Name}" />
                    <TextBlock Grid.Row="0" Grid.Column="4" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Thickness}" />
                    <TextBlock Grid.Row="0" Grid.Column="6" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Breadth}" />
                    <TextBlock Grid.Row="0" Grid.Column="8" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Height}" />
                    <TextBlock Grid.Row="0" Grid.Column="11" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Material}" />
                    <TextBlock Grid.Row="0" Grid.Column="14" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Finish}" />
                    <TextBlock Grid.Row="0" Grid.Column="16" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Class}" />
                    <TextBlock Grid.Row="0" Grid.Column="18" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_NumberingSeries_Prefix}" />
                    <TextBlock Grid.Row="0" Grid.Column="20" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_NumberingSeries_StartNumber}" />

                    <TextBlock Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_end_plate}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLEndName" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateEndName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLEndT" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateEndThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="5" AttributeName="PLEndB" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="6" Text="{Binding PlateEndBreadth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLEndMATL" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateEndMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="1"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateEndMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLEndFNSH" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateEndFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLEndCLS" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateEndClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="17" AttributeName="PLEndPTP" />
                    <TextBox Grid.Row="1" Grid.Column="18" Text="{Binding PlateEndPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="19" AttributeName="PLEndPTN" />
                    <TextBox Grid.Row="1" Grid.Column="20" Text="{Binding PlateEndPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="17" AttributeName="PLEndASMP" />
                    <TextBox Grid.Row="2" Grid.Column="18" Text="{Binding PlateEndAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="19" AttributeName="PLEndASMN" />
                    <TextBox Grid.Row="2" Grid.Column="20" Text="{Binding PlateEndAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_stiffener}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLStiffenerName" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateStiffenerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLStiffenerT" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateStiffenerThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="5" AttributeName="PLStiffenerB" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="6" Text="{Binding PlateStiffenerBreadth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLStiffenerMATL" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateStiffenerMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="3"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateStiffenerMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLStiffenerFNSH" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateStiffenerFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLStiffenerCLS" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateStiffenerClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="17" AttributeName="PLStiffenerPTP" />
                    <TextBox Grid.Row="3" Grid.Column="18" Text="{Binding PlateStiffenerPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="19" AttributeName="PLStiffenerPTN" />
                    <TextBox Grid.Row="3" Grid.Column="20" Text="{Binding PlateStiffenerPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="17" AttributeName="PLStiffenerASMP" />
                    <TextBox Grid.Row="4" Grid.Column="18" Text="{Binding PlateStiffenerAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="19" AttributeName="PLStiffenerASMN" />
                    <TextBox Grid.Row="4" Grid.Column="20" Text="{Binding PlateStiffenerAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                </Grid>
            </TabItem>

            <TabItem Header="{tr:Translate albl_Chamfers}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Text="{tr:Translate albl_Chamfer_Header_Id}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Text="{tr:Translate albl_Chamfer_Header_Type}" />
                    <TextBlock Grid.Row="0" Grid.Column="4" HorizontalAlignment="Center" Text="{tr:Translate albl_Chamfer_Header_X}" />
                    <TextBlock Grid.Row="0" Grid.Column="6" HorizontalAlignment="Center" Text="{tr:Translate albl_Chamfer_Header_Y}" />
                    <TextBlock Grid.Row="0" Grid.Column="8" HorizontalAlignment="Center" Text="{tr:Translate albl_Chamfer_Header_Dz1}" />
                    <TextBlock Grid.Row="0" Grid.Column="10" HorizontalAlignment="Center" Text="{tr:Translate albl_Chamfer_Header_Dz2}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{tsdlg:Loc albl_inside}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="1" AttributeName="CFInsideTYPE" />
                    <ComboBox Grid.Row="1"
                              Grid.Column="2"
                              SelectedIndex="{Binding ChamferInsideType, Mode=TwoWay}"
                              ItemTemplate="{StaticResource SymbolDataTemplate}"
                              ItemsSource="{x:Static assets:ChamferSymbols.ChamferTypeSet}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="3" AttributeName="CFInsideX" IsEnabled="{Binding ChamferInsideType, Mode=OneWay, Converter={StaticResource ChamferTypeToXIsEnabled}}" />
                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding ChamferInsideX, Mode=TwoWay}" IsEnabled="{Binding ChamferInsideType, Mode=OneWay, Converter={StaticResource ChamferTypeToXIsEnabled}}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="5" AttributeName="CFInsideY" IsEnabled="{Binding ChamferInsideType, Mode=OneWay, Converter={StaticResource ChamferTypeToYIsEnabled}}" />
                    <TextBox Grid.Row="1" Grid.Column="6" Text="{Binding ChamferInsideY, Mode=TwoWay}" IsEnabled="{Binding ChamferInsideType, Mode=OneWay, Converter={StaticResource ChamferTypeToYIsEnabled}}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="7" AttributeName="CFInsideDZ1" />
                    <TextBox Grid.Row="1" Grid.Column="8" Text="{Binding ChamferInsideDz1, Mode=TwoWay}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="9" AttributeName="CFInsideDZ2" />
                    <TextBox Grid.Row="1" Grid.Column="10" Text="{Binding ChamferInsideDz2, Mode=TwoWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{tsdlg:Loc albl_outside}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="1" AttributeName="CFOutsideTYPE" />
                    <ComboBox Grid.Row="2"
                              Grid.Column="2"
                              SelectedIndex="{Binding ChamferOutsideType, Mode=TwoWay}"
                              ItemTemplate="{StaticResource SymbolDataTemplate}"
                              ItemsSource="{x:Static assets:ChamferSymbols.ChamferTypeSet}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="3" AttributeName="CFOutsideX" IsEnabled="{Binding ChamferOutsideType, Mode=OneWay, Converter={StaticResource ChamferTypeToXIsEnabled}}" />
                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding ChamferOutsideX, Mode=TwoWay}" IsEnabled="{Binding ChamferOutsideType, Mode=OneWay, Converter={StaticResource ChamferTypeToXIsEnabled}}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="5" AttributeName="CFOutsideY" IsEnabled="{Binding ChamferOutsideType, Mode=OneWay, Converter={StaticResource ChamferTypeToYIsEnabled}}" />
                    <TextBox Grid.Row="2" Grid.Column="6" Text="{Binding ChamferOutsideY, Mode=TwoWay}" IsEnabled="{Binding ChamferOutsideType, Mode=OneWay, Converter={StaticResource ChamferTypeToYIsEnabled}}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="7" AttributeName="CFOutsideDZ1" />
                    <TextBox Grid.Row="2" Grid.Column="8" Text="{Binding ChamferOutsideDz1, Mode=TwoWay}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="9" AttributeName="CFOutsideDZ2" />
                    <TextBox Grid.Row="2" Grid.Column="10" Text="{Binding ChamferOutsideDz2, Mode=TwoWay}" />

                </Grid>
            </TabItem>

            <TabItem Header="{tr:Translate albl_BoltCircle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_Size}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="0" Grid.Column="1" AttributeName="BC1SIZE" />
                    <tsuic:WpfBoltCatalogSize Grid.Row="0" Grid.Column="2" SelectedItem="{Binding BoltCircle1Size, Mode=TwoWay}" ItemsSource="{Binding Path=BoltSizes, ElementName=Bolt1StdCatalog}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_Standard}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="1" AttributeName="BC1STD" />
                    <tsuic:WpfBoltCatalogStandard x:Name="Bolt1StdCatalog" Grid.Row="1" Grid.Column="2" SelectedItem="{Binding BoltCircle1Standard, Mode=TwoWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_BoltType}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="1" AttributeName="BC1TYPE" />
                    <ComboBox Grid.Row="2" Grid.Column="2" SelectedIndex="{Binding BoltCircle1Type, Mode=TwoWay}" ItemsSource="{x:Static assets:BoltSymbols.BoltTypeSet}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_ThreadInMaterial}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="1" AttributeName="BC1THRD" />
                    <ComboBox Grid.Row="3" Grid.Column="2" SelectedIndex="{Binding BoltCircle1ThreadInMaterial, Mode=TwoWay}" ItemsSource="{x:Static assets:BoltSymbols.BoltThreadInMaterialSet}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_CutLength}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="1" AttributeName="BC1CLEN" />
                    <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding BoltCircle1CutLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_ExtraLength}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="1" AttributeName="BC1XLEN" />
                    <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding BoltCircle1ExtraLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_Tolerance}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="1" AttributeName="BC1TOL" />
                    <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding BoltCircle1Tolerance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_PlainHoleType}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.Column="1" AttributeName="BC1PLAIN" />
                    <ComboBox Grid.Row="7" Grid.Column="2" SelectedIndex="{Binding BoltCircle1PlainType, Mode=TwoWay}" ItemsSource="{x:Static assets:BoltSymbols.BoltPlainHoleTypeSet}" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_HoleDepth}" />
