<tsd:PluginWindowBase x:Class="Muggle.TsExtensions.HJ1001.Views.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:tsd="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
                      xmlns:tsuc="clr-namespace:Tekla.Structures.Dialog.UIControls;assembly=Tekla.Structures.Dialog"
                      xmlns:vm="clr-namespace:Muggle.TsExtensions.HJ1001.ViewModels"
                      xmlns:tr="clr-namespace:Muggle.TsExtensions.Common.WPF.Localization;assembly=Common.WPF"
                      Title="{tsd:Loc albl_HJ1001_title}"
                      ResizeMode="NoResize"
                      SizeToContent="WidthAndHeight"
                      UseDefaultStyle="False"
                      mc:Ignorable="d">
    <d:Window.DataContext>
        <vm:MainWindowViewModel />
    </d:Window.DataContext>
    <tsd:PluginWindowBase.DataContext>
        <vm:MainWindowViewModel />
    </tsd:PluginWindowBase.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HJ1001;component/Assets/backgroundImage.xaml" />
                <ResourceDictionary Source="/Common.WPF;component/Assets/UpDirection.xaml" />
                <ResourceDictionary Source="/Common.WPF;component/Controls/PresetControlGroups.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Element" TargetType="FrameworkElement">
                <Setter Property="Margin" Value="2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ContainingTextBoxElement" TargetType="FrameworkElement" BasedOn="{StaticResource Element}">
                <Setter Property="Height" Value="20" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="CheckBox" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="TextBox">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="ComboBox" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuc:WpfFilterCheckBox" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuc:WpfProfileCatalog" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuc:WpfMaterialCatalog" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuc:WpfBoltCatalogSize" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuc:WpfBoltCatalogStandard" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <tsuc:WpfSaveLoad DockPanel.Dock="Top" />
        <tsuc:WpfOkApplyModifyGetOnOffCancel DockPanel.Dock="Bottom"
                                                ApplyClicked="WPFOkApplyModifyGetOnOffCancel_ApplyClicked"
                                                CancelClicked="WPFOkApplyModifyGetOnOffCancel_CancelClicked"
                                                GetClicked="WPFOkApplyModifyGetOnOffCancel_GetClicked"
                                                ModifyClicked="WPFOkApplyModifyGetOnOffCancel_ModifyClicked"
                                                OkClicked="WPFOkApplyModifyGetOnOffCancel_OkClicked"
                                                OnOffClicked="WPFOkApplyModifyGetOnOffCancel_OnOffClicked" />
        <TextBlock Margin="4" DockPanel.Dock="Bottom" TextWrapping="Wrap">
            <Run>Huang YongXing -</Run>
            <Hyperlink NavigateUri="mailto:thinkerhua@hotmail.com">thinkerhua@hotmail.com</Hyperlink>
        </TextBlock>

        <TabControl>
            <TabItem Header="{tsd:Loc albl_parameters}">
                <DockPanel>
                    <Canvas Width="185" DockPanel.Dock="Left">
                        <Image Width="185">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource ResourceKey=backgroundImage}" />
                            </Image.Source>
                        </Image>
                        <TextBlock Canvas.Left="140" Canvas.Top="0" Text="m" />
                        <TextBlock Canvas.Left="86" Canvas.Top="180" Text="d" />
                        <TextBlock Canvas.Left="86" Canvas.Top="200" Text="D" />
                    </Canvas>
                    <Grid DockPanel.Dock="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{tsd:Loc albl_end_plate_thickness}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="0" Grid.Column="2" AttributeName="endPlateTHK" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EndPlateThickness, Mode=TwoWay}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{tsd:Loc albl_end_plate_diameter}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="D" />
                        <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.Column="2" AttributeName="endPlateDIAM" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding EndPlateDiameter, Mode=TwoWay}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{tsd:Loc albl_creat_primary_stiffeners}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="2" Grid.Column="2" AttributeName="creatPrimStif" />
                        <CheckBox Grid.Row="2" Grid.Column="3" IsChecked="{Binding CreatPrimaryStiffeners, Mode=TwoWay}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{tsd:Loc albl_creat_secondary_stiffeners}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="3" Grid.Column="2" AttributeName="creatSecStif" />
                        <CheckBox Grid.Row="3" Grid.Column="3" IsChecked="{Binding CreatSecondaryStiffeners, Mode=TwoWay}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{tsd:Loc albl_stiffener_thickness}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="4" Grid.Column="2" AttributeName="stifTHK" />
                        <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding StiffenerThickness, Mode=TwoWay}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{tsd:Loc albl_stiffener_width}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="5" Grid.Column="2" AttributeName="stifWidth" />
                        <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding StiffenerWidth, Mode=TwoWay}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{tsd:Loc albl_chamfer_size_X}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="6" Grid.Column="2" AttributeName="chamX" />
                        <TextBox Grid.Row="6" Grid.Column="3" Text="{Binding ChamferSizeX, Mode=TwoWay}" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{tsd:Loc albl_chamfer_size_Y}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="7" Grid.Column="2" AttributeName="chamY" />
                        <TextBox Grid.Row="7" Grid.Column="3" Text="{Binding ChamferSizeY, Mode=TwoWay}" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="{tsd:Loc albl_distance_to_edge}" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="m" />
                        <tsuc:WpfFilterCheckBox Grid.Row="8" Grid.Column="2" AttributeName="margin" />
                        <TextBox Grid.Row="8" Grid.Column="3" Text="{Binding Margin, Mode=TwoWay}" />

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="{tsd:Loc albl_quantity}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="9" Grid.Column="2" AttributeName="quantity" />
                        <TextBox Grid.Row="9" Grid.Column="3" Text="{Binding Quantity, Mode=TwoWay}" />

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="{tsd:Loc albl_creat_bolt}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="10" Grid.Column="2" AttributeName="creatBolt" />
                        <CheckBox Grid.Row="10" Grid.Column="3" IsChecked="{Binding CreatBolt, Mode=TwoWay}" />

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="{tsd:Loc albl_bolt_standard}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="11" Grid.Column="2" AttributeName="boltStandard" />
                        <tsuc:WpfBoltCatalogStandard x:Name="BoltStd" Grid.Row="11" Grid.Column="3" SelectedItem="{Binding BoltStandard, Mode=TwoWay}" />

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="{tsd:Loc albl_bolt_size}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="12" Grid.Column="2" AttributeName="boltSize" />
                        <tsuc:WpfBoltCatalogSize Grid.Row="12" Grid.Column="3" SelectedItem="{Binding BoltSize, Mode=TwoWay}" ItemsSource="{Binding ElementName=BoltStd, Path=BoltSizes}" />

                        <TextBlock Grid.Row="13" Grid.Column="0" Text="{tsd:Loc albl_bolt_circle_diameter}" />
                        <TextBlock Grid.Row="13" Grid.Column="1" Text="d" />
                        <tsuc:WpfFilterCheckBox Grid.Row="13" Grid.Column="2" AttributeName="boltCircleDiameter" />
                        <TextBox Grid.Row="13" Grid.Column="3" Text="{Binding BoltCircleDiameter, Mode=TwoWay}" />

                        <TextBlock Grid.Row="14" Grid.Column="0" Text="{tsd:Loc albl_material}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="14" Grid.Column="2" AttributeName="material" />
                        <TextBox Grid.Row="14" Grid.Column="3" Text="{Binding Material, Mode=TwoWay}" />
                        <tsuc:WpfMaterialCatalog Grid.Row="14" Grid.Column="4" SelectClicked="WpfMaterialCatalog_SelectClicked" SelectionDone="WpfMaterialCatalog_SelectionDone" />
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{tr:Translate albl_General}" Content="{StaticResource ConnectionGeneralTab}" />
        </TabControl>
    </DockPanel>
</tsd:PluginWindowBase>
