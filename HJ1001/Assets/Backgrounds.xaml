<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush_Transparent" Color="Transparent" />
    <SolidColorBrush x:Key="Brush_InstanceBorder" Color="Black" />
    <SolidColorBrush x:Key="Brush_JointPlateFill" Color="#FF898989" />
    <SolidColorBrush x:Key="Brush_JointPlateFill_Dark" Color="#FF5B5B5B" />
    <SolidColorBrush x:Key="Brush_JointPlateFill_Light" Color="#FFBDBDA5" />
    <SolidColorBrush x:Key="Brush_JointPlateFill2" Color="#FF44BEA4" />
    <SolidColorBrush x:Key="Brush_PrimPartFill" Color="#FF316BB5" />
    <SolidColorBrush x:Key="Brush_SecdPartFill" Color="#FF2F94C4" />
    <SolidColorBrush x:Key="Brush_BoltFill" Color="#FFA8751F" />
    <SolidColorBrush x:Key="Brush_BoltFill_Light" Color="#FFDBAE20" />
    <SolidColorBrush x:Key="Brush_Weld" Color="#FFAAFFFF" />
    <SolidColorBrush x:Key="Brush_Dimension" Color="MediumSeaGreen" />
    <SolidColorBrush x:Key="Brush_Leader" Color="Black" />
    <SolidColorBrush x:Key="Brush_Section" Color="Black" />
    <SolidColorBrush x:Key="Brush_Break" Color="Black" />
    <SolidColorBrush x:Key="Brush_Axis" Color="Red" />
    <Pen x:Key="Pen_Transparent" Brush="{StaticResource Brush_Transparent}" />
    <Pen x:Key="Pen_InstanceBorder" Thickness="0.5" Brush="{StaticResource Brush_InstanceBorder}" />
    <Pen x:Key="Pen_InstanceBorder_Hide" Thickness="0.5" Brush="{StaticResource Brush_InstanceBorder}">
        <Pen.DashStyle>
            <DashStyle Dashes="20,10" />
        </Pen.DashStyle>
    </Pen>
    <Pen x:Key="Pen_Dimension" Thickness="0.5" Brush="{StaticResource Brush_Dimension}" />
    <Pen x:Key="Pen_Dimension_Arrow" Thickness="1" Brush="{StaticResource Brush_Dimension}" />
    <Pen x:Key="Pen_Axis" Thickness="0.5" Brush="{StaticResource Brush_Axis}">
        <Pen.DashStyle>
            <DashStyle Dashes="25,10,5,10" />
        </Pen.DashStyle>
    </Pen>
    <Pen x:Key="Pen_Leader" Thickness="0.5" Brush="{StaticResource Brush_Leader}" />
    <Pen x:Key="Pen_Break" Thickness="0.5" Brush="{StaticResource Brush_Section}" />
    <Pen x:Key="Pen_Section" Thickness="2" Brush="{StaticResource Brush_Section}" />

    <DrawingGroup x:Key="BoltFrontView">
        <GeometryDrawing Brush="{StaticResource Brush_BoltFill}" Pen="{StaticResource Pen_InstanceBorder}">
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M-4,0 H4 V1 H-4 Z M-3,0 H3 V-3 H-3 Z M-1.5,0 V-3 M1.5,0 V-3" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <DrawingGroup x:Key="NutFrontView">
        <GeometryDrawing Brush="{StaticResource Brush_BoltFill}" Pen="{StaticResource Pen_InstanceBorder}">
            <GeometryDrawing.Geometry>
                <PathGeometry
                    Figures="M-3,0 H3 V3 H-3 Z M0,0 V3 M-3,3 H3 V6 H-3 Z M-1.5,3 V6 M1.5,3 V6 M-2,6 H2 V8 H-2 Z" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <DrawingGroup x:Key="EndView">
        <!-- EndPlate -->
        <GeometryDrawing Brush="{StaticResource Brush_JointPlateFill}" Pen="{StaticResource Pen_InstanceBorder}">
            <GeometryDrawing.Geometry>
                <EllipseGeometry Center="0,0" RadiusX="50" RadiusY="50" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- InputParts -->
        <GeometryDrawing Brush="{StaticResource Brush_PrimPartFill}" Pen="{StaticResource Pen_InstanceBorder}">
            <GeometryDrawing.Geometry>
                <GeometryGroup FillRule="EvenOdd">
                    <EllipseGeometry Center="0,0" RadiusX="30" RadiusY="30" />
                    <EllipseGeometry Center="0,0" RadiusX="25" RadiusY="25" />
                </GeometryGroup>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Stiffeners -->
        <DrawingGroup>
            <DrawingGroup.Transform>
                <TranslateTransform X="-2" Y="-47" />
            </DrawingGroup.Transform>
            <GeometryDrawing Brush="{StaticResource Brush_JointPlateFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M0,0 H4 V17 A30,30 0 0 0 0,17 Z M0,5 H4" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingGroup>
        <DrawingGroup>
            <DrawingGroup.Transform>
                <TransformGroup>
                    <TranslateTransform X="-2" Y="-47" />
                    <RotateTransform Angle="60" />
                </TransformGroup>
            </DrawingGroup.Transform>
            <GeometryDrawing Brush="{StaticResource Brush_JointPlateFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M0,0 H4 V17 A30,30 0 0 0 0,17 Z M0,5 H4" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingGroup>
        <DrawingGroup>
            <DrawingGroup.Transform>
                <TransformGroup>
                    <TranslateTransform X="-2" Y="-47" />
                    <RotateTransform Angle="120" />
                </TransformGroup>
            </DrawingGroup.Transform>
            <GeometryDrawing Brush="{StaticResource Brush_JointPlateFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M0,0 H4 V17 A30,30 0 0 0 0,17 Z M0,5 H4" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingGroup>
        <DrawingGroup>
            <DrawingGroup.Transform>
                <TransformGroup>
                    <TranslateTransform X="-2" Y="-47" />
                    <RotateTransform Angle="180" />
                </TransformGroup>
            </DrawingGroup.Transform>
            <GeometryDrawing Brush="{StaticResource Brush_JointPlateFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M0,0 H4 V17 A30,30 0 0 0 0,17 Z M0,5 H4" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingGroup>
        <DrawingGroup>
            <DrawingGroup.Transform>
                <TransformGroup>
                    <TranslateTransform X="-2" Y="-47" />
                    <RotateTransform Angle="240" />
                </TransformGroup>
            </DrawingGroup.Transform>
            <GeometryDrawing Brush="{StaticResource Brush_JointPlateFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M0,0 H4 V17 A30,30 0 0 0 0,17 Z M0,5 H4" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingGroup>
        <DrawingGroup>
            <DrawingGroup.Transform>
                <TransformGroup>
                    <TranslateTransform X="-2" Y="-47" />
                    <RotateTransform Angle="300" />
                </TransformGroup>
            </DrawingGroup.Transform>
            <GeometryDrawing Brush="{StaticResource Brush_JointPlateFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M0,0 H4 V17 A30,30 0 0 0 0,17 Z M0,5 H4" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingGroup>

        <!-- Bolts -->
        <DrawingGroup>
            <DrawingGroup.Transform>
                <TransformGroup>
                    <TranslateTransform Y="-40" />
                    <RotateTransform Angle="30" />
                </TransformGroup>
            </DrawingGroup.Transform>
            <GeometryDrawing Brush="{StaticResource Brush_BoltFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry RadiusX="4" RadiusY="4" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource Brush_BoltFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M-1.5,2.5981 H1.5 L3,0 L1.5,-2.5981 H-1.5 L-3,0 Z" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingGroup>
        <DrawingGroup>
            <DrawingGroup.Transform>
                <TransformGroup>
                    <TranslateTransform Y="-40" />
                    <RotateTransform Angle="90" />
                </TransformGroup>
            </DrawingGroup.Transform>
            <GeometryDrawing Brush="{StaticResource Brush_BoltFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry RadiusX="4" RadiusY="4" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource Brush_BoltFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M-1.5,2.5981 H1.5 L3,0 L1.5,-2.5981 H-1.5 L-3,0 Z" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingGroup>
        <DrawingGroup>
            <DrawingGroup.Transform>
                <TransformGroup>
                    <TranslateTransform Y="-40" />
                    <RotateTransform Angle="150" />
                </TransformGroup>
            </DrawingGroup.Transform>
            <GeometryDrawing Brush="{StaticResource Brush_BoltFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry RadiusX="4" RadiusY="4" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource Brush_BoltFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M-1.5,2.5981 H1.5 L3,0 L1.5,-2.5981 H-1.5 L-3,0 Z" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingGroup>
        <DrawingGroup>
            <DrawingGroup.Transform>
                <TransformGroup>
                    <TranslateTransform Y="-40" />
                    <RotateTransform Angle="210" />
                </TransformGroup>
            </DrawingGroup.Transform>
            <GeometryDrawing Brush="{StaticResource Brush_BoltFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry RadiusX="4" RadiusY="4" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource Brush_BoltFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M-1.5,2.5981 H1.5 L3,0 L1.5,-2.5981 H-1.5 L-3,0 Z" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingGroup>
        <DrawingGroup>
            <DrawingGroup.Transform>
                <TransformGroup>
                    <TranslateTransform Y="-40" />
                    <RotateTransform Angle="270" />
                </TransformGroup>
            </DrawingGroup.Transform>
            <GeometryDrawing Brush="{StaticResource Brush_BoltFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry RadiusX="4" RadiusY="4" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource Brush_BoltFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M-1.5,2.5981 H1.5 L3,0 L1.5,-2.5981 H-1.5 L-3,0 Z" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingGroup>
        <DrawingGroup>
            <DrawingGroup.Transform>
                <TransformGroup>
                    <TranslateTransform Y="-40" />
                    <RotateTransform Angle="330" />
                </TransformGroup>
            </DrawingGroup.Transform>
            <GeometryDrawing Brush="{StaticResource Brush_BoltFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry RadiusX="4" RadiusY="4" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource Brush_BoltFill}" Pen="{StaticResource Pen_InstanceBorder}">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M-1.5,2.5981 H1.5 L3,0 L1.5,-2.5981 H-1.5 L-3,0 Z" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingGroup>

    <DrawingGroup x:Key="EndViewWithDimension">
        <GeometryDrawing>
            <GeometryDrawing.Brush>
                <DrawingBrush Drawing="{StaticResource EndView}" />
            </GeometryDrawing.Brush>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="-50.25,-50.25,100.5,100.5" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>

