        <DrawingGroup>
            <GeometryDrawing Pen="{StaticResource Pen_Dimension}">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M8,-50 H24 M8,-47 H24 M20,-50 V-47" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>

            <DrawingGroup>
                <DrawingGroup.Transform>
                    <TranslateTransform X="20" Y="-50" />
                </DrawingGroup.Transform>
                <GeometryDrawing Pen="{StaticResource Pen_Dimension_Arrow}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M-2,2 L2,-2" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>

            <DrawingGroup>
                <DrawingGroup.Transform>
                    <TranslateTransform X="20" Y="-47" />
                </DrawingGroup.Transform>
                <GeometryDrawing Pen="{StaticResource Pen_Dimension_Arrow}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M-2,2 L2,-2" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingGroup>
    </DrawingGroup>

    <DrawingGroup x:Key="EndViewWithWeldDimension">
        <GeometryDrawing>
            <GeometryDrawing.Brush>
                <DrawingBrush Drawing="{StaticResource EndView}" />
            </GeometryDrawing.Brush>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="-50.25,-50.25,100.5,100.5" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <DrawingGroup>
            <GeometryDrawing Pen="{StaticResource Pen_Dimension}">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M18,-24 L45,-40 H60" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingGroup>

        <DrawingGroup>
            <GeometryDrawing Pen="{StaticResource Pen_Dimension}">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M30,20 L45,50 H60" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingGroup>

    <DrawingGroup x:Key="StiffenerKind1">
        <GeometryDrawing Brush="{StaticResource Brush_JointPlateFill}" Pen="{StaticResource Pen_InstanceBorder}">
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M2,0 H24 L0,-18 V-2 Z" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <DrawingGroup x:Key="StiffenerKind2">
        <GeometryDrawing Brush="{StaticResource Brush_JointPlateFill}" Pen="{StaticResource Pen_InstanceBorder}">
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M2,0 H24 V-12 L14,-18 H0 V-2 Z" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>
    
    <DrawingGroup x:Key="Thumbnail">
        <DrawingGroup.Transform>
            <RotateTransform Angle="-30" />
        </DrawingGroup.Transform>
        
        <!-- Stiffener front view -->
        <GeometryDrawing Brush="{StaticResource Brush_JointPlateFill}" Pen="{StaticResource Pen_InstanceBorder}">
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M-20,-18 L-6,-28 V-18 Z M20,18 L6,28 V18 Z M-30,18 L-6,28 V18 Z M30,-18 L6,-28 V-18 Z" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        
        <!-- Primary and secondary -->
        <GeometryDrawing>
            <GeometryDrawing.Pen>
                <Pen Brush="{StaticResource Brush_InstanceBorder}" Thickness="40.5" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M-100,0 A500,500 0 0 0 0,0 A500,500 0 0 1 100,0" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
            <GeometryDrawing.Pen>
                <Pen Brush="{StaticResource Brush_PrimPartFill}" Thickness="39.5" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M-100,0 A500,500 0 0 0 0,0 A500,500 0 0 1 100,0" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Pen="{StaticResource Pen_InstanceBorder}">
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M-102,20 L-98,-20 M102,-20 L98,20" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        
        <!-- End plates -->
        <GeometryDrawing Brush="{StaticResource Brush_JointPlateFill_Dark}" Pen="{StaticResource Pen_InstanceBorder}">
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M-6,-30 H6 V30 H-6 Z M0,-30 V30" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        
        <!-- Stiffeners top view -->
        <GeometryDrawing Brush="{StaticResource Brush_JointPlateFill}" Pen="{StaticResource Pen_InstanceBorder}">
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M-22,-2 H-6 V2 H-22 Z M22,-2 H6 V2 H22 Z" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        
        <DrawingGroup>
            <DrawingGroup.Transform>
                <TranslateTransform Y="-16" />
            </DrawingGroup.Transform>
            <DrawingGroup>
                <DrawingGroup.Transform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                        <RotateTransform Angle="270" />
                        <TranslateTransform X="-7" />
                    </TransformGroup>
                </DrawingGroup.Transform>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <DrawingBrush Drawing="{StaticResource BoltFrontView}" />
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="-4.25,-3.25,8.5,4.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
            <DrawingGroup>
                <DrawingGroup.Transform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                        <RotateTransform Angle="270" />
                        <TranslateTransform X="6" />
                    </TransformGroup>
                </DrawingGroup.Transform>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <DrawingBrush Drawing="{StaticResource NutFrontView}" />
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="-3.25,-0.25,6.5,8.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingGroup>
        <DrawingGroup>
            <DrawingGroup.Transform>
                <TranslateTransform Y="16" />
            </DrawingGroup.Transform>
            <DrawingGroup>
                <DrawingGroup.Transform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                        <RotateTransform Angle="270" />
                        <TranslateTransform X="-7" />
                    </TransformGroup>
                </DrawingGroup.Transform>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <DrawingBrush Drawing="{StaticResource BoltFrontView}" />
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="-4.25,-3.25,8.5,4.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
            <DrawingGroup>
                <DrawingGroup.Transform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                        <RotateTransform Angle="270" />
                        <TranslateTransform X="6" />
                    </TransformGroup>
                </DrawingGroup.Transform>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <DrawingBrush Drawing="{StaticResource NutFrontView}" />
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="-3.25,-0.25,6.5,8.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingGroup>
    </DrawingGroup>
</ResourceDictionary>