<Application x:Class="Muggle.TsExtensions.MainWindow.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cvt="clr-namespace:Muggle.TsExtensions.MainWindow.Converters"
             xmlns:cvc="clr-namespace:Muggle.TsExtensions.Common.WPF.ValueConverters;assembly=Common.WPF"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Uniform.xaml" />
                <ResourceDictionary Source="/Styles/ExpanderStyle1.xaml" />
                <ResourceDictionary Source="/Styles/MenuButtonStyle1.xaml" />
                <ResourceDictionary Source="/Styles/ButtonStyle1.xaml" />
                <ResourceDictionary Source="/Styles/PluginCardButtonStyle1.xaml" />
                <ResourceDictionary Source="/Styles/ToggleButtonStyle1.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <cvc:EnumToBoolValueConverter x:Key="EnumToBool" />
            <cvc:BoolInverterValueConverter x:Key="BoolInverter" />
            <cvt:MultiplesValueConverter x:Key="Multiples" />
            <cvt:PluginNameToIconValueConverter x:Key="PluginNameToIcon" />
            <cvt:RoundDownValueConverter x:Key="RoundDown" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
