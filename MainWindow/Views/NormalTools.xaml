<Page x:Class="Muggle.TsExtensions.MainWindow.Views.NormalTools"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Muggle.TsExtensions.MainWindow.Views"
      xmlns:vm="clr-namespace:Muggle.TsExtensions.MainWindow.ViewModels"
      Title="NormalTools"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:NormalToolsViewModel}"
      d:DesignHeight="300"
      d:DesignWidth="300"
      d:Background="AliceBlue">

    <Page.Resources>
        <ResourceDictionary>
            <Style TargetType="Button">
                <Setter Property="Template" Value="{StaticResource ButtonStyle1}" />
                <Setter Property="Margin" Value="{StaticResource UniformMargin}" />
                <Setter Property="Padding" Value="4,2,4,2" />
                <Setter Property="Height" Value="30" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Margin="0" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Button Content="ShowModelObjectCoordinateSystem" Command="{Binding ShowModelObjectCoordinateSystemCommand}" />
        <Button Content="SelectWeldedObjects" Command="{Binding SelectWeldedObjectsCommand}" />
        <Button Content="ReorderContourPoints" Command="{Binding ReorderContourPointsCommand}" />
        <Button Content="ShowContourOrder" Command="{Binding ShowContourOrderCommand}" />
        <Button Content="CopyWithDirection" Command="{Binding CopyWithDirectionCommand}" />
        <Button Content="LocateToPrecisePosition" Command="{Binding LocateToPrecisePositionCommand}" />

    </StackPanel>
</Page>
