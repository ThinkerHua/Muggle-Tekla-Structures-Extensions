<Page x:Class="Muggle.TsExtensions.MainWindow.Views.ThreeDimensionalRotation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Muggle.TsExtensions.MainWindow.Views"
      xmlns:vm="clr-namespace:Muggle.TsExtensions.MainWindow.ViewModels"
      xmlns:dialog="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
      Title="{dialog:Loc albl_3d_rotation}"
      mc:Ignorable="d"
      d:DesignHeight="300"
      d:DesignWidth="300"
      d:DataContext="{d:DesignInstance Type=vm:ThreeDimensionalRotationViewModel}"
      d:Background="AliceBlue">

    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="element" TargetType="FrameworkElement">
                <Setter Property="Margin" Value="2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="GroupBox" BasedOn="{StaticResource element}">
                <Setter Property="Padding" Value="2" />
            </Style>
            <Style TargetType="RadioButton" BasedOn="{StaticResource element}" />
            <Style TargetType="Button" BasedOn="{StaticResource element}">
                <Setter Property="Template" Value="{StaticResource ButtonStyle1}" />
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource element}">
                <Setter Property="Height" Value="20" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Margin="5">
        <GroupBox Header="{dialog:Loc albl_rotation_axis}">
            <StackPanel>
                <RadioButton Content="{dialog:Loc albl_X_axis_of_part_coordinate_system}" IsChecked="{Binding Axis, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:ThreeDimensionalRotationViewModel+AxisEnum.PartCS_AxisX}}" />
                <RadioButton Content="{dialog:Loc albl_Y_axis_of_part_coordinate_system}" IsChecked="{Binding Axis, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:ThreeDimensionalRotationViewModel+AxisEnum.PartCS_AxisY}}" />
                <RadioButton Content="{dialog:Loc albl_Z_axis_of_part_coordinate_system}" IsChecked="{Binding Axis, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:ThreeDimensionalRotationViewModel+AxisEnum.PartCS_AxisZ}}" />
                <RadioButton Content="{dialog:Loc albl_manually_specify}" IsChecked="{Binding Axis, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:ThreeDimensionalRotationViewModel+AxisEnum.ManualSelect}}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="{dialog:Loc albl_rotation_angle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <RadioButton Grid.Row="0" Grid.Column="0" Content="{dialog:Loc albl_angle_value}" IsChecked="{Binding Angle, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:ThreeDimensionalRotationViewModel+AngleEnum.AngleValue}}" />
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         Text="{Binding Degrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <RadioButton Grid.Row="1"
                             Grid.Column="0"
                             Grid.ColumnSpan="2"
                             Content="{dialog:Loc albl_manually_specify_start_and_end_direction}"
                             IsChecked="{Binding Angle, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:ThreeDimensionalRotationViewModel+AngleEnum.ManualSelect}}" />
                <CheckBox Grid.Row="2"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="16,5,5,5"
                          Content="{dialog:Loc albl_end_direction_is_normal_of_plane}"
                          IsChecked="{Binding TargetDirectionIsNormalOfPlane, Mode=TwoWay}"
                          IsEnabled="{Binding Angle, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:ThreeDimensionalRotationViewModel+AngleEnum.ManualSelect}}" />
            </Grid>
        </GroupBox>

        <Button Width="100" Height="30" Content="{dialog:Loc albl_action}" Command="{Binding ThreeDimensionalRotationCommand}" />
    </StackPanel>
</Page>
