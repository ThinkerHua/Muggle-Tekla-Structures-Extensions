<Page x:Class="Muggle.TsExtensions.MainWindow.Views.ExtendBeam"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Muggle.TsExtensions.MainWindow.Views"
      xmlns:vm="clr-namespace:Muggle.TsExtensions.MainWindow.ViewModels"
      xmlns:vc="clr-namespace:Muggle.TsExtensions.Common.WPF.ValueConverters;assembly=Common.WPF"
      xmlns:tsdlg="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
      Title="{tsdlg:Loc albl_extend_beam}"
      mc:Ignorable="d"
      d:Background="AliceBlue"
      d:DataContext="{d:DesignInstance Type=vm:ExtendBeamViewModel}">

    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="Element" TargetType="FrameworkElement">
                <Setter Property="Margin" Value="{StaticResource UniformMargin}" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource Element}">
                <Setter Property="Template" Value="{StaticResource ButtonStyle1}" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Width" Value="150" />
            </Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Element}" />
            <Style TargetType="TextBox" BasedOn="{StaticResource Element}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="RadioButton" BasedOn="{StaticResource Element}" />
            <Style TargetType="Separator" BasedOn="{StaticResource Element}" />
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{tsdlg:Loc albl_tolerance}" />
            <TextBox Grid.Column="1" Text="{Binding Tolerance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Separator />

        <TextBlock Text="{tsdlg:Loc albl_position_in_relation_to_beam}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{tsdlg:Loc albl_steel_beam}" />
            <RadioButton Grid.Row="1"
                         Grid.Column="0"
                         Content="{tsdlg:Loc albl_middle_plane}"
                         GroupName="SteelBeam"
                         IsChecked="{Binding ExtendToSteelBeamPosition, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ExtendBeamViewModel+ExtendPosition.MiddlePlane}}" />
            <RadioButton Grid.Row="2"
                         Grid.Column="0"
                         Content="{tsdlg:Loc albl_bounding_box_plane}"
                         GroupName="SteelBeam"
                         IsChecked="{Binding ExtendToSteelBeamPosition, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ExtendBeamViewModel+ExtendPosition.BoundingBoxPlane}}" />
            <RadioButton Grid.Row="3"
                         Grid.Column="0"
                         Content="{tsdlg:Loc albl_surface}"
                         GroupName="SteelBeam"
                         IsChecked="{Binding ExtendToSteelBeamPosition, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ExtendBeamViewModel+ExtendPosition.Surface}}" />

            <TextBlock Grid.Row="0" Grid.Column="1" Text="{tsdlg:Loc albl_concrete_beam}" />
            <RadioButton Grid.Row="1"
                         Grid.Column="1"
                         Content="{tsdlg:Loc albl_middle_plane}"
                         GroupName="ConcreteBeam"
                         IsChecked="{Binding ExtendToConcreteBeamPosition, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ExtendBeamViewModel+ExtendPosition.MiddlePlane}}" />
            <RadioButton Grid.Row="2"
                         Grid.Column="1"
                         Content="{tsdlg:Loc albl_bounding_box_plane}"
                         GroupName="ConcreteBeam"
                         IsChecked="{Binding ExtendToConcreteBeamPosition, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ExtendBeamViewModel+ExtendPosition.BoundingBoxPlane}}" />
            <RadioButton Grid.Row="3"
                         Grid.Column="1"
                         Content="{tsdlg:Loc albl_surface}"
                         GroupName="ConcreteBeam"
                         IsChecked="{Binding ExtendToConcreteBeamPosition, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ExtendBeamViewModel+ExtendPosition.Surface}}" />

        </Grid>
        <Separator />

        <TextBlock Text="{tsdlg:Loc albl_position_in_relation_to_column}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{tsdlg:Loc albl_steel_column}" />
            <RadioButton Grid.Row="1"
                         Grid.Column="0"
                         Content="{tsdlg:Loc albl_middle_plane}"
                         GroupName="SteelColumn"
                         IsChecked="{Binding ExtendToSteelColumnPosition, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ExtendBeamViewModel+ExtendPosition.MiddlePlane}}" />
            <RadioButton Grid.Row="2"
                         Grid.Column="0"
                         Content="{tsdlg:Loc albl_bounding_box_plane}"
                         GroupName="SteelColumn"
                         IsChecked="{Binding ExtendToSteelColumnPosition, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ExtendBeamViewModel+ExtendPosition.BoundingBoxPlane}}" />
            <RadioButton Grid.Row="3"
                         Grid.Column="0"
                         Content="{tsdlg:Loc albl_surface}"
                         GroupName="SteelColumn"
                         IsChecked="{Binding ExtendToSteelColumnPosition, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ExtendBeamViewModel+ExtendPosition.Surface}}" />

            <TextBlock Grid.Row="0" Grid.Column="1" Text="{tsdlg:Loc albl_concrete_column}" />
            <RadioButton Grid.Row="1"
                         Grid.Column="1"
                         Content="{tsdlg:Loc albl_middle_plane}"
                         GroupName="ConcreteColumn"
                         IsChecked="{Binding ExtendToConcreteColumnPosition, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ExtendBeamViewModel+ExtendPosition.MiddlePlane}}" />
            <RadioButton Grid.Row="2"
                         Grid.Column="1"
                         Content="{tsdlg:Loc albl_bounding_box_plane}"
                         GroupName="ConcreteColumn"
                         IsChecked="{Binding ExtendToConcreteColumnPosition, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ExtendBeamViewModel+ExtendPosition.BoundingBoxPlane}}" />
            <RadioButton Grid.Row="3"
                         Grid.Column="1"
                         Content="{tsdlg:Loc albl_surface}"
                         GroupName="ConcreteColumn"
                         IsChecked="{Binding ExtendToConcreteColumnPosition, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ExtendBeamViewModel+ExtendPosition.Surface}}" />
        </Grid>
        <Button Content="{tsdlg:Loc albl_extend_beam}" Command="{Binding ExtendCommand}" />
    </StackPanel>
</Page>