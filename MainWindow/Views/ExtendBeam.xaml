<Page x:Class="Muggle.TsExtensions.MainWindow.Views.ExtendBeam"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Muggle.TsExtensions.MainWindow.Views"
      xmlns:vm="clr-namespace:Muggle.TsExtensions.MainWindow.ViewModels"
      xmlns:vc="clr-namespace:Muggle.TsExtensions.Common.WPF.ValueConverters;assembly=Common.WPF"
      xmlns:dialog="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
      Title="{dialog:Loc albl_extend_beam}"
      mc:Ignorable="d"
      d:Background="AliceBlue"
      d:DataContext="{d:DesignInstance Type=vm:ExtendBeamViewModel}">

    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="element" TargetType="FrameworkElement">
                <Setter Property="Margin" Value="{StaticResource UniformMargin}" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource element}">
                <Setter Property="Template" Value="{StaticResource ButtonStyle1}" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Width" Value="150" />
            </Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource element}" />
            <Style TargetType="TextBox" BasedOn="{StaticResource element}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="RadioButton" BasedOn="{StaticResource element}" />
            <Style TargetType="Separator" BasedOn="{StaticResource element}" />
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{dialog:Loc albl_tolerance}" />
            <TextBox Grid.Column="1" Text="{Binding Tolerance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Separator />

        <TextBlock Text="{dialog:Loc albl_position_in_relation_to_column}" />
        <RadioButton Content="{dialog:Loc albl_middle_plane}" IsChecked="{Binding ExtendToColumnPosition, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:ExtendBeamViewModel+ExtendToColumnPositionEnum.MiddlePlane}}" />
        <RadioButton Content="{dialog:Loc albl_bounding_box_plane}" IsChecked="{Binding ExtendToColumnPosition, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:ExtendBeamViewModel+ExtendToColumnPositionEnum.BoundingBoxPlane}}" />
        <RadioButton Content="{dialog:Loc albl_surface}" IsChecked="{Binding ExtendToColumnPosition, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:ExtendBeamViewModel+ExtendToColumnPositionEnum.Surface}}" />

        <Button Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Content="{dialog:Loc albl_extend_beam}"
                Command="{Binding ExtendCommand}" />
    </StackPanel>
</Page>
