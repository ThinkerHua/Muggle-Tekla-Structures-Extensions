<Page x:Class="Muggle.TsExtensions.MainWindow.Views.ProjectOntoPlane"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Muggle.TsExtensions.MainWindow.Views"
      xmlns:vm="clr-namespace:Muggle.TsExtensions.MainWindow.ViewModels"
      xmlns:tsdlg="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
      Title="{tsdlg:Loc albl_project_beam_onto_plane}"
      mc:Ignorable="d"
      d:DesignHeight="300"
      d:DesignWidth="300"
      d:DataContext="{d:DesignInstance Type=vm:ProjectOntoPlaneViewModel}"
      d:Background="AliceBlue">

    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="Element" TargetType="FrameworkElement">
                <Setter Property="Margin" Value="{StaticResource UniformMargin}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Element}" />
            <Style TargetType="TextBox" BasedOn="{StaticResource Element}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Height" Value="20" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource Element}">
                <Setter Property="Template" Value="{StaticResource ButtonStyle1}" />
                <Setter Property="Padding" Value="4,2,4,2" />
                <Setter Property="Height" Value="30" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style TargetType="RadioButton" BasedOn="{StaticResource Element}">
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="Separator" BasedOn="{StaticResource Element}" />
            <Style TargetType="CheckBox" BasedOn="{StaticResource Element}">
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel>
        <TextBlock Text="{tsdlg:Loc albl_plane}" />

        <RadioButton GroupName="WayToGetPlane" Content="{tsdlg:Loc albl_pick_face}" IsChecked="{Binding GetPlaneType, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ProjectOntoPlaneViewModel+WayToGetPlane.PickFace}, Mode=TwoWay}" />

        <RadioButton GroupName="WayToGetPlane" Content="{tsdlg:Loc albl_pick_3_points}" IsChecked="{Binding GetPlaneType, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ProjectOntoPlaneViewModel+WayToGetPlane.Pick3Points}, Mode=TwoWay}" />

        <Separator />

        <TextBlock Text="{tsdlg:Loc albl_projection_direction}" />

        <RadioButton GroupName="ProjectionDirection" Content="{tsdlg:Loc albl_perpendicular}" IsChecked="{Binding DirectionType, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ProjectOntoPlaneViewModel+ProjectionDirection.Perpendicular}, Mode=TwoWay}" />

        <RadioButton GroupName="ProjectionDirection" Content="{tsdlg:Loc albl_global_Z}" IsChecked="{Binding DirectionType, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ProjectOntoPlaneViewModel+ProjectionDirection.GlobalZ}, Mode=TwoWay}" />
        <CheckBox Margin="24,4,4,4"
                  Visibility="Collapsed"
                  Content="{tsdlg:Loc albl_make_solid_under_plane}"
                  IsChecked="{Binding MakeSolidUnderPlane}"
                  IsEnabled="{Binding DirectionType, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ProjectOntoPlaneViewModel+ProjectionDirection.GlobalZ}}" />

        <RadioButton GroupName="ProjectionDirection" Content="{tsdlg:Loc albl_manually_specify}" IsChecked="{Binding DirectionType, Converter={StaticResource Equality}, ConverterParameter={x:Static vm:ProjectOntoPlaneViewModel+ProjectionDirection.Manually}, Mode=TwoWay}" />

        <Button Content="{tsdlg:Loc albl_project_onto_plane}" Command="{Binding ProjectBeamOntoPlaneCommand}" />

    </StackPanel>
</Page>