<Page x:Class="Muggle.TsExtensions.MainWindow.Views.SelectBooleans"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Muggle.TsExtensions.MainWindow.Views"
      xmlns:vm="clr-namespace:Muggle.TsExtensions.MainWindow.ViewModels"
      xmlns:dialog="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
      Title="{dialog:Loc albl_select_booleans}"
      mc:Ignorable="d"
      d:DesignHeight="300"
      d:DesignWidth="300"
      d:Background="AliceBlue"
      d:DataContext="{d:DesignInstance Type=vm:SelectBooleansViewModel}">

    <Page.Resources>
        <ResourceDictionary>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="2" />
                <Setter Property="Height" Value="20" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="Template" Value="{StaticResource ButtonStyle1}" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="Height" Value="30" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Width="160" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top">
        <CheckBox Content="{dialog:Loc albl_boolean_add}" IsChecked="{Binding MatchBooleanAdd, Mode=TwoWay}" />
        <CheckBox Content="{dialog:Loc albl_boolean_cut}" IsChecked="{Binding MatchBooleanCut, Mode=TwoWay}" />
        <CheckBox Content="{dialog:Loc albl_weld_prepare}" IsChecked="{Binding MatchWeldPrep, Mode=TwoWay}" />
        <CheckBox Content="{dialog:Loc albl_cut_plane}" IsChecked="{Binding MatchCutPlane, Mode=TwoWay}" />
        <CheckBox Content="{dialog:Loc albl_edge_chamfer}" IsChecked="{Binding MatchEdgeChamfer, Mode=TwoWay}" />
        <CheckBox Content="{dialog:Loc albl_fitting}" IsChecked="{Binding MatchFitting, Mode=TwoWay}" />
        <Button Content="{dialog:Loc albl_select}" Command="{Binding SelectBooleansCommand}" />
    </StackPanel>
</Page>
