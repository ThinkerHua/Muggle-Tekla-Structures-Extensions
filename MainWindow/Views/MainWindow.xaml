<tsdlg:ApplicationWindowBase x:Class="Muggle.TsExtensions.MainWindow.Views.MainWindow"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             xmlns:local="clr-namespace:Muggle.TsExtensions.MainWindow.Views"
                             xmlns:tsdlg="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
                             xmlns:vm="clr-namespace:Muggle.TsExtensions.MainWindow.ViewModels"
                             xmlns:svs="clr-namespace:Muggle.TsExtensions.MainWindow.Services"
                             Title="{tsdlg:Loc albl_window_title}"
                             Width="520"
                             Height="460"
                             MinWidth="340"
                             MinHeight="300"
                             ShowInTaskbar="True"
                             WindowStartupLocation="CenterScreen"
                             Background="#FFFFFFFF"
                             Icon="/Assets/logo.ico"
                             mc:Ignorable="d"
                             d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}">

    <tsdlg:ApplicationWindowBase.Resources>
        <ResourceDictionary>
            <Style TargetType="Expander" BasedOn="{StaticResource ExpanderStyle1}">
                <Setter Property="Margin" Value="4,4,4,0" />
            </Style>
            <Style TargetType="RadioButton" BasedOn="{StaticResource MenuButtonStyle1}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>
        </ResourceDictionary>
    </tsdlg:ApplicationWindowBase.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" MinWidth="128" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="1*" MinWidth="128" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <Expander Header="{tsdlg:Loc albl_modeling_tools}" IsExpanded="True">
                    <StackPanel>
                        <RadioButton IsChecked="True" Content="{tsdlg:Loc albl_normal_tools}" GroupName="menuBtn" Command="{Binding NavigateCommand}">
                            <RadioButton.CommandParameter>
                                <local:NormalTools />
                            </RadioButton.CommandParameter>
                        </RadioButton>
                        <RadioButton Content="{tsdlg:Loc albl_select_booleans}" GroupName="menuBtn" Command="{Binding NavigateCommand}">
                            <RadioButton.CommandParameter>
                                <local:SelectBooleans />
                            </RadioButton.CommandParameter>
                        </RadioButton>
                        <RadioButton Content="{tsdlg:Loc albl_3d_rotation}" GroupName="menuBtn" Command="{Binding NavigateCommand}">
                            <RadioButton.CommandParameter>
                                <local:ThreeDimensionalRotation />
                            </RadioButton.CommandParameter>
                        </RadioButton>
                        <RadioButton Content="{tsdlg:Loc albl_move_to_elevation}" GroupName="menuBtn" Command="{Binding NavigateCommand}">
                            <RadioButton.CommandParameter>
                                <local:MoveToElevation />
                            </RadioButton.CommandParameter>
                        </RadioButton>
                        <RadioButton Content="{tsdlg:Loc albl_filter_connection_status}" GroupName="menuBtn" Command="{Binding NavigateCommand}">
                            <RadioButton.CommandParameter>
                                <local:ConnectionStatusFilter />
                            </RadioButton.CommandParameter>
                        </RadioButton>
                        <RadioButton Content="{tsdlg:Loc albl_locate_to_precise_position}" GroupName="menuBtn" Command="{Binding NavigateCommand}">
                            <RadioButton.CommandParameter>
                                <local:LocateToPrecisePosition />
                            </RadioButton.CommandParameter>
                        </RadioButton>
                        <RadioButton Content="{tsdlg:Loc albl_extend_beam}" GroupName="menuBtn" Command="{Binding NavigateCommand}">
                            <RadioButton.CommandParameter>
                                <local:ExtendBeam />
                            </RadioButton.CommandParameter>
                        </RadioButton>
                        <RadioButton Content="{tsdlg:Loc albl_project_onto_plane}" GroupName="menuBtn" Command="{Binding NavigateCommand}">
                            <RadioButton.CommandParameter>
                                <local:ProjectOntoPlane />
                            </RadioButton.CommandParameter>
                        </RadioButton>
                        <RadioButton Content="{tsdlg:Loc albl_create_evenly_distributed_beams}" GroupName="menuBtn" Command="{Binding NavigateCommand}">
                            <RadioButton.CommandParameter>
                                <local:CreateEvenlyDistributedBeams />
                            </RadioButton.CommandParameter>
                        </RadioButton>
                    </StackPanel>
                </Expander>
                <RadioButton Margin="4,8,4,0" Content="{tsdlg:Loc albl_plugins}" GroupName="menuBtn" Command="{Binding NavigateCommand}">
                    <RadioButton.CommandParameter>
                        <local:Plugins />
                    </RadioButton.CommandParameter>
                </RadioButton>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Frame x:Name="Frame" Grid.Row="0" NavigationUIVisibility="Hidden" Source="NormalTools.xaml" />
            <TextBlock Grid.Row="1" DockPanel.Dock="Bottom" Margin="{StaticResource UniformMargin}" TextWrapping="Wrap">
                <Run>Author: Huang YongXing -</Run>
                <Hyperlink NavigateUri="mailto:thinkerhua@hotmail.com">thinkerhua@hotmail.com</Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</tsdlg:ApplicationWindowBase>
