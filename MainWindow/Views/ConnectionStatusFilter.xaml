<Page x:Class="Muggle.TsExtensions.MainWindow.Views.ConnectionStatusFilter"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Muggle.TsExtensions.MainWindow.Views"
      xmlns:vm="clr-namespace:Muggle.TsExtensions.MainWindow.ViewModels"
      Title="ConnectionStatusFilter"
      d:DesignHeight="200"
      d:DesignWidth="300"
      d:Background="AliceBlue"
      d:DataContext="{d:DesignInstance Type={x:Type vm:ConnectionStatusFilterViewModel}}"
      mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="element" TargetType="FrameworkElement">
                <Setter Property="Margin" Value="{StaticResource UniformMargin}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource element}">
                <Setter Property="Height" Value="20" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource element}">
                <Setter Property="Template" Value="{StaticResource ButtonStyle1}" />
                <Setter Property="Height" Value="30" />
            </Style>
            <Style TargetType="RadioButton" BasedOn="{StaticResource element}">
                <Setter Property="Height" Value="20" />
            </Style>
            <Style TargetType="Separator" BasedOn="{StaticResource element}" />
            <Style TargetType="ToggleButton" BasedOn="{StaticResource element}">
                <Setter Property="Template" Value="{StaticResource ToggleButtonTemplate1}" />
                <Setter Property="Height" Value="20" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <CheckBox Grid.Row="0" Content="Green symbol" IsChecked="{Binding FilterGreenSymbol, Mode=TwoWay}" />
        <CheckBox Grid.Row="1" Content="Yellow symbol" IsChecked="{Binding FilterYellowSymbol, Mode=TwoWay}" />
        <CheckBox Grid.Row="2" Content="Red symbol" IsChecked="{Binding FilterRedSymbol, Mode=TwoWay}" />
        <CheckBox Grid.Row="3" Content="Not pass design check" IsChecked="{Binding FilterNotPassDesignCheck, Mode=TwoWay}" />
        <Separator Grid.Row="4" />
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButton Grid.Column="0" IsChecked="{Binding ManualSelection, Mode=TwoWay}" Content="Manual selection" />
            <RadioButton Grid.Column="1" IsChecked="{Binding ManualSelection, Mode=TwoWay, Converter={StaticResource boolInverter}}" Content="All model objects" />
        </Grid>
        <Button Grid.Row="6" Content="Apply filter" Command="{Binding ApplyFilterCommand}" />

    </Grid>
</Page>
