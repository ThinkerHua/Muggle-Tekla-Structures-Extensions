                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Canvas Grid.Column="0" Width="340" Height="300" HorizontalAlignment="Left">
                        <Image Canvas.Left="10" Canvas.Top="10" Stretch="None">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource FrontViewWithDimension}" />
                            </Image.Source>
                        </Image>
                        <Image Canvas.Left="36" Canvas.Top="210" Stretch="None">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource TopViewWithDimension}" />
                            </Image.Source>
                        </Image>

                        <TextBlock Canvas.Left="213" Canvas.Top="7" Text="g" />
                        <TextBlock Canvas.Left="213" Canvas.Top="190" Text="g" />
                        <TextBlock Canvas.Left="160" Canvas.Top="7" Text="l" />
                        <TextBlock Canvas.Left="160" Canvas.Top="190" Text="l" />
                        <TextBlock Canvas.Left="10" Canvas.Top="30" Text="e" />
                        <TextBlock Canvas.Left="10" Canvas.Top="150" Text="e" />
                        <TextBlock Canvas.Left="3" Canvas.Top="115" Text="m" />
                        <TextBlock Canvas.Left="265" Canvas.Top="124" Text="wx" />
                        <TextBlock Canvas.Left="146" Canvas.Top="105" Text="wy" />
                        <TextBlock Canvas.Left="152" Canvas.Top="165" Text="fx" />
                        <TextBlock Canvas.Left="152" Canvas.Top="278" Text="fx" />
                        <TextBlock Canvas.Left="282" Canvas.Top="266" Text="fy" />
                    </Canvas>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{tsdlg:Loc albl_short_beam_length}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="l" />
                        <tsuic:WpfFilterCheckBox Grid.Row="0" Grid.Column="2" AttributeName="ShortBeamLen" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ShortBeamLen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{tsdlg:Loc albl_gap}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="g" />
                        <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="2" AttributeName="Gap" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Gap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{tsdlg:Loc albl_extra_length}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="e" />
                        <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="2" AttributeName="ExtraLen" />
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ExtraLen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{tsdlg:Loc albl_more_stiffeners_distance_list}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="m" />
                        <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="2" AttributeName="MoreStifDisList" />
                        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding MoreStifDisList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    </Grid>
                </Grid>
            </TabItem>

