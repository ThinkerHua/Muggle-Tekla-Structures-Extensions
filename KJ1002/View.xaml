<tsdlg:PluginWindowBase x:Class="Muggle.TsExtensions.KJ1002.View"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:local="clr-namespace:Muggle.TsExtensions.KJ1002"
                        xmlns:tsdlg="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
                        xmlns:tsuic="clr-namespace:Tekla.Structures.Dialog.UIControls;assembly=Tekla.Structures.Dialog"
                        xmlns:uc="clr-namespace:Muggle.TsExtensions.Common.WPF.Controls;assembly=Common.WPF"
                        xmlns:tr="clr-namespace:Muggle.TsExtensions.Common.WPF.Localization;assembly=Common.WPF"
                        xmlns:vc="clr-namespace:Muggle.TsExtensions.Common.WPF.ValueConverters;assembly=Common.WPF"
                        xmlns:assets="clr-namespace:Muggle.TsExtensions.Common.WPF.Assets;assembly=Common.WPF"
                        Title="{tsdlg:Loc albl_KJ1002_title}"
                        SizeToContent="WidthAndHeight"
                        ResizeMode="NoResize"
                        UseDefaultStyle="False"
                        Background="#F3F3F7"
                        mc:Ignorable="d"
                        d:DataContext="{d:DesignInstance Type=local:ViewModel}">

    <tsdlg:PluginWindowBase.DataContext>
        <local:ViewModel />
    </tsdlg:PluginWindowBase.DataContext>

    <tsdlg:PluginWindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KJ1002;component/Assets/Backgrounds.xaml" />
                <ResourceDictionary Source="/Common.WPF;component/Controls/PresetControlGroups.xaml" />
                <ResourceDictionary Source="Assets/Backgrounds.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <vc:BoltHoleTypeToSlottedHoleXDisplayNameConverter x:Key="BoltHoleTypeToSlottedHoleXDisplayName" />
            <vc:BoltHoleTypeToSlottedHoleXIsEnabledConverter x:Key="BoltHoleTypeToSlottedHoleXIsEnabled" />
            <vc:BoltHoleTypeToSlottedHoleYIsEnabledConverter x:Key="BoltHoleTypeToSlottedHoleYIsEnabled" />
            <vc:BoltHoleTypeToRotateSlotsIsEnabledConverter x:Key="BoltHoleTypeToRotateSlotsIsEnabled" />
            <vc:BoltPlainHoleTypeToBlindHoleDepthIsEnabledConverter x:Key="BoltPlainHoleTypeToBlindHoleDepthIsEnabled" />
            <vc:ChamferTypeToXIsEnabledConverter x:Key="ChamferTypeToXIsEnabled" />
            <vc:ChamferTypeToYIsEnabledConverter x:Key="ChamferTypeToYIsEnabled" />

            <Style x:Key="Element" TargetType="FrameworkElement">
                <Setter Property="Margin" Value="2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ContainingTextBoxElement" TargetType="FrameworkElement" BasedOn="{StaticResource Element}">
                <Setter Property="Height" Value="20" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="CheckBox" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="TextBox">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="ComboBox" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfFilterCheckBox">
                <Setter Property="Margin" Value="2,2,-2,2" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfProfileCatalog" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfMaterialCatalog" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuic:WpfBoltCatalogSize" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuic:WpfBoltCatalogStandard" />
        </ResourceDictionary>
    </tsdlg:PluginWindowBase.Resources>

    <DockPanel>

        <tsuic:WpfSaveLoad DockPanel.Dock="Top" />

        <tsuic:WpfOkApplyModifyGetOnOffCancel DockPanel.Dock="Bottom"
                                              ApplyClicked="WPFOkApplyModifyGetOnOffCancel_ApplyClicked"
                                              CancelClicked="WPFOkApplyModifyGetOnOffCancel_CancelClicked"
                                              GetClicked="WPFOkApplyModifyGetOnOffCancel_GetClicked"
                                              ModifyClicked="WPFOkApplyModifyGetOnOffCancel_ModifyClicked"
                                              OkClicked="WPFOkApplyModifyGetOnOffCancel_OkClicked"
                                              OnOffClicked="WPFOkApplyModifyGetOnOffCancel_OnOffClicked" />
        <TextBlock DockPanel.Dock="Bottom" Margin="4" TextWrapping="Wrap">
            <Run>Huang YongXing -</Run>
            <Hyperlink NavigateUri="mailto:thinkerhua@hotmail.com">thinkerhua@hotmail.com</Hyperlink>
        </TextBlock>

        <TabControl>
            <TabItem Header="{tr:Translate albl_Parameters}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Canvas Grid.Column="0" Width="300" Height="300" HorizontalAlignment="Left">
                        <Image Canvas.Left="-140" Canvas.Top="-110" Stretch="None">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource TopViewWithDimension}" />
                            </Image.Source>
                            <Image.Clip>
                                <RectangleGeometry Rect="150,120,250,280" />
                            </Image.Clip>
                        </Image>

                        <TextBlock Canvas.Left="100" Canvas.Top="14" Text="l" />
                        <TextBlock Canvas.Left="74" Canvas.Top="164" Text="c" />
                        <TextBlock Canvas.Left="110" Canvas.Top="154" Text="e" />
                        <TextBlock Canvas.Left="130" Canvas.Top="174" Text="e" />
                        <TextBlock Canvas.Left="110" Canvas.Top="226" Text="o" />
                        <TextBlock Canvas.Left="130" Canvas.Top="208" Text="o" />
                        <TextBlock Canvas.Left="120" Canvas.Top="217" Text="dx" />
                    </Canvas>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{tsdlg:Loc albl_section_length}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="l" />
                        <tsuic:WpfFilterCheckBox Grid.Row="0" Grid.Column="2" AttributeName="SectionLength" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SectionLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{tsdlg:Loc albl_clearance}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="c" />
                        <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="2" AttributeName="Clearance" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Clearance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{tsdlg:Loc albl_extended_distance}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="e" />
                        <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="2" AttributeName="ExtendedDistance" />
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ExtendedDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{tsdlg:Loc albl_bolt_offset_x}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="o" />
                        <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="2" AttributeName="BoltOffsetX" />
                        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding BoltOffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{tsdlg:Loc albl_upper_splices_creation}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="2" AttributeName="CreateUpperSplices" />
                        <CheckBox Grid.Row="4" Grid.Column="3" IsChecked="{Binding CreateUpperSplices, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{tr:Translate albl_Parts}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Id}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Name}" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="4"
                               Grid.ColumnSpan="5"
                               HorizontalAlignment="Center"
                               Text="{tr:Translate albl_Part_Header_ProfileOrSize}" />
                    <TextBlock Grid.Row="0" Grid.Column="11" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Material}" />
                    <TextBlock Grid.Row="0" Grid.Column="14" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Finish}" />
                    <TextBlock Grid.Row="0" Grid.Column="16" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Class}" />
                    <TextBlock Grid.Row="0" Grid.Column="18" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_NumberingSeries_Prefix}" />
                    <TextBlock Grid.Row="0" Grid.Column="20" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_NumberingSeries_StartNumber}" />

                    <TextBlock Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_brace}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" AttributeName="PTBraceName" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PartBraceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="3" AttributeName="PTBracePRF" />
                    <TextBox Grid.Row="1"
                             Grid.RowSpan="2"
                             Grid.Column="4"
                             Grid.ColumnSpan="5"
                             Text="{Binding PartBraceProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfProfileCatalog Grid.Row="1"
                                             Grid.RowSpan="2"
                                             Grid.Column="9"
                                             Tag="PartBraceProfile"
                                             SelectClicked="WpfProfileCatalog_SelectClicked"
                                             SelectionDone="WpfProfileCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="10" AttributeName="PTBraceMATL" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PartBraceMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="1"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PartBraceMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="13" AttributeName="PTBraceFNSH" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PartBraceFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="15" AttributeName="PTBraceCLS" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PartBraceClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="17" AttributeName="PTBracePTP" />
                    <TextBox Grid.Row="1" Grid.Column="18" Text="{Binding PartBracePartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="19" AttributeName="PTBracePTN" />
                    <TextBox Grid.Row="1" Grid.Column="20" Text="{Binding PartBracePartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="17" AttributeName="PTBraceASMP" />
                    <TextBox Grid.Row="2" Grid.Column="18" Text="{Binding PartBraceAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="19" AttributeName="PTBraceASMN" />
                    <TextBox Grid.Row="2" Grid.Column="20" Text="{Binding PartBraceAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_stiffener}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLStiffenerName" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateStiffenerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLStiffenerT" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateStiffenerThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLStiffenerMATL" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateStiffenerMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="3"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateStiffenerMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLStiffenerFNSH" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateStiffenerFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLStiffenerCLS" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateStiffenerClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="17" AttributeName="PLStiffenerPTP" />
                    <TextBox Grid.Row="3" Grid.Column="18" Text="{Binding PlateStiffenerPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="19" AttributeName="PLStiffenerPTN" />
                    <TextBox Grid.Row="3" Grid.Column="20" Text="{Binding PlateStiffenerPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="17" AttributeName="PLStiffenerASMP" />
                    <TextBox Grid.Row="4" Grid.Column="18" Text="{Binding PlateStiffenerAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="19" AttributeName="PLStiffenerASMN" />
                    <TextBox Grid.Row="4" Grid.Column="20" Text="{Binding PlateStiffenerAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_gusset}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLGussetName" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateGussetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLGussetT" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateGussetThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLGussetMATL" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateGussetMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="5"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateGussetMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLGussetFNSH" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateGussetFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLGussetCLS" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateGussetClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="17" AttributeName="PLGussetPTP" />
                    <TextBox Grid.Row="5" Grid.Column="18" Text="{Binding PlateGussetPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="19" AttributeName="PLGussetPTN" />
                    <TextBox Grid.Row="5" Grid.Column="20" Text="{Binding PlateGussetPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="17" AttributeName="PLGussetASMP" />
                    <TextBox Grid.Row="6" Grid.Column="18" Text="{Binding PlateGussetAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="19" AttributeName="PLGussetASMN" />
                    <TextBox Grid.Row="6" Grid.Column="20" Text="{Binding PlateGussetAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                </Grid>
            </TabItem>

            <TabItem Header="{tr:Translate albl_BoltArray}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_Size}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="0" Grid.Column="1" AttributeName="B1SIZE" />
                    <tsuic:WpfBoltCatalogSize Grid.Row="0" Grid.Column="2" SelectedItem="{Binding Bolt1Size, Mode=TwoWay}" ItemsSource="{Binding Path=BoltSizes, ElementName=Bolt1StdCatalog}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_Standard}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="1" AttributeName="B1STD" />
                    <tsuic:WpfBoltCatalogStandard x:Name="Bolt1StdCatalog" Grid.Row="1" Grid.Column="2" SelectedItem="{Binding Bolt1Standard, Mode=TwoWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_BoltType}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="1" AttributeName="B1TYPE" />
                    <ComboBox Grid.Row="2" Grid.Column="2" SelectedIndex="{Binding Bolt1Type, Mode=TwoWay}" ItemsSource="{x:Static assets:BoltSymbols.BoltTypeSet}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_ThreadInMaterial}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="1" AttributeName="B1THRD" />
                    <ComboBox Grid.Row="3" Grid.Column="2" SelectedIndex="{Binding Bolt1ThreadInMaterial, Mode=TwoWay}" ItemsSource="{x:Static assets:BoltSymbols.BoltThreadInMaterialSet}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_CutLength}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="1" AttributeName="B1CLEN" />
                    <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Bolt1CutLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_ExtraLength}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="1" AttributeName="B1XLEN" />
                    <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding Bolt1ExtraLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_Tolerance}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="1" AttributeName="B1TOL" />
                    <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding Bolt1Tolerance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_PlainHoleType}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.Column="1" AttributeName="B1PLAIN" />
                    <ComboBox Grid.Row="7" Grid.Column="2" SelectedIndex="{Binding Bolt1PlainType, Mode=TwoWay}" ItemsSource="{x:Static assets:BoltSymbols.BoltPlainHoleTypeSet}" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_HoleDepth}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="8" Grid.Column="1" AttributeName="B1DEPTH" IsEnabled="{Binding Bolt1PlainType, Mode=OneWay, Converter={StaticResource BoltPlainHoleTypeToBlindHoleDepthIsEnabled}}" />
                    <TextBox Grid.Row="8" Grid.Column="2" Text="{Binding Bolt1BlindHoleDepth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Bolt1PlainType, Mode=OneWay, Converter={StaticResource BoltPlainHoleTypeToBlindHoleDepthIsEnabled}}" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_SpecialHoleType}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="9" Grid.Column="1" AttributeName="B1HOLTY" />
                    <ComboBox Grid.Row="9" Grid.Column="2" SelectedIndex="{Binding Bolt1HoleType, Mode=TwoWay}" ItemsSource="{x:Static assets:BoltSymbols.BoltSpecialHoleTypeSet}" />

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding Bolt1HoleType, Mode=OneWay, Converter={StaticResource BoltHoleTypeToSlottedHoleXDisplayName}}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="10" Grid.Column="1" AttributeName="B1SLOTX" IsEnabled="{Binding Bolt1HoleType, Mode=OneWay, Converter={StaticResource BoltHoleTypeToSlottedHoleXIsEnabled}}" />
                    <TextBox Grid.Row="10" Grid.Column="2" Text="{Binding Bolt1SlottedHoleX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Bolt1HoleType, Mode=OneWay, Converter={StaticResource BoltHoleTypeToSlottedHoleXIsEnabled}}" />

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_SlottedHoleY}" />
