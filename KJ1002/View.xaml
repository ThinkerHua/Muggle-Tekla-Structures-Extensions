                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="33" AttributeName="W2LENA" />
                    <TextBox Grid.Row="3" Grid.Column="34" Text="{Binding Weld2LengthAbove, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="33" AttributeName="W2LENB" />
                    <TextBox Grid.Row="4" Grid.Column="34" Text="{Binding Weld2LengthBelow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="35" AttributeName="W2PITA" />
                    <TextBox Grid.Row="3" Grid.Column="36" Text="{Binding Weld2PitchAbove, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="35" AttributeName="W2PITB" />
                    <TextBox Grid.Row="4" Grid.Column="36" Text="{Binding Weld2PitchBelow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="37" AttributeName="W2TEXT" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="38" Text="{Binding Weld2ReferenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Canvas Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="35" Height="190">
                        <Image Canvas.Left="10" Canvas.Top="10" Stretch="None">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource GussetTopViewWithWeldDimension}" />
                            </Image.Source>
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                            </Image.RenderTransform>
                        </Image>
                        <Image Canvas.Left="200" Canvas.Top="47" Stretch="None">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource GussetFrontViewWithWeldDimension}" />
                            </Image.Source>
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                            </Image.RenderTransform>
                        </Image>

                        <TextBlock Canvas.Left="272" Canvas.Top="30" Text="1" />
                        <TextBlock Canvas.Left="86" Canvas.Top="44" Text="2" />
                        <TextBlock Canvas.Left="80" Canvas.Top="120" Text="2" />
                    </Canvas>
                </Grid>
            </TabItem>

            <TabItem HorizontalContentAlignment="Right" Header="{tr:Translate albl_General}" Content="{StaticResource ConnectionGeneralTab}" />
        </TabControl>
    </DockPanel>
</tsdlg:PluginWindowBase>
