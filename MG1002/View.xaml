<tsdlg:PluginWindowBase x:Class="Muggle.TsExtensions.MG1002.View"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:local="clr-namespace:Muggle.TsExtensions.MG1002"
                        xmlns:tsdlg="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
                        xmlns:tsuic="clr-namespace:Tekla.Structures.Dialog.UIControls;assembly=Tekla.Structures.Dialog"
                        xmlns:uc="clr-namespace:Muggle.TsExtensions.Common.WPF.Controls;assembly=Common.WPF"
                        xmlns:tr="clr-namespace:Muggle.TsExtensions.Common.WPF.Localization;assembly=Common.WPF"
                        xmlns:assets="clr-namespace:Muggle.TsExtensions.Common.WPF.Assets;assembly=Common.WPF"
                        xmlns:vc="clr-namespace:Muggle.TsExtensions.Common.WPF.ValueConverters;assembly=Common.WPF"
                        Title="{tsdlg:Loc albl_MG1002_title}"
                        ResizeMode="NoResize"
                        SizeToContent="WidthAndHeight"
                        UseDefaultStyle="False"
                        Background="#F3F3F7"
                        mc:Ignorable="d">

    <tsdlg:PluginWindowBase.DataContext>
        <local:ViewModel />
    </tsdlg:PluginWindowBase.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Common.WPF;component/DataTemplates/SymbolDataTemplate.xaml" />
                <ResourceDictionary Source="/Common.WPF;component/Controls/PresetControlGroups.xaml" />
                <ResourceDictionary Source="Assets/Backgrounds.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <vc:BoltHoleTypeToSlottedHoleXDisplayNameConverter x:Key="BoltHoleTypeToSlottedHoleXDisplayName" />
            <vc:BoltHoleTypeToSlottedHoleXIsEnabledConverter x:Key="BoltHoleTypeToSlottedHoleXIsEnabled" />
            <vc:BoltHoleTypeToSlottedHoleYIsEnabledConverter x:Key="BoltHoleTypeToSlottedHoleYIsEnabled" />
            <vc:BoltHoleTypeToRotateSlotsIsEnabledConverter x:Key="BoltHoleTypeToRotateSlotsIsEnabled" />
            <vc:BoltPlainHoleTypeToBlindHoleDepthIsEnabledConverter x:Key="BoltPlainHoleTypeToBlindHoleDepthIsEnabled" />
            <vc:ChamferTypeToXIsEnabledConverter x:Key="ChamferTypeToXIsEnabled" />
            <vc:ChamferTypeToYIsEnabledConverter x:Key="ChamferTypeToYIsEnabled" />

            <Style x:Key="Element" TargetType="FrameworkElement">
                <Setter Property="Margin" Value="2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ContainingTextBoxElement" TargetType="FrameworkElement" BasedOn="{StaticResource Element}">
                <Setter Property="Height" Value="20" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="CheckBox" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="TextBox">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="ComboBox" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfFilterCheckBox">
                <Setter Property="Margin" Value="2,2,-2,2" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfProfileCatalog" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfMaterialCatalog" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuic:WpfBoltCatalogSize" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuic:WpfBoltCatalogStandard" />

            <DataTemplate x:Key="StifKindDataTemplate" DataType="DrawingImage">
                <Image Width="30" Height="30" Source="{Binding}" />
            </DataTemplate>

            <x:Array x:Key="StifKindSet" Type="DrawingImage">
                <DrawingImage Drawing="{StaticResource StiffenerKind1}" />
                <DrawingImage Drawing="{StaticResource StiffenerKind2}" />
            </x:Array>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <tsuic:WpfSaveLoad DockPanel.Dock="Top" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
        <tsuic:WpfOkApplyModifyGetOnOffCancel DockPanel.Dock="Bottom"
                                              ApplyClicked="WPFOkApplyModifyGetOnOffCancel_ApplyClicked"
                                              CancelClicked="WPFOkApplyModifyGetOnOffCancel_CancelClicked"
                                              GetClicked="WPFOkApplyModifyGetOnOffCancel_GetClicked"
                                              ModifyClicked="WPFOkApplyModifyGetOnOffCancel_ModifyClicked"
                                              OkClicked="WPFOkApplyModifyGetOnOffCancel_OkClicked"
                                              OnOffClicked="WPFOkApplyModifyGetOnOffCancel_OnOffClicked" />
        <TextBlock DockPanel.Dock="Bottom" Margin="4" TextWrapping="Wrap">
            <Run>Huang YongXing -</Run>
            <Hyperlink NavigateUri="mailto:thinkerhua@hotmail.com">thinkerhua@hotmail.com</Hyperlink>
        </TextBlock>

        <TabControl>

            <TabItem Header="{tr:Translate albl_Parameters}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Canvas Grid.Column="0" Width="270" Height="330" HorizontalAlignment="Left">
                        <Image Canvas.Left="10" Canvas.Top="10" Stretch="None">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource FrontViewWidthDimension}" />
                            </Image.Source>
                        </Image>
                        <Image Canvas.Left="36.8" Canvas.Top="200" Height="120" Stretch="Uniform">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource EndPlateViewWithDimension}" />
                            </Image.Source>
                        </Image>

                        <TextBlock Canvas.Left="50" Canvas.Top="106" Text="d1" />
                        <TextBlock Canvas.Left="195" Canvas.Top="106" Text="d1" />
                        <TextBlock Canvas.Left="94" Canvas.Top="48" Text="p1" />
                        <TextBlock Canvas.Left="150" Canvas.Top="38" Text="p2" />
                        <TextBlock Canvas.Left="162" Canvas.Top="190" Text="d2" />
                        <TextBlock Canvas.Left="58" Canvas.Top="304" Text="o" />
                        <TextBlock Canvas.Left="228" Canvas.Top="306" Text="dx" />
                        <TextBlock Canvas.Left="24" Canvas.Top="248" Text="dy" />
                    </Canvas>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{tsdlg:Loc albl_distance_between_web_seam_and_flange_seam}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="d1" />
                        <tsuic:WpfFilterCheckBox Grid.Row="0" Grid.Column="2" AttributeName="DistWebFlangeSeam" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding DistWebFlangeSeam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{tsdlg:Loc albl_diagonal_plate_position_1}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="p1" />
                        <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="2" AttributeName="DiagonalPos1" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding DiagonalPos1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{tsdlg:Loc albl_diagonal_plate_position_2}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="p2" />
                        <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="2" AttributeName="DiagonalPos2" />
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding DiagonalPos2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{tsdlg:Loc albl_flange_stiffener_kind}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="2" AttributeName="FlangeStifKind" />
                        <ComboBox Grid.Row="3"
                                  Grid.Column="3"
                                  Height="36"
                                  SelectedIndex="{Binding FlangeStifKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{StaticResource StifKindSet}"
                                  ItemTemplate="{StaticResource StifKindDataTemplate}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{tsdlg:Loc albl_web_stiffener_kind}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="2" AttributeName="WebStifKind" />
                        <ComboBox Grid.Row="4"
                                  Grid.Column="3"
                                  Height="36"
                                  SelectedIndex="{Binding WebStifKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{StaticResource StifKindSet}"
                                  ItemTemplate="{StaticResource StifKindDataTemplate}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{tsdlg:Loc albl_web_stiffener_distance_list}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="d2" />
                        <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="2" AttributeName="WebStifDistList" />
                        <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding WebStifDistList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{tr:Translate albl_Parts}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Id}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Name}" />
                    <TextBlock Grid.Row="0" Grid.Column="4" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Thickness}" />
                    <TextBlock Grid.Row="0" Grid.Column="6" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Breadth}" />
                    <TextBlock Grid.Row="0" Grid.Column="8" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Height}" />
                    <TextBlock Grid.Row="0" Grid.Column="11" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Material}" />
                    <TextBlock Grid.Row="0" Grid.Column="14" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Finish}" />
                    <TextBlock Grid.Row="0" Grid.Column="16" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Class}" />
                    <TextBlock Grid.Row="0" Grid.Column="18" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_NumberingSeries_Prefix}" />
                    <TextBlock Grid.Row="0" Grid.Column="20" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_NumberingSeries_StartNumber}" />

                    <TextBlock Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_end_plate}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLEndName" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateEndName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLEndT" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateEndThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="5" AttributeName="PLEndB" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="6" Text="{Binding PlateEndBreadth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="7" AttributeName="PLEndH" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="8" Text="{Binding PlateEndHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLEndMATL" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateEndMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="1"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateEndMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLEndFNSH" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateEndFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLEndCLS" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateEndClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="17" AttributeName="PLEndPTP" />
                    <TextBox Grid.Row="1" Grid.Column="18" Text="{Binding PlateEndPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="19" AttributeName="PLEndPTN" />
                    <TextBox Grid.Row="1" Grid.Column="20" Text="{Binding PlateEndPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="17" AttributeName="PLEndASMP" />
                    <TextBox Grid.Row="2" Grid.Column="18" Text="{Binding PlateEndAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="19" AttributeName="PLEndASMN" />
                    <TextBox Grid.Row="2" Grid.Column="20" Text="{Binding PlateEndAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_splicing_web}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLSplicingWebName" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateSplicingWebName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLSplicingWebT" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateSplicingWebThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLSplicingWebMATL" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateSplicingWebMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="3"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateSplicingWebMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLSplicingWebFNSH" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateSplicingWebFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLSplicingWebCLS" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateSplicingWebClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="17" AttributeName="PLSplicingWebPTP" />
                    <TextBox Grid.Row="3" Grid.Column="18" Text="{Binding PlateSplicingWebPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="19" AttributeName="PLSplicingWebPTN" />
                    <TextBox Grid.Row="3" Grid.Column="20" Text="{Binding PlateSplicingWebPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="17" AttributeName="PLSplicingWebASMP" />
                    <TextBox Grid.Row="4" Grid.Column="18" Text="{Binding PlateSplicingWebAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="19" AttributeName="PLSplicingWebASMN" />
                    <TextBox Grid.Row="4" Grid.Column="20" Text="{Binding PlateSplicingWebAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_vertical_plate}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLVerticalName" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateVerticalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLVerticalT" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateVerticalThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="5" AttributeName="PLVerticalB" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="6" Text="{Binding PlateVerticalBreadth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLVerticalMATL" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateVerticalMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="5"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateVerticalMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLVerticalFNSH" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateVerticalFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLVerticalCLS" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateVerticalClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="17" AttributeName="PLVerticalPTP" />
                    <TextBox Grid.Row="5" Grid.Column="18" Text="{Binding PlateVerticalPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="19" AttributeName="PLVerticalPTN" />
                    <TextBox Grid.Row="5" Grid.Column="20" Text="{Binding PlateVerticalPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="17" AttributeName="PLVerticalASMP" />
                    <TextBox Grid.Row="6" Grid.Column="18" Text="{Binding PlateVerticalAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="19" AttributeName="PLVerticalASMN" />
                    <TextBox Grid.Row="6" Grid.Column="20" Text="{Binding PlateVerticalAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="7" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_diagonal_plate}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLDiagonalName" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateDiagonalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLDiagonalT" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateDiagonalThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="5" AttributeName="PLDiagonalB" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="6" Text="{Binding PlateDiagonalBreadth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLDiagonalMATL" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateDiagonalMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="7"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateDiagonalMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLDiagonalFNSH" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateDiagonalFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLDiagonalCLS" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateDiagonalClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.Column="17" AttributeName="PLDiagonalPTP" />
                    <TextBox Grid.Row="7" Grid.Column="18" Text="{Binding PlateDiagonalPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.Column="19" AttributeName="PLDiagonalPTN" />
                    <TextBox Grid.Row="7" Grid.Column="20" Text="{Binding PlateDiagonalPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="8" Grid.Column="17" AttributeName="PLDiagonalASMP" />
                    <TextBox Grid.Row="8" Grid.Column="18" Text="{Binding PlateDiagonalAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="8" Grid.Column="19" AttributeName="PLDiagonalASMN" />
                    <TextBox Grid.Row="8" Grid.Column="20" Text="{Binding PlateDiagonalAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="9" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_flange_stiffener}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="9" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLFlangeStifName" />
