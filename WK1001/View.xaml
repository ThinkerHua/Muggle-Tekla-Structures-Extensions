                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Text="{tr:Translate albl_Weld_Header_Id}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Text="{tr:Translate albl_Weld_Header_Prefix}" />
                    <TextBlock Grid.Row="0" Grid.Column="4" HorizontalAlignment="Center" Text="{tr:Translate albl_Weld_Header_Type}" />
                    <TextBlock Grid.Row="0" Grid.Column="6" HorizontalAlignment="Center" Text="{tr:Translate albl_Weld_Header_Size}" />
                    <TextBlock Grid.Row="0" Grid.Column="8" HorizontalAlignment="Center" Text="{tr:Translate albl_Weld_Header_AdditionalSize}" />
                    <TextBlock Grid.Row="0" Grid.Column="10" HorizontalAlignment="Center" Text="{tr:Translate albl_Weld_Header_Angle}" />
                    <TextBlock Grid.Row="0" Grid.Column="12" HorizontalAlignment="Center" Text="{tr:Translate albl_Weld_Header_Contour}" />
