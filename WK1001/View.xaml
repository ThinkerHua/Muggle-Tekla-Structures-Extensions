                    <TextBlock Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_pipe}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" AttributeName="PTPipeName" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PartPipeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="3" AttributeName="PTPipePRF" />
                    <TextBox Grid.Row="1"
                             Grid.RowSpan="2"
                             Grid.Column="4"
                             Grid.ColumnSpan="5"
                             Text="{Binding PartPipeProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfProfileCatalog Grid.Row="1"
                                             Grid.RowSpan="2"
                                             Grid.Column="9"
                                             Tag="PartPipeProfile"
                                             SelectClicked="WpfProfileCatalog_SelectClicked"
                                             SelectionDone="WpfProfileCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="10" AttributeName="PTPipeMATL" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PartPipeMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="1"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PartPipeMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="13" AttributeName="PTPipeFNSH" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PartPipeFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="15" AttributeName="PTPipeCLS" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PartPipeClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="17" AttributeName="PTPipePTP" />
                    <TextBox Grid.Row="1" Grid.Column="18" Text="{Binding PartPipePartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="19" AttributeName="PTPipePTN" />
                    <TextBox Grid.Row="1" Grid.Column="20" Text="{Binding PartPipePartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="17" AttributeName="PTPipeASMP" />
                    <TextBox Grid.Row="2" Grid.Column="18" Text="{Binding PartPipeAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="19" AttributeName="PTPipeASMN" />
                    <TextBox Grid.Row="2" Grid.Column="20" Text="{Binding PartPipeAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_top_end}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLTopEndName" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateTopEndName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLTopEndT" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateTopEndThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLTopEndMATL" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateTopEndMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="3"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateTopEndMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLTopEndFNSH" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateTopEndFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLTopEndCLS" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateTopEndClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="17" AttributeName="PLTopEndPTP" />
                    <TextBox Grid.Row="3" Grid.Column="18" Text="{Binding PlateTopEndPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="19" AttributeName="PLTopEndPTN" />
                    <TextBox Grid.Row="3" Grid.Column="20" Text="{Binding PlateTopEndPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="17" AttributeName="PLTopEndASMP" />
                    <TextBox Grid.Row="4" Grid.Column="18" Text="{Binding PlateTopEndAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="19" AttributeName="PLTopEndASMN" />
                    <TextBox Grid.Row="4" Grid.Column="20" Text="{Binding PlateTopEndAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_bottom_end}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLBotEndName" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateBotEndName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLBotEndT" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateBotEndThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="5" AttributeName="PLBotEndB" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="6" Text="{Binding PlateBotEndBreadth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLBotEndMATL" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateBotEndMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="5"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateBotEndMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLBotEndFNSH" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateBotEndFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLBotEndCLS" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateBotEndClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="17" AttributeName="PLBotEndPTP" />
                    <TextBox Grid.Row="5" Grid.Column="18" Text="{Binding PlateBotEndPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="19" AttributeName="PLBotEndPTN" />
                    <TextBox Grid.Row="5" Grid.Column="20" Text="{Binding PlateBotEndPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="17" AttributeName="PLBotEndASMP" />
                    <TextBox Grid.Row="6" Grid.Column="18" Text="{Binding PlateBotEndAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="19" AttributeName="PLBotEndASMN" />
                    <TextBox Grid.Row="6" Grid.Column="20" Text="{Binding PlateBotEndAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="7" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_stiffener}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLStifName" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateStifName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLStifT" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateStifThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLStifMATL" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateStifMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="7"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateStifMaterial"
