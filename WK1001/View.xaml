                    <tsuic:WpfFilterCheckBox Grid.Row="8" Grid.Column="19" AttributeName="PLStifASMN" />
                    <TextBox Grid.Row="8" Grid.Column="20" Text="{Binding PlateStifAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                </Grid>
            </TabItem>

            <TabItem Header="{tr:Translate albl_Welds}">
                <Grid>
                    <Grid.Resources>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource Element}">
                            <Setter Property="ItemTemplate" Value="{StaticResource SymbolDataTemplate}" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="16" />
