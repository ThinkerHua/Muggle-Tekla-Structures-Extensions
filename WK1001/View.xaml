                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateStifFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLStifCLS" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateStifClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.Column="17" AttributeName="PLStifPTP" />
                    <TextBox Grid.Row="7" Grid.Column="18" Text="{Binding PlateStifPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

