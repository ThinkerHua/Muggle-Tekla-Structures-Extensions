<tsdlg:PluginWindowBase x:Class="Muggle.TsExtensions.WK1001.View"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:local="clr-namespace:Muggle.TsExtensions.WK1001"
                        xmlns:tsdlg="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
                        xmlns:tsuic="clr-namespace:Tekla.Structures.Dialog.UIControls;assembly=Tekla.Structures.Dialog"
                        xmlns:tr="clr-namespace:Muggle.TsExtensions.Common.WPF.Localization;assembly=Common.WPF"
                        xmlns:assets="clr-namespace:Muggle.TsExtensions.Common.WPF.Assets;assembly=Common.WPF"
                        Title="{tsdlg:Loc albl_WK1001_title}"
                        SizeToContent="WidthAndHeight"
                        ResizeMode="NoResize"
                        UseDefaultStyle="False"
                        Background="#F3F3F7"
                        mc:Ignorable="d">
    <d:UserControl.DataContext>
        <local:ViewModel />
    </d:UserControl.DataContext>
    <tsdlg:PluginWindowBase.DataContext>
        <local:ViewModel />
    </tsdlg:PluginWindowBase.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Common.WPF;component/DataTemplates/SymbolDataTemplate.xaml" />
                <ResourceDictionary Source="/Common.WPF;component/Controls/PresetControlGroups.xaml" />
                <ResourceDictionary Source="Assets/Backgrounds.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Element" TargetType="FrameworkElement">
                <Setter Property="Margin" Value="2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ContainingTextBoxElement" TargetType="FrameworkElement" BasedOn="{StaticResource Element}">
                <Setter Property="Height" Value="20" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="CheckBox" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="TextBox">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="ComboBox" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfFilterCheckBox">
                <Setter Property="Margin" Value="2,2,-2,2" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfProfileCatalog" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfMaterialCatalog" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuic:WpfBoltCatalogSize" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuic:WpfBoltCatalogStandard" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <tsuic:WpfSaveLoad DockPanel.Dock="Top" />
        <tsuic:WpfOkApplyModifyGetOnOffCancel DockPanel.Dock="Bottom"
                                              ApplyClicked="WPFOkApplyModifyGetOnOffCancel_ApplyClicked"
                                              CancelClicked="WPFOkApplyModifyGetOnOffCancel_CancelClicked"
                                              GetClicked="WPFOkApplyModifyGetOnOffCancel_GetClicked"
                                              ModifyClicked="WPFOkApplyModifyGetOnOffCancel_ModifyClicked"
                                              OkClicked="WPFOkApplyModifyGetOnOffCancel_OkClicked"
                                              OnOffClicked="WPFOkApplyModifyGetOnOffCancel_OnOffClicked" />
        <TextBlock DockPanel.Dock="Bottom" Margin="4" TextWrapping="Wrap">
            <Run>Huang YongXing -</Run>
            <Hyperlink NavigateUri="mailto:thinkerhua@hotmail.com">thinkerhua@hotmail.com</Hyperlink>
        </TextBlock>

        <TabControl>

            <TabItem Header="{tr:Translate albl_Parameters}">
                <DockPanel LastChildFill="False">

                    <Canvas DockPanel.Dock="Left" Width="330" Height="260">
                        <Image Canvas.Left="20" Canvas.Top="10" Stretch="None">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource TopViewWithDimension}" />
                            </Image.Source>
                        </Image>

                        <TextBlock Canvas.Left="14" Canvas.Top="143" FontWeight="Bold" Text="A" />
                        <TextBlock Canvas.Left="314" Canvas.Top="143" FontWeight="Bold" Text="A" />
                        <TextBlock Canvas.Left="165" Canvas.Top="34" FontWeight="Bold" Text="d" />
                    </Canvas>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Canvas Width="270" Height="80">
                            <Image Canvas.Left="10" Canvas.Top="10" Stretch="None">
                                <Image.Source>
                                    <DrawingImage Drawing="{StaticResource Kind1SectionViewWithDimension}" />
                                </Image.Source>
                            </Image>
                            <TextBlock Canvas.Left="45" Canvas.Top="2" Text="te" />
                            <TextBlock Canvas.Left="42" Canvas.Top="54" Text="be" />
                        </Canvas>

                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="{tsdlg:Loc albl_section_A_kind_1}" />

                        <Canvas Width="270" Height="80">
                            <Image Canvas.Left="10" Canvas.Top="10" Stretch="None">
                                <Image.Source>
                                    <DrawingImage Drawing="{StaticResource Kind2SectionViewWithDimension}" />
                                </Image.Source>
                            </Image>
                            <TextBlock Canvas.Left="45" Canvas.Top="2" Text="te" />
                            <TextBlock Canvas.Left="32" Canvas.Top="54" Text="be" />
                        </Canvas>

                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="{tsdlg:Loc albl_section_A_kind_2}" />
                    </StackPanel>

                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{tsdlg:Loc albl_minimum_distance}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="d" />
                        <tsuic:WpfFilterCheckBox Grid.Row="0" Grid.Column="2" AttributeName="MinDis" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding MinDis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{tsdlg:Loc albl_top_extend_length}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="te" />
                        <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="2" AttributeName="ExtendLenTop" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ExtendLenTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{tsdlg:Loc albl_bottom_extend_length}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="be" />
                        <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="2" AttributeName="ExtendLenBot" />
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ExtendLenBot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="{tr:Translate albl_Parts}">
