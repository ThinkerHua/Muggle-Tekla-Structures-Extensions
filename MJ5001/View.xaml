<tsdlg:PluginWindowBase x:Class="Muggle.TsExtensions.MJ5001.View"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:local="clr-namespace:Muggle.TsExtensions.MJ5001"
                        xmlns:tsdlg="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
                        xmlns:tsuic="clr-namespace:Tekla.Structures.Dialog.UIControls;assembly=Tekla.Structures.Dialog"
                        xmlns:uc="clr-namespace:Muggle.TsExtensions.Common.WPF.Controls;assembly=Common.WPF"
                        xmlns:vc="clr-namespace:Muggle.TsExtensions.Common.WPF.ValueConverters;assembly=Common.WPF"
                        xmlns:assets="clr-namespace:Muggle.TsExtensions.Common.WPF.Assets;assembly=Common.WPF"
                        xmlns:tr="clr-namespace:Muggle.TsExtensions.Common.WPF.Localization;assembly=Common.WPF"
                        Title="{tsdlg:Loc albl_MJ5001_title}"
                        ResizeMode="NoResize"
                        SizeToContent="WidthAndHeight"
                        UseDefaultStyle="False"
                        Background="#F3F3F7"
                        mc:Ignorable="d">

    <tsdlg:PluginWindowBase.DataContext>
        <local:ViewModel />
    </tsdlg:PluginWindowBase.DataContext>

    <tsdlg:PluginWindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Common.WPF;component/DataTemplates/SymbolDataTemplate.xaml" />
                <ResourceDictionary Source="/MJ5001;component/Assets/Backgrounds.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <vc:BoltHoleTypeToSlottedHoleXDisplayNameConverter x:Key="BoltHoleTypeToSlottedHoleXDisplayName" />
            <vc:BoltHoleTypeToSlottedHoleXIsEnabledConverter x:Key="BoltHoleTypeToSlottedHoleXIsEnabled" />
            <vc:BoltHoleTypeToSlottedHoleYIsEnabledConverter x:Key="BoltHoleTypeToSlottedHoleYIsEnabled" />
            <vc:BoltHoleTypeToRotateSlotsIsEnabledConverter x:Key="BoltHoleTypeToRotateSlotsIsEnabled" />
            <vc:BoltPlainHoleTypeToBlindHoleDepthIsEnabledConverter x:Key="BoltPlainHoleTypeToBlindHoleDepthIsEnabled" />
            <vc:ChamferTypeToXIsEnabledConverter x:Key="ChamferTypeToXIsEnabled" />
            <vc:ChamferTypeToYIsEnabledConverter x:Key="ChamferTypeToYIsEnabled" />

            <Style x:Key="Element" TargetType="FrameworkElement">
                <Setter Property="Margin" Value="2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ContainingTextBoxElement" TargetType="FrameworkElement" BasedOn="{StaticResource Element}">
                <Setter Property="Height" Value="20" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="CheckBox" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="TextBox">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="ComboBox" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfFilterCheckBox">
                <Setter Property="Margin" Value="2,2,-2,2" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="uc:BoltAssembly" />
            <Style BasedOn="{StaticResource Element}" TargetType="uc:BoltSpecialHole" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfProfileCatalog" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfMaterialCatalog" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuic:WpfBoltCatalogSize" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuic:WpfBoltCatalogStandard" />
        </ResourceDictionary>
    </tsdlg:PluginWindowBase.Resources>

    <DockPanel>
        <tsuic:WpfSaveLoad DockPanel.Dock="Top" HelpOpenClicked="WpfSaveLoad_HelpOpenClicked" />
        <tsuic:WpfOkApplyModifyGetOnOffCancel DockPanel.Dock="Bottom"
                                              ApplyClicked="WPFOkApplyModifyGetOnOffCancel_ApplyClicked"
                                              CancelClicked="WPFOkApplyModifyGetOnOffCancel_CancelClicked"
                                              GetClicked="WPFOkApplyModifyGetOnOffCancel_GetClicked"
                                              ModifyClicked="WPFOkApplyModifyGetOnOffCancel_ModifyClicked"
                                              OkClicked="WPFOkApplyModifyGetOnOffCancel_OkClicked"
                                              OnOffClicked="WPFOkApplyModifyGetOnOffCancel_OnOffClicked" />
        <TextBlock DockPanel.Dock="Bottom" Margin="4" TextWrapping="Wrap">
            <Run>Huang YongXing -</Run>
            <Hyperlink NavigateUri="mailto:thinkerhua@hotmail.com">thinkerhua@hotmail.com</Hyperlink>
        </TextBlock>

        <TabControl>

            <TabItem Header="{tr:Translate albl_Parameters}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Canvas Grid.Column="0" Width="330" Height="260" HorizontalAlignment="Left">
                        <Image Canvas.Left="10" Canvas.Top="10" Width="200" Stretch="Uniform">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource FrontViewWithDimension}" />
                            </Image.Source>
                        </Image>
                        <Image Canvas.Left="220" Canvas.Top="68.6" Width="100" Stretch="Uniform">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource EmbedmentBehindViewWithDimension}" />
                            </Image.Source>
                        </Image>

                        <TextBlock Canvas.Left="78" Canvas.Top="223" Text="g" />
                        <TextBlock Canvas.Left="43" Canvas.Top="225" Text="l" />
                        <TextBlock Canvas.Left="307" Canvas.Top="200" Text="adx" />
                        <TextBlock Canvas.Left="245" Canvas.Top="225" Text="ady" />
                        <TextBlock Canvas.Left="145" Canvas.Top="149" Text="dx" />
                        <TextBlock Canvas.Left="101" Canvas.Top="182" Text="dy" />
                    </Canvas>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{tsdlg:Loc albl_gap}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="g" />
                        <tsuic:WpfFilterCheckBox Grid.Row="0" Grid.Column="2" AttributeName="Gap" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Gap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Separator Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{tsdlg:Loc albl_anchor_rod}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_Size}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="2" AttributeName="BAnchorRodSIZE" />
                        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding BoltAnchorRodSize, Mode=TwoWay}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_Length}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="l" />
                        <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="2" AttributeName="BAnchorRodLEN" />
                        <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding BoltAnchorRodLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_DistX}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="adx" />
                        <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="2" AttributeName="BAnchorRodDISTX" />
                        <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding BoltAnchorRodDistX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_DistY}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="ady" />
                        <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="2" AttributeName="BAnchorRodDISTY" />
                        <TextBox Grid.Row="6" Grid.Column="3" Text="{Binding BoltAnchorRodDistY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Separator Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" />
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="{tsdlg:Loc albl_beam_chamfer}" />

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="{tr:Translate albl_Chamfer_Header_Type}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="9" Grid.Column="2" AttributeName="CF1TYPE" />
                        <ComboBox Grid.Row="9"
                                  Grid.Column="3"
                                  SelectedIndex="{Binding Chamfer1Type, Mode=TwoWay}"
                                  ItemsSource="{x:Static assets:ChamferSymbols.ChamferTypeSet}"
                                  ItemTemplate="{StaticResource SymbolDataTemplate}" />

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="{tr:Translate albl_Chamfer_Header_X}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="10" Grid.Column="2" AttributeName="CF1X" IsEnabled="{Binding Chamfer1Type, Mode=OneWay, Converter={StaticResource ChamferTypeToXIsEnabled}}" />
                        <TextBox Grid.Row="10" Grid.Column="3" Text="{Binding Chamfer1X, Mode=TwoWay}" IsEnabled="{Binding Chamfer1Type, Mode=OneWay, Converter={StaticResource ChamferTypeToXIsEnabled}}" />

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="{tr:Translate albl_Chamfer_Header_Y}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="11" Grid.Column="2" AttributeName="CF1Y" IsEnabled="{Binding Chamfer1Type, Mode=OneWay, Converter={StaticResource ChamferTypeToYIsEnabled}}" />
                        <TextBox Grid.Row="11" Grid.Column="3" Text="{Binding Chamfer1Y, Mode=TwoWay}" IsEnabled="{Binding Chamfer1Type, Mode=OneWay, Converter={StaticResource ChamferTypeToYIsEnabled}}" />

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="{tr:Translate albl_Chamfer_Header_Dz1}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="12" Grid.Column="2" AttributeName="CF1DZ1" />
                        <TextBox Grid.Row="12" Grid.Column="3" Text="{Binding Chamfer1Dz1, Mode=TwoWay}" />

                        <TextBlock Grid.Row="13" Grid.Column="0" Text="{tr:Translate albl_Chamfer_Header_Dz2}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="13" Grid.Column="2" AttributeName="CF1DZ2" />
                        <TextBox Grid.Row="13" Grid.Column="3" Text="{Binding Chamfer1Dz2, Mode=TwoWay}" />

                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{tr:Translate albl_Parts}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Id}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Name}" />
                    <TextBlock Grid.Row="0" Grid.Column="4" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Thickness}" />
                    <TextBlock Grid.Row="0" Grid.Column="6" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Breadth}" />
                    <TextBlock Grid.Row="0" Grid.Column="8" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Height}" />
                    <TextBlock Grid.Row="0" Grid.Column="11" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Material}" />
                    <TextBlock Grid.Row="0" Grid.Column="14" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Finish}" />
                    <TextBlock Grid.Row="0" Grid.Column="16" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Class}" />
                    <TextBlock Grid.Row="0" Grid.Column="18" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_NumberingSeries_Prefix}" />
                    <TextBlock Grid.Row="0" Grid.Column="20" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_NumberingSeries_StartNumber}" />

                    <TextBlock Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_anchor_rod}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" AttributeName="PTAnchorRodName" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PartAnchorRodName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="10" AttributeName="PTAnchorRodMATL" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PartAnchorRodMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="1"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PartAnchorRodMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="13" AttributeName="PTAnchorRodFNSH" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PartAnchorRodFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="15" AttributeName="PTAnchorRodCLS" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PartAnchorRodClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="17" AttributeName="PTAnchorRodPTP" />
                    <TextBox Grid.Row="1" Grid.Column="18" Text="{Binding PartAnchorRodPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="19" AttributeName="PTAnchorRodPTN" />
                    <TextBox Grid.Row="1" Grid.Column="20" Text="{Binding PartAnchorRodPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="17" AttributeName="PTAnchorRodASMP" />
                    <TextBox Grid.Row="2" Grid.Column="18" Text="{Binding PartAnchorRodAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="19" AttributeName="PTAnchorRodASMN" />
                    <TextBox Grid.Row="2" Grid.Column="20" Text="{Binding PartAnchorRodAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_cleat}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLCleatName" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateCleatName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLCleatT" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateCleatThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="5" AttributeName="PLCleatB" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="6" Text="{Binding PlateCleatBreadth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="7" AttributeName="PLCleatH" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="8" Text="{Binding PlateCleatHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLCleatMATL" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateCleatMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="3"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateCleatMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLCleatFNSH" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateCleatFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLCleatCLS" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateCleatClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="17" AttributeName="PLCleatPTP" />
                    <TextBox Grid.Row="3" Grid.Column="18" Text="{Binding PlateCleatPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="19" AttributeName="PLCleatPTN" />
                    <TextBox Grid.Row="3" Grid.Column="20" Text="{Binding PlateCleatPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="17" AttributeName="PLCleatASMP" />
                    <TextBox Grid.Row="4" Grid.Column="18" Text="{Binding PlateCleatAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="19" AttributeName="PLCleatASMN" />
                    <TextBox Grid.Row="4" Grid.Column="20" Text="{Binding PlateCleatAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_embedment}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLEmbedmentName" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateEmbedmentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLEmbedmentT" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateEmbedmentThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="5" AttributeName="PLEmbedmentB" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="6" Text="{Binding PlateEmbedmentBreadth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="7" AttributeName="PLEmbedmentH" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="8" Text="{Binding PlateEmbedmentHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLEmbedmentMATL" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateEmbedmentMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="5"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateEmbedmentMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLEmbedmentFNSH" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateEmbedmentFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLEmbedmentCLS" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateEmbedmentClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="17" AttributeName="PLEmbedmentPTP" />
                    <TextBox Grid.Row="5" Grid.Column="18" Text="{Binding PlateEmbedmentPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="19" AttributeName="PLEmbedmentPTN" />
                    <TextBox Grid.Row="5" Grid.Column="20" Text="{Binding PlateEmbedmentPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="17" AttributeName="PLEmbedmentASMP" />
                    <TextBox Grid.Row="6" Grid.Column="18" Text="{Binding PlateEmbedmentAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="19" AttributeName="PLEmbedmentASMN" />
                    <TextBox Grid.Row="6" Grid.Column="20" Text="{Binding PlateEmbedmentAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                </Grid>
            </TabItem>

            <TabItem Header="{tr:Translate albl_Bolt}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_Size}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="0" Grid.Column="1" AttributeName="B1SIZE" />
                    <tsuic:WpfBoltCatalogSize Grid.Row="0" Grid.Column="2" SelectedItem="{Binding Bolt1Size, Mode=TwoWay}" ItemsSource="{Binding Path=BoltSizes, ElementName=Bolt1StdCatalog}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{tr:Translate albl_Bolt_Header_Standard}" />
                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="1" AttributeName="B1STD" />
                    <tsuic:WpfBoltCatalogStandard x:Name="Bolt1StdCatalog" Grid.Row="1" Grid.Column="2" SelectedItem="{Binding Bolt1Standard, Mode=TwoWay}" />

