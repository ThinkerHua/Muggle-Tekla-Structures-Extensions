<tsd:PluginWindowBase x:Class="Muggle.TsExtensions.Demo1.Views.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
                      xmlns:sys="clr-namespace:System;assembly=mscorlib"
                      xmlns:tsd="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
                      xmlns:tsuc="clr-namespace:Tekla.Structures.Dialog.UIControls;assembly=Tekla.Structures.Dialog"
                      xmlns:vm="clr-namespace:Muggle.TsExtensions.Demo1.ViewModels"
                      xmlns:uc="clr-namespace:Muggle.TsExtensions.Common.WPF.Controls;assembly=Common.WPF"
                      Title="Demo1"
                      Background="#F3F3F7"
                      ResizeMode="NoResize"
                      SizeToContent="WidthAndHeight"
                      UseDefaultStyle="False"
                      mc:Ignorable="d">

    <tsd:PluginWindowBase.DataContext>
        <vm:MainWindowViewModel />
    </tsd:PluginWindowBase.DataContext>

    <tsd:PluginWindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Common.WPF;component/Assets/WeldSymbols.xaml" />
                <ResourceDictionary Source="/Common.WPF;component/DataTemplates/SymbolDataTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <x:Array x:Key="WeldConnectAsSet" Type="sys:String">
                <sys:String>As secondary part</sys:String>
                <sys:String>As sub assembly</sys:String>
            </x:Array>

            <x:Array x:Key="WeldPlacementSet" Type="sys:String">
                <sys:String>Auto</sys:String>
                <sys:String>Main part</sys:String>
                <sys:String>Secondary part</sys:String>
            </x:Array>

            <x:Array x:Key="WeldPreparationSet" Type="sys:String">
                <sys:String>None</sys:String>
                <sys:String>Auto</sys:String>
                <sys:String>Main part</sys:String>
                <sys:String>Secondary part</sys:String>
            </x:Array>

            <x:Array x:Key="BoltTypeSet" Type="sys:String">
                <sys:String>Site</sys:String>
                <sys:String>Workshop</sys:String>
            </x:Array>

            <x:Array x:Key="BoltThreadInMaterialSet" Type="sys:String">
                <sys:String>No</sys:String>
                <sys:String>Yes</sys:String>
            </x:Array>

            <x:Array x:Key="BoltPlainHoleTypeSet" Type="sys:String">
                <sys:String>Through</sys:String>
                <sys:String>Blind</sys:String>
            </x:Array>

            <x:Array x:Key="BoltSpecialHoleTypeSet" Type="sys:String">
                <sys:String>Oversized</sys:String>
                <sys:String>Slotted</sys:String>
                <sys:String>No hole</sys:String>
            </x:Array>

            <x:Array x:Key="BoltRotateSlotsSet" Type="sys:String">
                <sys:String>Odd</sys:String>
                <sys:String>Even</sys:String>
                <sys:String>Parallel</sys:String>
            </x:Array>

            <Style x:Key="Element" TargetType="FrameworkElement">
                <Setter Property="Margin" Value="2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="TextBlock" />
            <Style BasedOn="{StaticResource Element}" TargetType="TextBox">
                <Setter Property="Height" Value="20" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="CheckBox" />
            <Style BasedOn="{StaticResource Element}" TargetType="ComboBox">
                <Setter Property="Height" Value="20" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="uc:BoltAssembly">
                <Setter Property="Width" Value="100" />
                <Setter Property="Height" Value="130" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="uc:BoltSpecialHole">
                <Setter Property="Width" Value="100" />
                <Setter Property="Height" Value="109" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="tsuc:WpfFilterCheckBox" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuc:WpfProfileCatalog" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuc:WpfMaterialCatalog" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuc:WpfBoltCatalogSize">
                <Setter Property="Height" Value="20" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="tsuc:WpfBoltCatalogStandard">
                <Setter Property="Height" Value="20" />
            </Style>
        </ResourceDictionary>
    </tsd:PluginWindowBase.Resources>

    <DockPanel LastChildFill="True">
        <tsuc:WpfSaveLoad DockPanel.Dock="Top" />
        <tsuc:WpfOkApplyModifyGetOnOffCancel DockPanel.Dock="Bottom"
                                             ApplyClicked="WPFOkApplyModifyGetOnOffCancel_ApplyClicked"
                                             CancelClicked="WPFOkApplyModifyGetOnOffCancel_CancelClicked"
                                             GetClicked="WPFOkApplyModifyGetOnOffCancel_GetClicked"
                                             ModifyClicked="WPFOkApplyModifyGetOnOffCancel_ModifyClicked"
                                             OkClicked="WPFOkApplyModifyGetOnOffCancel_OkClicked"
                                             OnOffClicked="WPFOkApplyModifyGetOnOffCancel_OnOffClicked" />

        <TabControl Margin="2,0">
            <TabItem Header="General">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Gap" />
                    <tsuc:WpfFilterCheckBox Grid.Row="0" Grid.Column="1" AttributeName="Gap" />
                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Gap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Creat stud" />
                    <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.Column="1" AttributeName="CreatStud" />
                    <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding CreatStud, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </TabItem>

            <TabItem Header="Parts">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Text="#" />
                    <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Text="Name" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="4"
                               Grid.ColumnSpan="5"
                               HorizontalAlignment="Center"
                               Text="Profile" />
                    <TextBlock Grid.Row="5" Grid.Column="4" HorizontalAlignment="Center" Text="t" />
                    <TextBlock Grid.Row="5" Grid.Column="6" HorizontalAlignment="Center" Text="b" />
                    <TextBlock Grid.Row="5" Grid.Column="8" HorizontalAlignment="Center" Text="h" />
                    <TextBlock Grid.Row="0" Grid.Column="11" HorizontalAlignment="Center" Text="Material" />
                    <TextBlock Grid.Row="0" Grid.Column="14" HorizontalAlignment="Center" Text="Finish" />
                    <TextBlock Grid.Row="0" Grid.Column="16" HorizontalAlignment="Center" Text="Class" />
                    <TextBlock Grid.Row="0" Grid.Column="18" HorizontalAlignment="Center" Text="Pos" />
                    <TextBlock Grid.Row="0" Grid.Column="20" HorizontalAlignment="Center" Text="No" />

                    <TextBlock Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Text="Primary" />

                    <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" AttributeName="PTPrimaryName" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PartPrimaryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="3" AttributeName="PTPrimaryPRF" />
                    <TextBox Grid.Row="1"
                             Grid.RowSpan="2"
                             Grid.Column="4"
                             Grid.ColumnSpan="5"
                             Text="{Binding PartPrimaryProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuc:WpfProfileCatalog Grid.Row="1"
                                            Grid.RowSpan="2"
                                            Grid.Column="9"
                                            SelectClicked="PartPrimaryProfileSelectClicked"
                                            SelectionDone="PartPrimaryProfileSelectionDone" />

                    <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="10" AttributeName="PTPrimaryMATL" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PartPrimaryMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuc:WpfMaterialCatalog Grid.Row="1"
                                             Grid.RowSpan="2"
                                             Grid.Column="12"
                                             SelectClicked="PartPrimaryMaterialSelectClicked"
                                             SelectionDone="PartPrimaryMaterialSelectionDone" />

                    <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="13" AttributeName="PTPrimaryFNSH" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PartPrimaryFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="15" AttributeName="PTPrimaryCLS" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PartPrimaryClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.Column="17" AttributeName="PTPrimaryPTP" />
                    <TextBox Grid.Row="1" Grid.Column="18" Text="{Binding PartPrimaryPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.Column="19" AttributeName="PTPrimaryPTN" />
                    <TextBox Grid.Row="1" Grid.Column="20" Text="{Binding PartPrimaryPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="2" Grid.Column="17" AttributeName="PTPrimaryASMP" />
                    <TextBox Grid.Row="2" Grid.Column="18" Text="{Binding PartPrimaryAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="2" Grid.Column="19" AttributeName="PTPrimaryASMN" />
                    <TextBox Grid.Row="2" Grid.Column="20" Text="{Binding PartPrimaryAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.RowSpan="2" Grid.Column="0" Text="Secondary" />

                    <tsuc:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="1" AttributeName="PTSecondaryName" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PartSecondaryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="3" AttributeName="PTSecondaryPRF" />
                    <TextBox Grid.Row="3"
                             Grid.RowSpan="2"
                             Grid.Column="4"
                             Grid.ColumnSpan="5"
                             Text="{Binding PartSecondaryProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuc:WpfProfileCatalog Grid.Row="3"
                                            Grid.RowSpan="2"
                                            Grid.Column="9"
                                            SelectClicked="PartSecondaryProfileSelectClicked"
                                            SelectionDone="PartSecondaryProfileSelectionDone" />

                    <tsuc:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="10" AttributeName="PTSecondaryMATL" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PartSecondaryMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuc:WpfMaterialCatalog Grid.Row="3"
                                             Grid.RowSpan="2"
                                             Grid.Column="12"
                                             SelectClicked="PartSecondaryMaterialSelectClicked"
                                             SelectionDone="PartSecondaryMaterialSelectionDone" />

                    <tsuc:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="13" AttributeName="PTSecondaryFNSH" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PartSecondaryFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="15" AttributeName="PTSecondaryCLS" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PartSecondaryClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="3" Grid.Column="17" AttributeName="PTSecondaryPTP" />
                    <TextBox Grid.Row="3" Grid.Column="18" Text="{Binding PartSecondaryPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="3" Grid.Column="19" AttributeName="PTSecondaryPTN" />
                    <TextBox Grid.Row="3" Grid.Column="20" Text="{Binding PartSecondaryPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="4" Grid.Column="17" AttributeName="PTSecondaryASMP" />
                    <TextBox Grid.Row="4" Grid.Column="18" Text="{Binding PartSecondaryAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="4" Grid.Column="19" AttributeName="PTSecondaryASMN" />
                    <TextBox Grid.Row="4" Grid.Column="20" Text="{Binding PartSecondaryAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6" Grid.RowSpan="2" Grid.Column="0" Text="Stiffener" />

                    <tsuc:WpfFilterCheckBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLStiffenerName" />
                    <TextBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateStiffenerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLStiffenerT" />
                    <TextBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateStiffenerThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLStiffenerMATL" />
                    <TextBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateStiffenerMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuc:WpfMaterialCatalog Grid.Row="6"
                                             Grid.RowSpan="2"
                                             Grid.Column="12"
                                             SelectClicked="PlateStiffenerMaterialSelectClicked"
                                             SelectionDone="PlateStiffenerMaterialSelectionDone" />

                    <tsuc:WpfFilterCheckBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLStiffenerFNSH" />
                    <TextBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateStiffenerFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLStiffenerCLS" />
                    <TextBox Grid.Row="6" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateStiffenerClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="6" Grid.Column="17" AttributeName="PLStiffenerPTP" />
                    <TextBox Grid.Row="6" Grid.Column="18" Text="{Binding PlateStiffenerPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="6" Grid.Column="19" AttributeName="PLStiffenerPTN" />
                    <TextBox Grid.Row="6" Grid.Column="20" Text="{Binding PlateStiffenerPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="7" Grid.Column="17" AttributeName="PLStiffenerASMP" />
                    <TextBox Grid.Row="7" Grid.Column="18" Text="{Binding PlateStiffenerAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="7" Grid.Column="19" AttributeName="PLStiffenerASMN" />
                    <TextBox Grid.Row="7" Grid.Column="20" Text="{Binding PlateStiffenerAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="8" Grid.RowSpan="2" Grid.Column="0" Text="Splice" />

                    <tsuc:WpfFilterCheckBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLSpliceName" />
                    <TextBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateSpliceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLSpliceT" />
                    <TextBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateSpliceThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="5" AttributeName="PLSpliceB" />
                    <TextBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="6" Text="{Binding PlateSpliceBreadth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="7" AttributeName="PLSpliceH" />
                    <TextBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="8" Text="{Binding PlateSpliceHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLSpliceMATL" />
                    <TextBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateSpliceMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuc:WpfMaterialCatalog Grid.Row="8"
                                             Grid.RowSpan="2"
                                             Grid.Column="12"
                                             SelectClicked="PlateSpliceMaterialSelectClicked"
                                             SelectionDone="PlateSpliceMaterialSelectionDone" />

                    <tsuc:WpfFilterCheckBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLSpliceFNSH" />
                    <TextBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateSpliceFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLSpliceCLS" />
                    <TextBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="16" Text="{Binding PlateSpliceClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="8" Grid.Column="17" AttributeName="PLSplicePTP" />
                    <TextBox Grid.Row="8" Grid.Column="18" Text="{Binding PlateSplicePartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="8" Grid.Column="19" AttributeName="PLSplicePTN" />
                    <TextBox Grid.Row="8" Grid.Column="20" Text="{Binding PlateSplicePartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="9" Grid.Column="17" AttributeName="PLSpliceASMP" />
                    <TextBox Grid.Row="9" Grid.Column="18" Text="{Binding PlateSpliceAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuc:WpfFilterCheckBox Grid.Row="9" Grid.Column="19" AttributeName="PLSpliceASMN" />
                    <TextBox Grid.Row="9" Grid.Column="20" Text="{Binding PlateSpliceAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </TabItem>

            <TabItem Header="Bolt">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Size" />
                        <tsuc:WpfFilterCheckBox Grid.Row="0" Grid.Column="1" AttributeName="BConnectSIZE" />
                        <tsuc:WpfBoltCatalogSize Grid.Row="0" Grid.Column="2" SelectedItem="{Binding BoltConnectSize, Mode=TwoWay}" ItemsSource="{Binding Path=BoltSizes, ElementName=BoltConnectStdCatalog}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Standard" />
                        <tsuc:WpfFilterCheckBox Grid.Row="1" Grid.Column="1" AttributeName="BConnectSTD" />
                        <tsuc:WpfBoltCatalogStandard x:Name="BoltConnectStdCatalog" Grid.Row="1" Grid.Column="2" SelectedItem="{Binding BoltConnectStandard, Mode=TwoWay}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Bolt type" />
                        <tsuc:WpfFilterCheckBox Grid.Row="2" Grid.Column="1" AttributeName="BConnectTYPE" />
                        <ComboBox Grid.Row="2" Grid.Column="2" SelectedIndex="{Binding BoltConnectType, Mode=TwoWay}" ItemsSource="{StaticResource BoltTypeSet}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Thread in material" />
                        <tsuc:WpfFilterCheckBox Grid.Row="3" Grid.Column="1" AttributeName="BConnectTHRD" />
                        <ComboBox Grid.Row="3" Grid.Column="2" SelectedIndex="{Binding BoltConnectThreadInMaterial, Mode=TwoWay}" ItemsSource="{StaticResource BoltThreadInMaterialSet}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Cut length" />
                        <tsuc:WpfFilterCheckBox Grid.Row="4" Grid.Column="1" AttributeName="BConnectCLEN" />
                        <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding BoltConnectCutLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Extra length" />
                        <tsuc:WpfFilterCheckBox Grid.Row="5" Grid.Column="1" AttributeName="BConnectXLEN" />
                        <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding BoltConnectExtraLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Tolerance" />
                        <tsuc:WpfFilterCheckBox Grid.Row="6" Grid.Column="1" AttributeName="BConnectTOL" />
                        <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding BoltConnectTolerance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Plain hole type" />
                        <tsuc:WpfFilterCheckBox Grid.Row="7" Grid.Column="1" AttributeName="BConnectPLAIN" />
                        <ComboBox Grid.Row="7" Grid.Column="2" SelectedIndex="{Binding BoltConnectPlainType, Mode=TwoWay}" ItemsSource="{StaticResource BoltPlainHoleTypeSet}" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Hole depth" />
                        <tsuc:WpfFilterCheckBox Grid.Row="8" Grid.Column="1" AttributeName="BConnectDEPTH" IsEnabled="{c:Binding 'BoltConnectPlainType.Value == 1', Mode=OneWay}" />
                        <TextBox Grid.Row="8" Grid.Column="2" Text="{Binding BoltConnectBlindHoleDepth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{c:Binding 'BoltConnectPlainType.Value == 1', Mode=OneWay}" />

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Special hole type" />
                        <tsuc:WpfFilterCheckBox Grid.Row="9" Grid.Column="1" AttributeName="BConnectHOLTY" />
                        <ComboBox Grid.Row="9" Grid.Column="2" SelectedIndex="{Binding BoltConnectHoleType, Mode=TwoWay}" ItemsSource="{StaticResource BoltSpecialHoleTypeSet}" />

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="{c:Binding 'BoltConnectHoleType.Value == 0 ? &quot;Oversized&quot; : &quot;Slotted hole X&quot;'}" />
                        <tsuc:WpfFilterCheckBox Grid.Row="10" Grid.Column="1" AttributeName="BConnectSLOTX" IsEnabled="{c:Binding 'BoltConnectHoleType.Value != 2'}" />
                        <TextBox Grid.Row="10" Grid.Column="2" Text="{Binding BoltConnectSlottedHoleX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{c:Binding 'BoltConnectHoleType.Value != 2'}" />

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Slotted hole Y" />
                        <tsuc:WpfFilterCheckBox Grid.Row="11" Grid.Column="1" AttributeName="BConnectSLOTY" IsEnabled="{c:Binding 'BoltConnectHoleType.Value == 1'}" />
                        <TextBox Grid.Row="11" Grid.Column="2" Text="{Binding BoltConnectSlottedHoleY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{c:Binding 'BoltConnectHoleType.Value == 1'}" />

