<tsdlg:PluginWindowBase x:Class="Muggle.TsExtensions.Demo1.View"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:local="clr-namespace:Muggle.TsExtensions.Demo1"
                        xmlns:tsdlg="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
                        xmlns:tsuic="clr-namespace:Tekla.Structures.Dialog.UIControls;assembly=Tekla.Structures.Dialog"
                        xmlns:assets="clr-namespace:Muggle.TsExtensions.Common.WPF.Assets;assembly=Common.WPF"
                        xmlns:uc="clr-namespace:Muggle.TsExtensions.Common.WPF.Controls;assembly=Common.WPF"
                        xmlns:vc="clr-namespace:Muggle.TsExtensions.Common.WPF.ValueConverters;assembly=Common.WPF"
                        Title="Demo1"
                        Background="#F3F3F7"
                        ResizeMode="NoResize"
                        SizeToContent="WidthAndHeight"
                        UseDefaultStyle="False"
                        mc:Ignorable="d">

    <tsdlg:PluginWindowBase.DataContext>
        <local:ViewModel />
    </tsdlg:PluginWindowBase.DataContext>

    <tsdlg:PluginWindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Common.WPF;component/DataTemplates/SymbolDataTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <vc:BoltHoleTypeToSlottedHoleXDisplayNameConverter x:Key="BoltHoleTypeToSlottedHoleXDisplayName" />
            <vc:BoltHoleTypeToSlottedHoleXIsEnabledConverter x:Key="BoltHoleTypeToSlottedHoleXIsEnabled" />
            <vc:BoltHoleTypeToSlottedHoleYIsEnabledConverter x:Key="BoltHoleTypeToSlottedHoleYIsEnabled" />
            <vc:BoltHoleTypeToRotateSlotsIsEnabledConverter x:Key="BoltHoleTypeToRotateSlotsIsEnabled" />
            <vc:BoltPlainHoleTypeToBlindHoleDepthIsEnabledConverter x:Key="BoltPlainHoleTypeToBlindHoleDepthIsEnabled" />
            <vc:BoltShapeToDistXyVisibilityConverter x:Key="BoltShapeToDistXyVisibility" />
            <vc:BoltShapeToNumDiamVisibilityConverter x:Key="BoltShapeToNumDiamVisibility" />
            <vc:ChamferTypeToXIsEnabledConverter x:Key="ChamferTypeToXIsEnabled" />
            <vc:ChamferTypeToYIsEnabledConverter x:Key="ChamferTypeToYIsEnabled" />
            <vc:BoolToExpectationConverter x:Key="BoolToExpectation" />

            <Style x:Key="Element" TargetType="FrameworkElement">
                <Setter Property="Margin" Value="2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ContainingTextBoxElement" BasedOn="{StaticResource Element}" TargetType="FrameworkElement">
                <Setter Property="Height" Value="20" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="TextBlock" />
            <Style BasedOn="{StaticResource Element}" TargetType="CheckBox" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="TextBox">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="ComboBox" />
            <Style BasedOn="{StaticResource Element}" TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="ExpandDirection" Value="Right" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="uc:BoltAssembly">
                <Setter Property="Height" Value="60" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="uc:BoltSpecialHole">
                <Setter Property="Height" Value="60" />
            </Style>
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="uc:ClassSelector" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfFilterCheckBox">
                <Setter Property="Margin" Value="2,2,-2,2" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfProfileCatalog" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfMaterialCatalog" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuic:WpfBoltCatalogSize" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuic:WpfBoltCatalogStandard" />

        </ResourceDictionary>
    </tsdlg:PluginWindowBase.Resources>

    <DockPanel LastChildFill="True">
        <tsuic:WpfSaveLoad DockPanel.Dock="Top" />
        <tsuic:WpfOkApplyModifyGetOnOffCancel DockPanel.Dock="Bottom"
                                              ApplyClicked="WPFOkApplyModifyGetOnOffCancel_ApplyClicked"
                                              CancelClicked="WPFOkApplyModifyGetOnOffCancel_CancelClicked"
                                              GetClicked="WPFOkApplyModifyGetOnOffCancel_GetClicked"
                                              ModifyClicked="WPFOkApplyModifyGetOnOffCancel_ModifyClicked"
                                              OkClicked="WPFOkApplyModifyGetOnOffCancel_OkClicked"
                                              OnOffClicked="WPFOkApplyModifyGetOnOffCancel_OnOffClicked" />

        <TabControl Margin="2,0">
            <TabItem Header="Parameters">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Gap" />
                    <tsuic:WpfFilterCheckBox Grid.Row="0" Grid.Column="1" AttributeName="Gap" />
                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Gap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Create stud" />
                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="1" AttributeName="CreateStud" />
                    <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding CreateStud, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="Stiffener chamfer" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Text="Type" />
                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="1" AttributeName="CFStifTYPE" />
                    <ComboBox Grid.Row="3"
                              Grid.Column="2"
                              ItemTemplate="{StaticResource SymbolDataTemplate}"
                              ItemsSource="{x:Static assets:ChamferSymbols.ChamferTypeSet}"
                              SelectedIndex="{Binding ChamferStifType, Mode=TwoWay}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="X" />
                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="1" AttributeName="CFStifX" IsEnabled="{Binding ChamferStifType, Converter={StaticResource ChamferTypeToXIsEnabled}}" />
                    <TextBox Grid.Row="4" Grid.Column="2" IsEnabled="{Binding ChamferStifType, Converter={StaticResource ChamferTypeToXIsEnabled}}" Text="{Binding ChamferStifX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Y" />
                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="1" AttributeName="CFStifY" IsEnabled="{Binding ChamferStifType, Converter={StaticResource ChamferTypeToYIsEnabled}}" />
                    <TextBox Grid.Row="5" Grid.Column="2" IsEnabled="{Binding ChamferStifType, Converter={StaticResource ChamferTypeToYIsEnabled}}" Text="{Binding ChamferStifY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Dz1" />
                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="1" AttributeName="CFStifDZ1" />
                    <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding ChamferStifDz1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Dz2" />
                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.Column="1" AttributeName="CFStifDZ2" />
                    <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding ChamferStifDz2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </TabItem>

            <TabItem Header="Parts">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Text="#" />
                    <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Text="Name" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="4"
                               Grid.ColumnSpan="5"
                               HorizontalAlignment="Center"
                               Text="Profile / t*b*h" />
                    <TextBlock Grid.Row="0" Grid.Column="11" HorizontalAlignment="Center" Text="Material" />
                    <TextBlock Grid.Row="0" Grid.Column="14" HorizontalAlignment="Center" Text="Finish" />
                    <TextBlock Grid.Row="0" Grid.Column="16" HorizontalAlignment="Center" Text="Class" />
                    <TextBlock Grid.Row="0" Grid.Column="18" HorizontalAlignment="Center" Text="Pos" />
                    <TextBlock Grid.Row="0" Grid.Column="20" HorizontalAlignment="Center" Text="No" />

                    <TextBlock Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Text="Primary" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" AttributeName="PTPrimaryName" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PartPrimaryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="3" AttributeName="PTPrimaryPRF" />
                    <TextBox Grid.Row="1"
                             Grid.RowSpan="2"
                             Grid.Column="4"
                             Grid.ColumnSpan="5"
                             Text="{Binding PartPrimaryProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfProfileCatalog Grid.Row="1"
                                             Grid.RowSpan="2"
                                             Grid.Column="9"
                                             SelectClicked="WpfProfileCatalog_SelectClicked"
                                             SelectionDone="WpfProfileCatalog_SelectionDone"
                                             Tag="PartPrimaryProfile" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="10" AttributeName="PTPrimaryMATL" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PartPrimaryMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="1"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone"
                                              Tag="PartPrimaryMaterial" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="13" AttributeName="PTPrimaryFNSH" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PartPrimaryFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="15" AttributeName="PTPrimaryCLS" />
                    <uc:ClassSelector Grid.Row="1" Grid.RowSpan="2" Grid.Column="16" Value="{Binding PartPrimaryClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="17" AttributeName="PTPrimaryPTP" />
                    <TextBox Grid.Row="1" Grid.Column="18" Text="{Binding PartPrimaryPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="19" AttributeName="PTPrimaryPTN" />
                    <TextBox Grid.Row="1" Grid.Column="20" Text="{Binding PartPrimaryPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="17" AttributeName="PTPrimaryASMP" />
                    <TextBox Grid.Row="2" Grid.Column="18" Text="{Binding PartPrimaryAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="19" AttributeName="PTPrimaryASMN" />
                    <TextBox Grid.Row="2" Grid.Column="20" Text="{Binding PartPrimaryAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.RowSpan="2" Grid.Column="0" Text="Secondary" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="1" AttributeName="PTSecondaryName" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PartSecondaryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="3" AttributeName="PTSecondaryPRF" />
                    <TextBox Grid.Row="3"
                             Grid.RowSpan="2"
                             Grid.Column="4"
                             Grid.ColumnSpan="5"
                             Text="{Binding PartSecondaryProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfProfileCatalog Grid.Row="3"
                                             Grid.RowSpan="2"
                                             Grid.Column="9"
                                             SelectClicked="WpfProfileCatalog_SelectClicked"
                                             SelectionDone="WpfProfileCatalog_SelectionDone"
                                             Tag="PartSecondaryProfile" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="10" AttributeName="PTSecondaryMATL" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PartSecondaryMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="3"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone"
                                              Tag="PartSecondaryMaterial" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="13" AttributeName="PTSecondaryFNSH" />
                    <TextBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PartSecondaryFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="15" AttributeName="PTSecondaryCLS" />
                    <uc:ClassSelector Grid.Row="3" Grid.RowSpan="2" Grid.Column="16" Value="{Binding PartSecondaryClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="17" AttributeName="PTSecondaryPTP" />
                    <TextBox Grid.Row="3" Grid.Column="18" Text="{Binding PartSecondaryPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="19" AttributeName="PTSecondaryPTN" />
                    <TextBox Grid.Row="3" Grid.Column="20" Text="{Binding PartSecondaryPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="17" AttributeName="PTSecondaryASMP" />
                    <TextBox Grid.Row="4" Grid.Column="18" Text="{Binding PartSecondaryAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="19" AttributeName="PTSecondaryASMN" />
                    <TextBox Grid.Row="4" Grid.Column="20" Text="{Binding PartSecondaryAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Grid.RowSpan="2" Grid.Column="0" Text="Stiffener" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLStiffenerName" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateStiffenerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLStiffenerT" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateStiffenerThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLStiffenerMATL" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateStiffenerMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="5"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone"
                                              Tag="PlateStiffenerMaterial" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLStiffenerFNSH" />
                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateStiffenerFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLStiffenerCLS" />
                    <uc:ClassSelector Grid.Row="5" Grid.RowSpan="2" Grid.Column="16" Value="{Binding PlateStiffenerClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="17" AttributeName="PLStiffenerPTP" />
                    <TextBox Grid.Row="5" Grid.Column="18" Text="{Binding PlateStiffenerPartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="19" AttributeName="PLStiffenerPTN" />
                    <TextBox Grid.Row="5" Grid.Column="20" Text="{Binding PlateStiffenerPartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="17" AttributeName="PLStiffenerASMP" />
                    <TextBox Grid.Row="6" Grid.Column="18" Text="{Binding PlateStiffenerAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="19" AttributeName="PLStiffenerASMN" />
                    <TextBox Grid.Row="6" Grid.Column="20" Text="{Binding PlateStiffenerAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="7" Grid.RowSpan="2" Grid.Column="0" Text="Splice" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLSpliceName" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateSpliceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLSpliceT" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateSpliceThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="5" AttributeName="PLSpliceB" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="6" Text="{Binding PlateSpliceBreadth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="7" AttributeName="PLSpliceH" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="8" Text="{Binding PlateSpliceHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLSpliceMATL" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateSpliceMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="7"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone"
                                              Tag="PlateSpliceMaterial" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLSpliceFNSH" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateSpliceFinish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLSpliceCLS" />
                    <uc:ClassSelector Grid.Row="7" Grid.RowSpan="2" Grid.Column="16" Value="{Binding PlateSpliceClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.Column="17" AttributeName="PLSplicePTP" />
                    <TextBox Grid.Row="7" Grid.Column="18" Text="{Binding PlateSplicePartPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.Column="19" AttributeName="PLSplicePTN" />
                    <TextBox Grid.Row="7" Grid.Column="20" Text="{Binding PlateSplicePartStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="8" Grid.Column="17" AttributeName="PLSpliceASMP" />
                    <TextBox Grid.Row="8" Grid.Column="18" Text="{Binding PlateSpliceAssemblyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="8" Grid.Column="19" AttributeName="PLSpliceASMN" />
                    <TextBox Grid.Row="8" Grid.Column="20" Text="{Binding PlateSpliceAssemblyStartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </TabItem>

            <TabItem Header="Bolt">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Size" />
                    <tsuic:WpfFilterCheckBox Grid.Row="0" Grid.Column="1" AttributeName="B1SIZE" />
                    <tsuic:WpfBoltCatalogSize Grid.Row="0" Grid.Column="2" ItemsSource="{Binding Path=BoltSizes, ElementName=Bolt1StdCatalog}" SelectedItem="{Binding Bolt1Size, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Standard" />
                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="1" AttributeName="B1STD" />
                    <tsuic:WpfBoltCatalogStandard x:Name="Bolt1StdCatalog" Grid.Row="1" Grid.Column="2" SelectedItem="{Binding Bolt1Standard, Mode=TwoWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Bolt type" />
                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="1" AttributeName="B1TYPE" />
                    <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{x:Static assets:BoltSymbols.BoltTypeSet}" SelectedIndex="{Binding Bolt1Type, Mode=TwoWay}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Thread in material" />
                    <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="1" AttributeName="B1THRD" />
                    <ComboBox Grid.Row="3" Grid.Column="2" ItemsSource="{x:Static assets:BoltSymbols.BoltThreadInMaterialSet}" SelectedIndex="{Binding Bolt1ThreadInMaterial, Mode=TwoWay}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Cut length" />
                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="1" AttributeName="B1CLEN" />
                    <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Bolt1CutLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Extra length" />
                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="1" AttributeName="B1XLEN" />
                    <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding Bolt1ExtraLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Tolerance" />
                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="1" AttributeName="B1TOL" />
                    <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding Bolt1Tolerance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Plain hole type" />
                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.Column="1" AttributeName="B1PLAIN" />
