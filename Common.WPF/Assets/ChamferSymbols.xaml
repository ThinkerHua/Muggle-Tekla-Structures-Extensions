<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:templates="clr-namespace:Muggle.TsExtensions.Common.WPF.DataTemplates">

    <DrawingGroup x:Key="Chamfer_None">
        <GeometryDrawing>
            <GeometryDrawing.Pen>
                <Pen Thickness="2" Brush="Black" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M0,0 H20 V12" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <DrawingGroup x:Key="Chamfer_Line">
        <GeometryDrawing>
            <GeometryDrawing.Pen>
                <Pen Thickness="2" Brush="Black" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M0,0 H9 L20,5 V12" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <DrawingGroup x:Key="Chamfer_Rounding">
        <GeometryDrawing>
            <GeometryDrawing.Pen>
                <Pen Thickness="2" Brush="Black" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M0,0 H13 A7,7 0 0 1 20,7 V12" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <DrawingGroup x:Key="Chamfer_Arc">
        <GeometryDrawing>
            <GeometryDrawing.Pen>
                <Pen Thickness="2" Brush="Black" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M0,0 H13 A7,7 0 0 0 20,7 V12" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <DrawingGroup x:Key="Chamfer_ArcPoint">
        <GeometryDrawing>
            <GeometryDrawing.Pen>
                <Pen Thickness="2" Brush="Black" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M0,12 V6 A12,10 0 0 1 20,6 V12" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <DrawingGroup x:Key="Chamfer_Square">
        <GeometryDrawing>
            <GeometryDrawing.Pen>
                <Pen Thickness="2" Brush="Black" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M0,0 H8 V6 L16,4 L20,12" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <DrawingGroup x:Key="Chamfer_SquareParaller">
        <GeometryDrawing>
            <GeometryDrawing.Pen>
                <Pen Thickness="2" Brush="Black" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M0,0 H7.2 L10,5 H16 L20,12" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <DrawingGroup x:Key="Chamfer_LineAndArc">
        <GeometryDrawing>
            <GeometryDrawing.Pen>
                <Pen Thickness="2" Brush="Black" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M0,0 H7.2 A6,6 0 0 0 13.2,6 H20 L20,12" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <x:Array x:Key="ChamferTypeSet" Type="templates:Symbol">
        <templates:Symbol Name="None" Drawing="{StaticResource Chamfer_None}" />
        <templates:Symbol Name="Line" Drawing="{StaticResource Chamfer_Line}" />
        <templates:Symbol Name="Rounding" Drawing="{StaticResource Chamfer_Rounding}" />
        <templates:Symbol Name="Arc" Drawing="{StaticResource Chamfer_Arc}" />
        <templates:Symbol Name="Arc point" Drawing="{StaticResource Chamfer_ArcPoint}" />
        <templates:Symbol Name="Square" Drawing="{StaticResource Chamfer_Square}" />
        <templates:Symbol Name="Square parallel" Drawing="{StaticResource Chamfer_SquareParaller}" />
        <templates:Symbol Name="Line and arc" Drawing="{StaticResource Chamfer_LineAndArc}" />
    </x:Array>
</ResourceDictionary>