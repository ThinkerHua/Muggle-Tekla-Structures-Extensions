<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DrawingGroup x:Key="BoltShape_Array">
        <GeometryDrawing>
            <GeometryDrawing.Pen>
                <Pen Thickness="1.2" Brush="Black" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <GeometryGroup>
                    <EllipseGeometry Center="-4.8,-4.8" RadiusX="0.6" RadiusY="0.6" />
                    <EllipseGeometry Center="0,-4.8" RadiusX="0.6" RadiusY="0.6" />
                    <EllipseGeometry Center="4.8,-4.8" RadiusX="0.6" RadiusY="0.6" />
                    <EllipseGeometry Center="-4.8,0" RadiusX="0.6" RadiusY="0.6" />
                    <EllipseGeometry Center="0,0" RadiusX="0.6" RadiusY="0.6" />
                    <EllipseGeometry Center="4.8,0" RadiusX="0.6" RadiusY="0.6" />
                    <EllipseGeometry Center="-4.8,4.8" RadiusX="0.6" RadiusY="0.6" />
                    <EllipseGeometry Center="0,4.8" RadiusX="0.6" RadiusY="0.6" />
                    <EllipseGeometry Center="4.8,4.8" RadiusX="0.6" RadiusY="0.6" />
                </GeometryGroup>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

