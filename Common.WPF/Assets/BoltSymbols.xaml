<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    

    <x:Array x:Key="BoltTypeSet" Type="sys:String">
        <sys:String>Site</sys:String>
        <sys:String>Workshop</sys:String>
    </x:Array>

    <x:Array x:Key="BoltThreadInMaterialSet" Type="sys:String">
        <sys:String>No</sys:String>
        <sys:String>Yes</sys:String>
    </x:Array>

    <x:Array x:Key="BoltPlainHoleTypeSet" Type="sys:String">
        <sys:String>Through</sys:String>
        <sys:String>Blind</sys:String>
    </x:Array>

    <x:Array x:Key="BoltSpecialHoleTypeSet" Type="sys:String">
        <sys:String>Oversized</sys:String>
        <sys:String>Slotted</sys:String>
        <sys:String>No hole</sys:String>
    </x:Array>

    <x:Array x:Key="BoltRotateSlotsSet" Type="sys:String">
        <sys:String>Odd</sys:String>
        <sys:String>Even</sys:String>
        <sys:String>Parallel</sys:String>
    </x:Array>
</ResourceDictionary>