<UserControl x:Name="BoltAssemblyControl"
             x:Class="Muggle.TsExtensions.Common.WPF.Controls.BoltAssembly"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Muggle.TsExtensions.Common.WPF.Controls"
             xmlns:vc="clr-namespace:Muggle.TsExtensions.Common.WPF.ValueConverters"
             mc:Ignorable="d"
             d:DesignHeight="130"
             d:DesignWidth="100"
             d:Background="WhiteSmoke">

    <UserControl.Resources>
        <SolidColorBrush x:Key="partFill" Color="#2e74d7" />
        <SolidColorBrush x:Key="partsBorder" Color="#595868" />
        <SolidColorBrush x:Key="instanceFill" Color="#9d9da6" />
        <SolidColorBrush x:Key="instanceFill_Dark1" Color="#7b7a86" />
        <SolidColorBrush x:Key="instanceFill_Dark2" Color="#8c8b96" />
        <SolidColorBrush x:Key="instanceFill_Light1" Color="#bfbfc6" />
        <SolidColorBrush x:Key="instanceFill_Light2" Color="#aeaeb6" />
        <SolidColorBrush x:Key="instanceBorder" Color="#595868" />

        <Style TargetType="Image">
            <Setter Property="Stretch" Value="Fill" />
        </Style>

        <vc:InversedBoolToOpacityValueConverter x:Key="isSelectedToOpacity" />
    </UserControl.Resources>


    <Image>
        <Image.Source>
            <DrawingImage>
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <DrawingGroup x:Name="BoltInstance" Opacity="{Binding Bolt, ElementName=BoltAssemblyControl, Converter={StaticResource isSelectedToOpacity}, ConverterParameter=0.25, Mode=OneWay}">
                            <GeometryDrawing Brush="{StaticResource instanceFill_Dark1}">
                                <GeometryDrawing.Geometry>
                                    <PathGeometry Figures="M 25,0 H 37.5 V 16 H 25 Z" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="{StaticResource instanceFill}">
                                <GeometryDrawing.Geometry>
                                    <PathGeometry Figures="M 37.5,0 H 62.5 V 16 H 37.5 Z" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="{StaticResource instanceFill_Light1}">
                                <GeometryDrawing.Geometry>
                                    <PathGeometry Figures="M 62.5,0 H 75 V 16 H 62.5 Z" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Pen>
                                    <Pen Thickness="1" Brush="{StaticResource instanceBorder}" />
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <PathGeometry Figures="M 25,0 H 75 V 16 H 25 Z" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="{StaticResource instanceFill}">
                                <GeometryDrawing.Pen>
                                    <Pen Thickness="1" Brush="{StaticResource instanceBorder}" />
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <PathGeometry Figures="M 42,16 H 58 V 130 H 42 Z" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                        <DrawingGroup x:Name="Washer1Instance" Opacity="{Binding Washer1, ElementName=BoltAssemblyControl, Converter={StaticResource isSelectedToOpacity}, ConverterParameter=0.25, Mode=OneWay}">
                            <GeometryDrawing Brush="{StaticResource instanceFill}">
                                <GeometryDrawing.Pen>
                                    <Pen Thickness="1" Brush="{StaticResource instanceBorder}" />
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <PathGeometry Figures="M 16,18 H 84 V 24 H 16 Z" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                        <DrawingGroup x:Name="BoltedParts">
                            <GeometryDrawing Brush="{StaticResource partFill}">
                                <GeometryDrawing.Geometry>
                                    <PathGeometry Figures="M 0,26 H 40 V 36 H 0 Z M 60,26 H 100 V 36 H 60 Z M 0,37 H 40 V 47 H 0 Z M 60,37 H 100 V 47 H 60 Z" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                        <DrawingGroup x:Name="Washer2Instance" Opacity="{Binding Washer2, ElementName=BoltAssemblyControl, Converter={StaticResource isSelectedToOpacity}, ConverterParameter=0.25, Mode=OneWay}">
                            <GeometryDrawing Brush="{StaticResource instanceFill}">
                                <GeometryDrawing.Pen>
                                    <Pen Thickness="1" Brush="{StaticResource instanceBorder}" />
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <PathGeometry Figures="M 16,49 H 84 V 55 H 16 Z" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                        <DrawingGroup x:Name="Washer3Instance" Opacity="{Binding Washer3, ElementName=BoltAssemblyControl, Converter={StaticResource isSelectedToOpacity}, ConverterParameter=0.25, Mode=OneWay}">
                            <GeometryDrawing Brush="{StaticResource instanceFill}">
                                <GeometryDrawing.Pen>
                                    <Pen Thickness="1" Brush="{StaticResource instanceBorder}" />
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <PathGeometry Figures="M 16,57 H 84 V 63 H 16 Z M 16,65 H 84 V 71 H 16 Z M 16,73 H 84 V 79 H 16 Z" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                        <DrawingGroup x:Name="Nut1Instance" Opacity="{Binding Nut1, ElementName=BoltAssemblyControl, Converter={StaticResource isSelectedToOpacity}, ConverterParameter=0.25, Mode=OneWay}">
                            <GeometryDrawing Brush="{StaticResource instanceFill_Dark2}">
                                <GeometryDrawing.Geometry>
                                    <PathGeometry Figures="M 25,81 H 50 V 97 H 25 Z" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="{StaticResource instanceFill_Light2}">
                                <GeometryDrawing.Geometry>
                                    <PathGeometry Figures="M 50,81 H 75 V 97 H 50 Z" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="{StaticResource instanceBorder}" Thickness="1" />
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <PathGeometry Figures="M 25,81 H 75 V 97 H 25 Z" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                        <DrawingGroup x:Name="Nut2Instance" Opacity="{Binding Nut2, ElementName=BoltAssemblyControl, Converter={StaticResource isSelectedToOpacity}, ConverterParameter=0.25, Mode=OneWay}">
                            <GeometryDrawing Brush="{StaticResource instanceFill_Dark1}">
                                <GeometryDrawing.Geometry>
                                    <PathGeometry Figures="M 25,99 H 37.5 V 115 H 25 Z" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="{StaticResource instanceFill}">
                                <GeometryDrawing.Geometry>
                                    <PathGeometry Figures="M 37.5,99 H 62.5 V 115 H 37.5 Z" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="{StaticResource instanceFill_Light1}">
                                <GeometryDrawing.Geometry>
                                    <PathGeometry Figures="M 62.5,99 H 75 V 115 H 62.5 Z" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Pen>
                                    <Pen Thickness="1" Brush="{StaticResource instanceBorder}" />
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <PathGeometry Figures="M 25,99 H 75 V 115 H 25 Z" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
        </Image.Source>
    </Image>
</UserControl>
