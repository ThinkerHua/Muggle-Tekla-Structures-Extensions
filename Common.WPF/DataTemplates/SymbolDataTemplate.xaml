<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Muggle.TsExtensions.Common.WPF.DataTemplates">
    <DataTemplate x:Key="SymbolDataTemplate" DataType="{x:Type local:Symbol}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Height="12" Stretch="None">
                <Image.Source>
                    <DrawingImage Drawing="{Binding Drawing}" />
                </Image.Source>
            </Image>
            <TextBlock Grid.Column="1" Margin="2,0" Text="{Binding Name}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SymbolDataTemplate_OnlyDrawing" DataType="{x:Type local:Symbol}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Height="12" Stretch="None">
                <Image.Source>
                    <DrawingImage Drawing="{Binding Drawing}" />
                </Image.Source>
            </Image>
            <!--<TextBlock Grid.Column="1" Margin="2,0" Text="{Binding Name}" />-->
        </Grid>
    </DataTemplate>
</ResourceDictionary>