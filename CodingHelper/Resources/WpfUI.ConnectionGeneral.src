            <TabItem Header="General">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
            
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Up direction" />
                    <tsuic:WpfFilterCheckBox Grid.Row="0" Grid.Column="1" AttributeName="zsuunta" />
                    <ComboBox Grid.Row="0" Grid.Column="2" SelectedIndex="{Binding UpDirection, Mode=TwoWay}">
                        <ComboBoxItem Content="None" />
                        <ComboBoxItem Content="-z" />
                        <ComboBoxItem Content="+z" />
                        <ComboBoxItem Content="+x" />
                        <ComboBoxItem Content="-x" />
                        <ComboBoxItem Content="-y" />
                        <ComboBoxItem Content="+y" />
                        <ComboBoxItem Content="Auto" />
                    </ComboBox>
            
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Rotation angle Y" />
                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="1" AttributeName="zang1" />
                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding RotationAngleY, Mode=TwoWay}" />
            
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Rotation angle X" />
                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="1" AttributeName="zang2" />
                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding RotationAngleX, Mode=TwoWay}" />
            
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Locked" />
                    <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="1" AttributeName="OBJECT_LOCKED" />
                    <ComboBox Grid.Row="4" Grid.Column="2" SelectedIndex="{Binding Locked, Mode=TwoWay}">
                        <ComboBoxItem Content="No" />
                        <ComboBoxItem Content="Yes" />
                    </ComboBox>
            
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Class" />
                    <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="1" AttributeName="group_no" />
                    <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding Class, Mode=TwoWay}" />
            
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Connection code" />
                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="1" AttributeName="joint_code" />
                    <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding ConnectionCode, Mode=TwoWay}" />
            
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Auto defaults rule group" />
                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.Column="1" AttributeName="ad_root" />
                    <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding AutoDefaults, Mode=TwoWay}" />
            
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Auto connection rule group" />
                    <tsuic:WpfFilterCheckBox Grid.Row="8" Grid.Column="1" AttributeName="ac_root" />
                    <TextBox Grid.Row="8" Grid.Column="2" Text="{Binding AutoConnection, Mode=TwoWay}" />
                </Grid>
            </TabItem>
