<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Muggle.TsExtensions.CodingHelper</RootNamespace>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <PackageId>Muggle.TsExtensions.CodingHelper</PackageId>
        <Title>Tekla Structures OpenAPI development helper</Title>
        <Version>2.0.0-beta.1</Version>
        <Authors>Huang YongXing</Authors>
        <Description>Help to generate fields (with StructuresFieldAttribute) for plugin data, fields for plugin, and properties (with StructuresDialogAttribute) for view model which used by plugin WPF UI.</Description>
        <Copyright>© 2026 Huang YongXing</Copyright>
        <PackageIcon>Assets/logo.png</PackageIcon>
        <PackageProjectUrl>https://github.com/ThinkerHua/Muggle-Tekla-Structures-Extensions</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/ThinkerHua/Muggle-Tekla-Structures-Extensions.git</RepositoryUrl>
        <PackageReadmeFile>Readme.md</PackageReadmeFile>
        <PackageTags>Tekla Structures OpenAPI Generator</PackageTags>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <PackageReleaseNotes>
            Destructive update:
            1. '**PropertiesWithDefaultValuesAttribute' was renamed and replaced the old '**PropertiesAttribute'
                (the original name was too long and inconvenient to use).
            
            Feature improvement update:
            1. Added some 'Creat**' methods which only need to pass in generic parameter 
                to automatically use the associated fields to create model object.
            2. Added some 'ModifyTo**' methods which only need to pass in existing object
                to automatically use the associated fields to modify it.
            3. In previous versions, 
                the code for analysis to collect information needed for generation and 
                the code for diagnostics had many similarities, now the two have been integrated together.
            4. Supports using attributes by specifying property equal to value like 'Property = value'.
            5. If at least one '**FieldDefaultValuesAttribute' is used, 
                other fields without specified default value will also be registered use the preset value.
        </PackageReleaseNotes>
        <IncludeBuildOutput>false</IncludeBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Update="Assets/logo.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Update="Readme.md">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="$(OutputPath)/$(AssemblyName).dll">
            <Pack>True</Pack>
            <PackagePath>analyzers/dotnet/cs</PackagePath>
            <Visible>false</Visible>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Resources\*.cs"/>
        <EmbeddedResource Include="Resources\*.cs"/>
    </ItemGroup>

</Project>
