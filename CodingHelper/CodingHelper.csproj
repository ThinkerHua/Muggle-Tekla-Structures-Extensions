<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Muggle.TsExtensions.CodingHelper</RootNamespace>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <PackageId>Muggle.TsExtensions.CodingHelper</PackageId>
        <Title>Tekla Structures OpenAPI development helper</Title>
        <Version>3.0.0-beta.2</Version>
        <Authors>Huang YongXing</Authors>
        <Description>Generate fields and utility methods for plugin data class, fields for plugin class, properties for view model class, and a simple user interface for plugin.
        为组件数据类生成字段和实用方法，为组件类生成字段，为视图模型类生成属性，为组件生成简易的用户界面。</Description>
        <Copyright>© 2026 Huang YongXing</Copyright>
        <PackageIcon>Assets/logo.png</PackageIcon>
        <PackageProjectUrl>https://github.com/ThinkerHua/Muggle-Tekla-Structures-Extensions</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/ThinkerHua/Muggle-Tekla-Structures-Extensions.git</RepositoryUrl>
        <PackageReadmeFile>Readme.md</PackageReadmeFile>
        <PackageTags>Tekla Structures OpenAPI Generator</PackageTags>
        <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <PackageReleaseNotes>
            1. Fixed the issue where the INP interface stud circle diameter textbox was misaligned; 
            2. Added a tip in the Readme about updating the INP interface;

            1、修复 INP 界面栓钉圆环直径文本框错位的问题; 
            2、Readme 添加更新 INP 界面的提示;
		</PackageReleaseNotes>
        <IncludeBuildOutput>false</IncludeBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Update="Assets/logo.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Update="Readme.md">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="$(OutputPath)/$(AssemblyName).dll">
            <Pack>True</Pack>
            <PackagePath>analyzers/dotnet/cs</PackagePath>
            <Visible>false</Visible>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Resources\*.cs" />
        <Compile Remove="Resources\*.src" />
        <Compile Include="Resources\UserInterfaceType.cs" />
        <EmbeddedResource Include="Resources\*.cs" />
        <EmbeddedResource Include="Resources\*.src" />
    </ItemGroup>

</Project>
