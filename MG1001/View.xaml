                    <TextBox Grid.Row="5" Grid.Column="20" Text="{Binding PlateHorizontalPartStartNumber, Mode=TwoWay}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="17" AttributeName="PLHorizontalASMP" />
                    <TextBox Grid.Row="6" Grid.Column="18" Text="{Binding PlateHorizontalAssemblyPrefix, Mode=TwoWay}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="19" AttributeName="PLHorizontalASMN" />
                    <TextBox Grid.Row="6" Grid.Column="20" Text="{Binding PlateHorizontalAssemblyStartNumber, Mode=TwoWay}" />

                    <TextBlock Grid.Row="7" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_thickened_plate}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLThickenedName" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateThickenedName, Mode=TwoWay}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLThickenedT" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateThickenedThickness, Mode=TwoWay}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLThickenedMATL" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateThickenedMaterial, Mode=TwoWay}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="7"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateThickenedMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLThickenedFNSH" />
                    <TextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateThickenedFinish, Mode=TwoWay}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLThickenedCLS" />
