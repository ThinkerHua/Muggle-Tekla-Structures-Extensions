<tsdlg:PluginWindowBase x:Class="Muggle.TsExtensions.MG1001.View"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:local="clr-namespace:Muggle.TsExtensions.MG1001"
                        xmlns:tsdlg="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
                        xmlns:tsuic="clr-namespace:Tekla.Structures.Dialog.UIControls;assembly=Tekla.Structures.Dialog"
                        xmlns:uc="clr-namespace:Muggle.TsExtensions.Common.WPF.Controls;assembly=Common.WPF"
                        xmlns:tr="clr-namespace:Muggle.TsExtensions.Common.WPF.Localization;assembly=Common.WPF"
                        xmlns:assets="clr-namespace:Muggle.TsExtensions.Common.WPF.Assets;assembly=Common.WPF"
                        xmlns:vc="clr-namespace:Muggle.TsExtensions.Common.WPF.ValueConverters;assembly=Common.WPF"
                        Title="{tsdlg:Loc albl_MG1001_title}"
                        ResizeMode="NoResize"
                        SizeToContent="WidthAndHeight"
                        UseDefaultStyle="False"
                        Background="#F3F3F7"
                        mc:Ignorable="d">

    <tsdlg:PluginWindowBase.DataContext>
        <local:ViewModel />
    </tsdlg:PluginWindowBase.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Common.WPF;component/Controls/PresetControlGroups.xaml" />
                <ResourceDictionary Source="/Common.WPF;component/DataTemplates/SymbolDataTemplate.xaml" />
                <ResourceDictionary Source="/MG1001;component/Assets/Backgrounds.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <vc:BoltHoleTypeToSlottedHoleXDisplayNameConverter x:Key="BoltHoleTypeToSlottedHoleXDisplayName" />
            <vc:BoltHoleTypeToSlottedHoleXIsEnabledConverter x:Key="BoltHoleTypeToSlottedHoleXIsEnabled" />
            <vc:BoltHoleTypeToSlottedHoleYIsEnabledConverter x:Key="BoltHoleTypeToSlottedHoleYIsEnabled" />
            <vc:BoltHoleTypeToRotateSlotsIsEnabledConverter x:Key="BoltHoleTypeToRotateSlotsIsEnabled" />
            <vc:BoltPlainHoleTypeToBlindHoleDepthIsEnabledConverter x:Key="BoltPlainHoleTypeToBlindHoleDepthIsEnabled" />
            <vc:ChamferTypeToXIsEnabledConverter x:Key="ChamferTypeToXIsEnabled" />
            <vc:ChamferTypeToYIsEnabledConverter x:Key="ChamferTypeToYIsEnabled" />

            <Style x:Key="Element" TargetType="FrameworkElement">
                <Setter Property="Margin" Value="2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ContainingTextBoxElement" TargetType="FrameworkElement" BasedOn="{StaticResource Element}">
                <Setter Property="Height" Value="20" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="CheckBox" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="TextBox">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="ComboBox" />
            <Style BasedOn="{StaticResource Element}" TargetType="uc:BoltAssembly" />
            <Style BasedOn="{StaticResource Element}" TargetType="uc:BoltSpecialHole" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfFilterCheckBox">
                <Setter Property="Margin" Value="2,2,-2,2" />
            </Style>
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfProfileCatalog" />
            <Style BasedOn="{StaticResource Element}" TargetType="tsuic:WpfMaterialCatalog" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuic:WpfBoltCatalogSize" />
            <Style BasedOn="{StaticResource ContainingTextBoxElement}" TargetType="tsuic:WpfBoltCatalogStandard" />

            <DataTemplate x:Key="StifKindDataTemplate" DataType="DrawingImage">
                <Image Width="30" Height="30" Source="{Binding}" />
            </DataTemplate>

            <x:Array x:Key="StifKindSet" Type="DrawingImage">
                <DrawingImage Drawing="{StaticResource StiffenerKind1}" />
                <DrawingImage Drawing="{StaticResource StiffenerKind2}" />
            </x:Array>

        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <tsuic:WpfSaveLoad DockPanel.Dock="Top" />
        <tsuic:WpfOkApplyModifyGetOnOffCancel DockPanel.Dock="Bottom"
                                              ApplyClicked="WPFOkApplyModifyGetOnOffCancel_ApplyClicked"
                                              CancelClicked="WPFOkApplyModifyGetOnOffCancel_CancelClicked"
                                              GetClicked="WPFOkApplyModifyGetOnOffCancel_GetClicked"
                                              ModifyClicked="WPFOkApplyModifyGetOnOffCancel_ModifyClicked"
                                              OkClicked="WPFOkApplyModifyGetOnOffCancel_OkClicked"
                                              OnOffClicked="WPFOkApplyModifyGetOnOffCancel_OnOffClicked" />
        <TextBlock DockPanel.Dock="Bottom" Margin="4" TextWrapping="Wrap">
            <Run>Huang YongXing -</Run>
            <Hyperlink NavigateUri="mailto:thinkerhua@hotmail.com">thinkerhua@hotmail.com</Hyperlink>
        </TextBlock>

        <TabControl>
            <TabItem Header="{tr:Translate albl_Parameters}">
                <DockPanel>
                    <Canvas Width="350" Height="260">
                        <Image Canvas.Left="25" Canvas.Top="10" Stretch="None">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource FrontViewWithParametersDimension}" />
                            </Image.Source>
                        </Image>
                        <Image Canvas.Left="155" Canvas.Top="110" Stretch="None">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource ZoomIn}" />
                            </Image.Source>
                        </Image>
                        <Image Canvas.Left="245" Canvas.Top="50" Stretch="None">
                            <Image.Source>
                                <DrawingImage Drawing="{StaticResource Section1-1WithEndPlatePositionDimension}" />
                            </Image.Source>
                        </Image>
                        <TextBlock Canvas.Left="121" Canvas.Top="3" FontWeight="Bold" Text="1" />
                        <TextBlock Canvas.Left="121" Canvas.Top="139" FontWeight="Bold" Text="1" />
                        <TextBlock Canvas.Left="52" Canvas.Top="15" Text="a" />
                        <TextBlock Canvas.Left="101" Canvas.Top="119" Text="b" />
                        <TextBlock Canvas.Left="17" Canvas.Top="111" Text="c" />
                        <TextBlock Canvas.Left="166" Canvas.Top="92" Text="te" />
                        <TextBlock Canvas.Left="155" Canvas.Top="237" Text="tp">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="6" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Canvas.Left="187" Canvas.Top="202" Text="te - tp &gt; d">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="-72" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Canvas.Left="175" Canvas.Top="187" Text="⩾ 1 : e">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="-72" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Canvas.Left="280" Canvas.Top="180" Text="1-1" FontWeight="Bold" />
                        <TextBlock Canvas.Left="242" Canvas.Top="54" Text="f" />
                        <TextBlock Canvas.Left="242" Canvas.Top="130" Text="g" />

                    </Canvas>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{tsdlg:Loc albl_top_plate_is_horizontal}" />
                        <tsuic:WpfFilterCheckBox Grid.Row="0" Grid.Column="2" AttributeName="isTopHorizontal" />
                        <CheckBox Grid.Row="0" Grid.Column="3" IsChecked="{Binding IsTopHorizontal, Mode=TwoWay}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{tsdlg:Loc albl_diagonal_plate_position1}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="a" />
                        <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="2" AttributeName="diagPosition1" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding DiagPosition1, Mode=TwoWay}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{tsdlg:Loc albl_diagonal_plate_position2}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="b" />
                        <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="2" AttributeName="diagPosition2" />
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding DiagPosition2, Mode=TwoWay}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{tsdlg:Loc albl_thickened_plate_position}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="c" />
                        <tsuic:WpfFilterCheckBox Grid.Row="3" Grid.Column="2" AttributeName="thickenedPosition" />
                        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding ThickenedPosition, Mode=TwoWay}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{tsdlg:Loc albl_thickness_difference}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="d" />
                        <tsuic:WpfFilterCheckBox Grid.Row="4" Grid.Column="2" AttributeName="difference" />
                        <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Difference, Mode=TwoWay}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{tsdlg:Loc albl_groove_slope}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="e" />
                        <tsuic:WpfFilterCheckBox Grid.Row="5" Grid.Column="2" AttributeName="grooveSlope" />
                        <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding GrooveSlope, Mode=TwoWay}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{tsdlg:Loc albl_endplate_position}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="f" />
                        <tsuic:WpfFilterCheckBox Grid.Row="6" Grid.Column="2" AttributeName="endPosition" />
                        <TextBox Grid.Row="6" Grid.Column="3" Text="{Binding EndPosition, Mode=TwoWay}" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{tsdlg:Loc albl_web_stiffeners_distance_list}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="g" />
                        <tsuic:WpfFilterCheckBox Grid.Row="7" Grid.Column="2" AttributeName="webStifDistList" />
                        <TextBox Grid.Row="7" Grid.Column="3" Text="{Binding WebStifDistList, Mode=TwoWay}" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="{tr:Translate albl_Plates}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Id}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Name}" />
                    <TextBlock Grid.Row="0" Grid.Column="4" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Thickness}" />
                    <TextBlock Grid.Row="0" Grid.Column="6" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Breadth}" />
                    <TextBlock Grid.Row="0" Grid.Column="8" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Height}" />
                    <TextBlock Grid.Row="0" Grid.Column="11" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Material}" />
                    <TextBlock Grid.Row="0" Grid.Column="14" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Finish}" />
                    <TextBlock Grid.Row="0" Grid.Column="16" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_Class}" />
                    <TextBlock Grid.Row="0" Grid.Column="18" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_NumberingSeries_Prefix}" />
                    <TextBlock Grid.Row="0" Grid.Column="20" HorizontalAlignment="Center" Text="{tr:Translate albl_Part_Header_NumberingSeries_StartNumber}" />

                    <TextBlock Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_top_plate}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" AttributeName="PLTopName" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Text="{Binding PlateTopName, Mode=TwoWay}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="3" AttributeName="PLTopT" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="4" Text="{Binding PlateTopThickness, Mode=TwoWay}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="5" AttributeName="PLTopB" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="6" Text="{Binding PlateTopBreadth, Mode=TwoWay}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="10" AttributeName="PLTopMATL" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateTopMaterial, Mode=TwoWay}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="1"
                                              Grid.RowSpan="2"
                                              Grid.Column="12"
                                              Tag="PlateTopMaterial"
                                              SelectClicked="WpfMaterialCatalog_SelectClicked"
                                              SelectionDone="WpfMaterialCatalog_SelectionDone" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="13" AttributeName="PLTopFNSH" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="14" Text="{Binding PlateTopFinish, Mode=TwoWay}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="15" AttributeName="PLTopCLS" />
                    <uc:ClassSelector Grid.Row="1" Grid.RowSpan="2" Grid.Column="16" Value="{Binding PlateTopClass, Mode=TwoWay}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="17" AttributeName="PLTopPTP" />
                    <TextBox Grid.Row="1" Grid.Column="18" Text="{Binding PlateTopPartPrefix, Mode=TwoWay}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="1" Grid.Column="19" AttributeName="PLTopPTN" />
                    <TextBox Grid.Row="1" Grid.Column="20" Text="{Binding PlateTopPartStartNumber, Mode=TwoWay}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="17" AttributeName="PLTopASMP" />
                    <TextBox Grid.Row="2" Grid.Column="18" Text="{Binding PlateTopAssemblyPrefix, Mode=TwoWay}" />

                    <tsuic:WpfFilterCheckBox Grid.Row="2" Grid.Column="19" AttributeName="PLTopASMN" />
                    <TextBox Grid.Row="2" Grid.Column="20" Text="{Binding PlateTopAssemblyStartNumber, Mode=TwoWay}" />

                    <TextBlock Grid.Row="3" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_diagonal_plate}" />

