                    <TextBox Grid.Row="5" Grid.RowSpan="2" Grid.Column="11" Text="{Binding PlateHorizontalMaterial, Mode=TwoWay}" />
                    <tsuic:WpfMaterialCatalog Grid.Row="5"
                                              Grid.RowSpan="2"
