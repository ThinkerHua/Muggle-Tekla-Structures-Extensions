                    <TextBox Grid.Row="4" Grid.Column="20" Text="{Binding PlateDiagonalAssemblyStartNumber, Mode=TwoWay}" />

                    <TextBlock Grid.Row="5" Grid.RowSpan="2" Grid.Column="0" Text="{tsdlg:Loc albl_horizontal_plate}" />

